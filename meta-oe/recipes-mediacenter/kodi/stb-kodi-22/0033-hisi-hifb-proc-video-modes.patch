+bool ParseOutputMode(const std::string& mode,
+                     unsigned int& outputWidth,
+                     unsigned int& outputHeight,
+                     float& refreshRate,
+                     bool& interlaced)
+{
+  const size_t scanIndex = mode.find_first_of("pi");
+  if (scanIndex == std::string::npos || scanIndex == 0)
+    return false;
+
+  outputHeight = static_cast<unsigned int>(
+      std::strtoul(mode.substr(0, scanIndex).c_str(), nullptr, 10));
+  switch (outputHeight)
   {
-    const ssize_t bytes = read(fd, mode, sizeof(mode) - 1);
