-      mode[bytes] = '\0';
+    case 480:
+    case 576:
+      outputWidth = 720;
+      break;
+    case 720:
+      outputWidth = 1280;
+      break;
+    case 1080:
+      outputWidth = 1920;
+      break;
+    case 2160:
+      outputWidth = 3840;
+      break;
+    default:
+      return false;
   }
 
-  if (strstr(mode, "24"))
-    return 24.0f;
-  if (strstr(mode, "25"))
-    return 25.0f;
-  if (strstr(mode, "30"))
-    return 30.0f;
-  if (strstr(mode, "50") || strstr(mode, "pal") || strstr(mode, "576"))
-    return 50.0f;
-  return 60.0f;
+  interlaced = mode[scanIndex] == 'i';
+  const unsigned int namedRate =
+      scanIndex + 1 < mode.size()
+          ? static_cast<unsigned int>(std::strtoul(mode.c_str() + scanIndex + 1, nullptr, 10))
+          : (outputHeight == 576 ? 50U : 60U);
+  switch (namedRate)
+  {
+    case 24:
+      refreshRate = 23.976f;
+      break;
+    case 30:
+      refreshRate = 29.97f;
+      break;
+    case 60:
+      refreshRate = 59.94f;
+      break;
+    default:
+      refreshRate = static_cast<float>(namedRate);
+      break;
+  }
+  return namedRate != 0;
+}
+
+float GetOutputRefreshRate()
+{
+  std::string mode;
+  unsigned int outputWidth = 0;
+  unsigned int outputHeight = 0;
+  float refreshRate = 50.0f;
+  bool interlaced = false;
+  if (ReadProcString("/proc/stb/video/videomode", mode) &&
+      ParseOutputMode(mode, outputWidth, outputHeight, refreshRate, interlaced))
+    return refreshRate;
+  return 50.0f;
 }
 
