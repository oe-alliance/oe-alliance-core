+    list(APPEND ffmpeg_conf --cpu=${CPU})
+  elseif(WITH_PLATFORM STREQUAL "nextv-cortexa15")
+    set(CPU cortex-a15)
+    list(APPEND ffmpeg_conf --cpu=${CPU})
+  elseif(WITH_PLATFORM STREQUAL "mali-cortexa15")
+    set(CPU cortex-a15)
+    list(APPEND ffmpeg_conf --cpu=${CPU})
+  endif()
+endif()
