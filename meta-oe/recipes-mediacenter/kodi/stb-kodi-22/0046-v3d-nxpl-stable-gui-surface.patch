From 35df011af38e9d6a6307604cae11030dadbc77a0 Mon Sep 17 00:00:00 2001
From: OE-Alliance <oe-alliance@users.noreply.github.com>
Date: Tue, 11 Aug 2026 05:30:00 +0200
Subject: [PATCH] v3d nxpl: recreate a stable GUI window after mode switches

Legacy NXPL receivers including formuler1 change the EGL surface geometry
behind an existing native window when the HDMI refresh rate is switched.  A
1080p24 surface is then reported as 1920x1080 while returning to 1080p50 can
be reported as 720x576.  The generic fbdev reconciliation code persisted
those transient values as Kodi's GUI resolution, making the OSD alternate
between small and heavily magnified after video start/stop.

Match the proven Enigma2 NXPL handling for these receivers: recreate the
native window at the selected display geometry after every requested mode and
keep it above the DVB video plane.  Also keep the requested Kodi GUI geometry on the
V3D/NXPL backend instead of treating the driver's transient EGL query as a
new GUI mode.  Other STB EGL backends retain their existing reconciliation.
---
 xbmc/windowing/egl/EGLNativeTypeV3DNXPL.cpp | 27 +++++++++++++++++++++++++++
 xbmc/windowing/egl/WinSystemstb.cpp         |  7 +++++++
 2 files changed, 34 insertions(+)

diff --git a/xbmc/windowing/egl/EGLNativeTypeV3DNXPL.cpp b/xbmc/windowing/egl/EGLNativeTypeV3DNXPL.cpp
--- a/xbmc/windowing/egl/EGLNativeTypeV3DNXPL.cpp
+++ b/xbmc/windowing/egl/EGLNativeTypeV3DNXPL.cpp
@@ -232,6 +232,33 @@ bool CEGLNativeTypeV3D::SetNativeResolution(const RESOLUTION_INFO &res)
     return false;
   }
 
+  // On legacy NXPL receivers an existing native window inherits transient
+  // output geometry when the HDMI timing changes. Recreate the window while
+  // no EGL surface is bound so its fixed GUI size is applied again.
+  if (m_nativeWindow)
+  {
+    NXPL_ShowNativeWindowEXT(m_nativeWindow, false);
+    NXPL_DestroyNativeWindow(m_nativeWindow);
+    m_nativeWindow = nullptr;
+
+    NXPL_NativeWindowInfoEXT nativeWindow;
+    NXPL_GetDefaultNativeWindowInfoEXT(&nativeWindow);
+    nativeWindow.x = 0;
+    nativeWindow.y = 0;
+    nativeWindow.width = res.iWidth;
+    nativeWindow.height = res.iHeight;
+    nativeWindow.stretch = false;
+    nativeWindow.clientID = 0;
+    nativeWindow.zOrder = 1;
+    m_nativeWindow = NXPL_CreateNativeWindowEXT(&nativeWindow);
+    if (!m_nativeWindow)
+    {
+      CLog::Log(LOGERROR, "V3D NXPL: failed to recreate the selected GUI window");
+      return false;
+    }
+    NXPL_ShowNativeWindowEXT(m_nativeWindow, true);
+  }
+
   CLog::Log(LOGINFO, "V3D NXPL: HDMI mode {} at {:.3f} Hz", driverMode, res.fRefreshRate);
   m_desktopRes = res;
   return true;
diff --git a/xbmc/windowing/egl/WinSystemstb.cpp b/xbmc/windowing/egl/WinSystemstb.cpp
--- a/xbmc/windowing/egl/WinSystemstb.cpp
+++ b/xbmc/windowing/egl/WinSystemstb.cpp
@@ -347,6 +347,7 @@ bool CWinSystemstb::CreateWindow(RESOLUTION_INFO &res)
   // Restore fbdev to the real surface size before Kodi starts rendering or
   // calculates the hardware video destination rectangle.
   RESOLUTION_INFO native;
+#if !defined(TARGET_V3DNXPL)
   if (m_egl->GetNativeResolution(&native) &&
       (native.iWidth != width || native.iHeight != height))
   {
@@ -386,6 +387,12 @@ bool CWinSystemstb::CreateWindow(RESOLUTION_INFO &res)
     m_displayWidth = width;
     m_displayHeight = height;
   }
+#else
+  if (width != res.iWidth || height != res.iHeight)
+    CLog::Log(LOGWARNING,
+              "{}: ignoring transient V3D NXPL EGL size {}x{}; keeping GUI {}x{}",
+              __FUNCTION__, width, height, res.iWidth, res.iHeight);
+#endif
 
   EGLint contextAttrs[] =
   {
