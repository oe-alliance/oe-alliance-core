#!/bin/sh

# Select the Linux-DVB/PES hardware backend on Broadcom ARM and MIPSel receivers. Kodi
# remains responsible for demuxing, audio, subtitles, timing and player UI.
KODI_STBPLAYER_BACKEND="bcm-dvb"
export KODI_STBPLAYER_BACKEND

# DM900/DM920 use a private, hash-verified libvc5dream 1.0.5 with the
# bcmSchedQuery NULL-pointer fix.  Keep Enigma2's system copy untouched.
if [ -r /usr/lib/kodi/dm9x0/libvc5dream.so.1 ]; then
    LD_LIBRARY_PATH="/usr/lib/kodi/dm9x0${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LD_LIBRARY_PATH
    unset LD_PRELOAD
fi

# The Enigma2 launcher records its live master volume before exit. Pass it
# through the clean env used by enigma2.sh so Kodi takes over the same audible
# level without stacking software and DVB mixer attenuation.
if [ -r /tmp/stb-kodi-e2-audio ]; then
    IFS=' ' read -r KODI_STB_INITIAL_VOLUME KODI_STB_INITIAL_MUTED < /tmp/stb-kodi-e2-audio
    case "${KODI_STB_INITIAL_VOLUME:-}" in
        ''|*[!0-9]*) unset KODI_STB_INITIAL_VOLUME ;;
        *) export KODI_STB_INITIAL_VOLUME ;;
    esac
    case "${KODI_STB_INITIAL_MUTED:-}" in
        0|1) export KODI_STB_INITIAL_MUTED ;;
        *) unset KODI_STB_INITIAL_MUTED ;;
    esac
fi

. /usr/lib/kodi/kodi-stb-runtime.sh
stb_kodi_run /usr/bin/kodi.real "$@"
exit $?
