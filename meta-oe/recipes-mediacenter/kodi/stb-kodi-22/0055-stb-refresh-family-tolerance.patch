From 7c1b0ca82e967c719f868496da15ba11d3c95a73 Mon Sep 17 00:00:00 2001
From: OE-Alliance <oe-alliance@users.noreply.github.com>
Date: Sun, 6 Sep 2026 20:30:00 +0200
Subject: [PATCH] STB: match integer and fractional refresh-rate families

Receiver video-mode APIs commonly expose a single 24/30/60 Hz family mode as
23.976/29.970/59.940 Hz.  Kodi's 0.01 Hz exact-match tolerance rejects 24.000
fps against 23.976 Hz and may leave the previous 50 Hz desktop mode active.
Use a 0.1 Hz tolerance for STB builds so the matching family is selected while
retaining Kodi's strict comparison on other platforms.
---
 xbmc/windowing/Resolution.cpp | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/xbmc/windowing/Resolution.cpp b/xbmc/windowing/Resolution.cpp
index 2aa9f23bb6..aaaaa81423 100644
--- a/xbmc/windowing/Resolution.cpp
+++ b/xbmc/windowing/Resolution.cpp
@@ -29,6 +29,12 @@ const char* SETTING_VIDEOSCREEN_WHITELIST_PULLDOWN{"videoscreen.whitelistpulldow
 const char* SETTING_VIDEOSCREEN_WHITELIST_DOUBLEREFRESHRATE{
     "videoscreen.whitelistdoublerefreshrate"};
 
+#if defined(TARGET_STB)
+constexpr float REFRESH_RATE_MATCH_TOLERANCE{0.1f};
+#else
+constexpr float REFRESH_RATE_MATCH_TOLERANCE{0.01f};
+#endif
+
 // allow hardware decoder surface padding due to codec block alignment and GPU requirements
 // (height has greater tolerance due to 32/64px boundaries e.g. 1080→1088 or 2160→2176) and
 // encoder cropping of up to 2% e.g. 3840→3832
@@ -131,7 +137,7 @@ void CResolutionUtils::FindResolutionFromWhitelist(float fps, int width, int hei
     // allow resolutions that are exact and have the correct refresh rate
     if (MatchesMode(width, height, info) &&
         (info.dwFlags & D3DPRESENTFLAG_MODEMASK) == (curr.dwFlags & D3DPRESENTFLAG_MODEMASK) &&
-        MathUtils::FloatEquals(info.fRefreshRate, fps, 0.01f))
+        MathUtils::FloatEquals(info.fRefreshRate, fps, REFRESH_RATE_MATCH_TOLERANCE))
     {
       CLog::Log(LOGDEBUG,
                 "[WHITELIST] Matched an exact resolution with an exact refresh rate {} ({})",
@@ -163,7 +169,7 @@ void CResolutionUtils::FindResolutionFromWhitelist(float fps, int width, int hei
       // allow resolutions that are exact and have double the refresh rate
       if (MatchesMode(width, height, info) &&
           (info.dwFlags & D3DPRESENTFLAG_MODEMASK) == (curr.dwFlags & D3DPRESENTFLAG_MODEMASK) &&
-          MathUtils::FloatEquals(info.fRefreshRate, fps * 2, 0.01f))
+          MathUtils::FloatEquals(info.fRefreshRate, fps * 2, REFRESH_RATE_MATCH_TOLERANCE))
       {
         CLog::Log(LOGDEBUG,
                   "[WHITELIST] Matched an exact resolution with double the refresh rate {} ({})",
@@ -200,7 +206,8 @@ void CResolutionUtils::FindResolutionFromWhitelist(float fps, int width, int hei
       // allow resolutions that are exact and have 2.5 times the refresh rate
       if (MatchesMode(width, height, info) &&
           (info.dwFlags & D3DPRESENTFLAG_MODEMASK) == (curr.dwFlags & D3DPRESENTFLAG_MODEMASK) &&
-          MathUtils::FloatEquals(info.fRefreshRate, fps * 2.5f, 0.01f))
+          MathUtils::FloatEquals(info.fRefreshRate, fps * 2.5f,
+                                 REFRESH_RATE_MATCH_TOLERANCE))
       {
         CLog::Log(
             LOGDEBUG,
@@ -234,7 +241,7 @@ void CResolutionUtils::FindResolutionFromWhitelist(float fps, int width, int hei
     // allow resolutions that are desktop resolution but have the correct refresh rate
     if (info.iScreenWidth == desktop_info.iScreenWidth &&
         (info.dwFlags & D3DPRESENTFLAG_MODEMASK) == (desktop_info.dwFlags & D3DPRESENTFLAG_MODEMASK) &&
-        MathUtils::FloatEquals(info.fRefreshRate, fps, 0.01f))
+        MathUtils::FloatEquals(info.fRefreshRate, fps, REFRESH_RATE_MATCH_TOLERANCE))
     {
       CLog::Log(LOGDEBUG,
                 "[WHITELIST] Matched a desktop resolution with an exact refresh rate {} ({})",
@@ -261,7 +268,7 @@ void CResolutionUtils::FindResolutionFromWhitelist(float fps, int width, int hei
       if (info.iScreenWidth == desktop_info.iScreenWidth &&
           (info.dwFlags & D3DPRESENTFLAG_MODEMASK) ==
               (desktop_info.dwFlags & D3DPRESENTFLAG_MODEMASK) &&
-          MathUtils::FloatEquals(info.fRefreshRate, fps * 2, 0.01f))
+          MathUtils::FloatEquals(info.fRefreshRate, fps * 2, REFRESH_RATE_MATCH_TOLERANCE))
       {
         CLog::Log(LOGDEBUG,
                   "[WHITELIST] Matched a desktop resolution with double the refresh rate {} ({})",
@@ -290,7 +297,8 @@ void CResolutionUtils::FindResolutionFromWhitelist(float fps, int width, int hei
       if (info.iScreenWidth == desktop_info.iScreenWidth &&
           (info.dwFlags & D3DPRESENTFLAG_MODEMASK) ==
               (desktop_info.dwFlags & D3DPRESENTFLAG_MODEMASK) &&
-          MathUtils::FloatEquals(info.fRefreshRate, fps * 2.5f, 0.01f))
+          MathUtils::FloatEquals(info.fRefreshRate, fps * 2.5f,
+                                 REFRESH_RATE_MATCH_TOLERANCE))
       {
         CLog::Log(
             LOGDEBUG,
