From 7a31c351ac5e05b912d9e4486c00a18c87782ddd Mon Sep 17 00:00:00 2001
From: OpenATV STB Kodi <noreply@openatv.local>
Date: Sun, 9 Aug 2026 16:55:00 +0200
Subject: [PATCH] ALSA: avoid blocking drain on Broadcom NXPL sink switches

The VuPlus and GigaBlue Broadcom PCM implementations can block in
snd_pcm_drain() when a prebuffered stream has not consumed all queued frames.
ActiveAE only waits five seconds for CONFIGURE, so the delayed sink reply
corrupts the state-machine ordering and the next video cannot create an audio
stream. On GigaBlue this race can additionally leave pcm_nexus_copy() using a
stale userspace buffer while the sink is being reconfigured. Its asynchronous
Nexus callback can also run after snd_pcm_close() freed the associated event,
causing a BKNI_Event kernel Oops and leaving Enigma2 without audio.

Sink reconfiguration immediately closes the old PCM anyway. Drop its queued
frames and let one complete hardware-buffer interval elapse before preparing
and closing it. This remains comfortably below ActiveAE's timeout while giving
the vendor scheduler time to retire its last callback. Limit this patch to
Broadcom NXPL ARM machines in the recipe.
---
 xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
index 872def41f1..7f133325c8 100644
--- a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
+++ b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
@@ -991,8 +991,24 @@ void CAESinkALSA::Drain()
   if (!m_pcm)
     return;
 
-  snd_pcm_drain(m_pcm);
-  snd_pcm_prepare(m_pcm);
+  /* Broadcom NXPL vendor PCM drain may block here. OpenSink()
+   * calls Drain() synchronously while ActiveAE's CONFIGURE request has a
+   * five-second timeout, so a blocking drain leaves both state machines out
+   * of sequence.  The sink is deinitialized immediately afterwards; queued
+   * samples therefore do not need to be played to completion. */
+  const int dropResult = snd_pcm_drop(m_pcm);
+  if (dropResult < 0)
+    CLog::Log(LOGWARNING, "CAESinkALSA::Drain - snd_pcm_drop returned {} ({})", dropResult,
+              snd_strerror(dropResult));
+
+  /* GigaBlue's Nexus PCM callback is retired asynchronously. The driver
+   * frees its BKNI_Event in snd_pcm_close(); closing before the scheduled
+   * callback completes dereferences that freed event in kernel context. The
+   * hardware buffer is 9600 frames (200 ms at 48 kHz), so one 250 ms grace
+   * interval covers the outstanding callback without approaching ActiveAE's
+   * five-second CONFIGURE timeout. */
+  KODI::TIME::Sleep(250ms);
+  snd_pcm_prepare(m_pcm);
 }
 
 void CAESinkALSA::AppendParams(std::string &device, const std::string &params)
