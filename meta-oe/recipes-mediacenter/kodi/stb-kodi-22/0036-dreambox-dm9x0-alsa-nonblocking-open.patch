From 91525942130c4c73910e13d4371612e79a7799cb Mon Sep 17 00:00:00 2001
From: OpenATV STB Kodi <noreply@openatv.local>
Date: Sun, 9 Aug 2026 22:45:00 +0200
Subject: [PATCH] ALSA: make DM9x0 PCM sink switches nonblocking

The DM900/DM920 vendor PCM driver can sleep uninterruptibly in its open
callback when ALSA opens the playback device in blocking mode.  ActiveAE then
times out after ten seconds, keeps only the control device open and cannot
create audio streams.  Video playback consequently waits for an audio clock.

Dream's working ALSA users use the standard two-stage sequence: open with
SND_PCM_NONBLOCK, configure hardware and software parameters, then switch the
handle to blocking mode.  CAESinkALSA already performs the final
snd_pcm_nonblock(m_pcm, 0), so only its initial open mode needs changing.

The same driver can spend about ten seconds draining the old GUI or movie
stream. ActiveAE only waits five seconds for a sink reconfiguration; after
that timeout the late reply corrupts its state ordering and the next Resume
cannot create an audio stream. The old sink is closed immediately after
Drain(), so discard its queued samples and prepare it without waiting for
playout. This is the same lifecycle already used successfully by Dream MIPS.

This patch is selected only for ARM DM900/DM920 recipes.
---
 xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
index 872def41f1..47bcd848ec 100644
--- a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
+++ b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
@@ -995,3 +995,9 @@ void CAESinkALSA::Drain()
-  snd_pcm_drain(m_pcm);
-  snd_pcm_prepare(m_pcm);
+  /* The DM9x0 vendor PCM may wait about ten seconds in drain while ActiveAE
+   * allows only five seconds for CONFIGURE. The sink is closed immediately
+   * afterwards, so waiting for queued samples to play is unnecessary. */
+  const int dropResult = snd_pcm_drop(m_pcm);
+  if (dropResult < 0)
+    CLog::Log(LOGWARNING, "CAESinkALSA::Drain - snd_pcm_drop returned {} ({})", dropResult,
+              snd_strerror(dropResult));
+  snd_pcm_prepare(m_pcm);
 }
@@ -1032,7 +1032,7 @@ bool CAESinkALSA::TryDevice(const std::string &name, snd_pcm_t **pcmp, snd_confi
     *pcmp = NULL;
   }
 
-  int err = snd_pcm_open_lconf(pcmp, name.c_str(), SND_PCM_STREAM_PLAYBACK, ALSA_OPTIONS, lconf);
+  int err = snd_pcm_open_lconf(pcmp, name.c_str(), SND_PCM_STREAM_PLAYBACK, ALSA_OPTIONS | SND_PCM_NONBLOCK, lconf);
   if (err < 0)
   {
     CLog::Log(LOGINFO, "CAESinkALSA - Unable to open device \"{}\" for playback", name);
