+
+#pragma once
+
+#include "cores/AudioEngine/Interfaces/AESink.h"
+#include "cores/AudioEngine/Utils/AEDeviceInfo.h"
+
+#include <memory>
+
+extern "C"
+{
+#include <stbplayer/audio.h>
+}
+
+class CAESinkSTB : public IAESink
+{
+public:
+  CAESinkSTB() = default;
+  ~CAESinkSTB() override;
+
+  static void Register();
+  static bool IsSelected();
+  static bool UsesPcmMediaClock();
+  static bool DtsUsesAc3Mode();
+  static bool WantsRaw(const AEAudioFormat& format);
+  static void NotifyDtsModeChanged();
+  static unsigned int GetDtsModeRevision();
+  static std::unique_ptr<IAESink> Create(std::string& device, AEAudioFormat& desiredFormat);
+  static void EnumerateDevicesEx(AEDeviceInfoList& list, bool force);
+
+  const char* GetName() override { return "STB"; }
+  bool Initialize(AEAudioFormat& format, std::string& device) override;
+  void Deinitialize() override;
+  double GetCacheTotal() override { return 0.5; }
+  unsigned int AddPackets(uint8_t** data, unsigned int frames, unsigned int offset) override;
+  void AddPause(unsigned int millis) override;
+  void SetTimestamp(int64_t timestampMs, bool valid) override;
+  void GetDelay(AEDelayStatus& status) override;
+  void Drain() override;
+  void Flush() override;
+#if !defined(TARGET_AMLOGIC)
+  bool HasVolume() override { return true; }
+  void SetVolume(float volume) override;
+#endif
+
+private:
+  static enum stbp_audio_codec CodecForFormat(const AEAudioFormat& format);
+  static void Log(void* userdata, enum stbp_log_level level, const char* message);
+
+  struct stbp_audio_device* m_device{nullptr};
+  AEAudioFormat m_format{};
+  int64_t m_nextPts90k{0};
+  int64_t m_firstPts90k{STBP_AUDIO_PTS_NONE};
+  bool m_hasMediaTimestamp{false};
+  bool m_clockStarted{false};
+  bool m_pcmSampleClock{false};
+  uint64_t m_pcmFrames{0};
+  float m_volume{1.0f};
+};
