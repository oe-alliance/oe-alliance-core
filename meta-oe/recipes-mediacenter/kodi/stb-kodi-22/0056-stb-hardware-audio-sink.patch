index 0000000000..ca7a75cae0
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Sinks/AESinkSTB.cpp
@@ -0,0 +1,438 @@
+/*
+ *  Copyright (C) 2026 OE-Alliance contributors
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "AESinkSTB.h"
+
+#include "cores/AudioEngine/AESinkFactory.h"
+#include "cores/AudioEngine/Utils/AEUtil.h"
+#include "settings/STBAVControl.h"
+#include "utils/log.h"
+
+extern "C"
+{
+#include <stbplayer/loader.h>
+}
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <limits>
+#include <thread>
+#include <utility>
+
+namespace
+{
+constexpr int64_t PTS_HZ = 90000;
+constexpr int64_t PTS_WRAP = INT64_C(1) << 33;
+constexpr int64_t PTS_HALF_WRAP = PTS_WRAP / 2;
+bool selected = false;
+std::atomic<bool> pcmMediaClock{false};
+std::atomic<unsigned int> dtsModeRevision{0};
+
+int64_t PtsDistance(int64_t end, int64_t start)
+{
+  int64_t distance = (end - start) & (PTS_WRAP - 1);
+  if (distance >= PTS_HALF_WRAP)
+    distance -= PTS_WRAP;
+  return distance;
+}
+} // namespace
+
+CAESinkSTB::~CAESinkSTB()
+{
+  Deinitialize();
+}
+
+void CAESinkSTB::Register()
+{
+  AE::AESinkRegEntry entry;
+  entry.sinkName = "STB";
+  entry.createFunc = CAESinkSTB::Create;
+  entry.enumerateFunc = CAESinkSTB::EnumerateDevicesEx;
+  AE::CAESinkFactory::RegisterSink(entry);
+  selected = true;
+}
+
+bool CAESinkSTB::IsSelected()
+{
+  return selected;
+}
+
+bool CAESinkSTB::UsesPcmMediaClock()
+{
+  return pcmMediaClock.load();
+}
+
+bool CAESinkSTB::DtsUsesAc3Mode()
+{
+  stbp_audio_device* device = nullptr;
+  stbp_host_callbacks host{};
+  host.struct_size = sizeof(host);
+  stbp_audio_capabilities capabilities{};
+  capabilities.struct_size = sizeof(capabilities);
+  if (stbp_audio_create(&host, &device) != STBP_OK)
+    return false;
+  const bool shared = stbp_audio_probe(device, &capabilities) == STBP_OK &&
+                      (capabilities.feature_mask & STBP_AUDIO_FEATURE_DTS_SHARED_AC3) != 0;
+  stbp_audio_destroy(device);
+  return shared;
+}
+
+bool CAESinkSTB::WantsRaw(const AEAudioFormat& format)
+{
+  if (CodecForFormat(format) == STBP_AUDIO_CODEC_DTS && DtsUsesAc3Mode())
+    return CSTBAVControl{}.Read("stbaudio.ac3") == "passthrough";
+  return true;
+}
+
+void CAESinkSTB::NotifyDtsModeChanged()
+{
+  if (DtsUsesAc3Mode())
+    ++dtsModeRevision;
+}
+
+unsigned int CAESinkSTB::GetDtsModeRevision()
+{
+  return dtsModeRevision.load();
+}
+
+std::unique_ptr<IAESink> CAESinkSTB::Create(std::string& device, AEAudioFormat& desiredFormat)
+{
+  auto sink = std::make_unique<CAESinkSTB>();
+  if (sink->Initialize(desiredFormat, device))
+    return sink;
+  return {};
+}
+
+enum stbp_audio_codec CAESinkSTB::CodecForFormat(const AEAudioFormat& format)
+{
+  if (format.m_dataFormat != AE_FMT_RAW)
+    return STBP_AUDIO_CODEC_PCM;
+
+  switch (format.m_streamInfo.m_type)
+  {
+    case CAEStreamInfo::STREAM_TYPE_AC3:
+      return STBP_AUDIO_CODEC_AC3;
+    case CAEStreamInfo::STREAM_TYPE_EAC3:
+      return STBP_AUDIO_CODEC_EAC3;
+    case CAEStreamInfo::STREAM_TYPE_DTS_512:
+    case CAEStreamInfo::STREAM_TYPE_DTS_1024:
+    case CAEStreamInfo::STREAM_TYPE_DTS_2048:
+    case CAEStreamInfo::STREAM_TYPE_DTSHD_CORE:
+      return STBP_AUDIO_CODEC_DTS;
+    default:
+      return STBP_AUDIO_CODEC_UNKNOWN;
+  }
+}
+
+void CAESinkSTB::Log(void* /*userdata*/, enum stbp_log_level level, const char* message)
+{
+  int kodiLevel = LOGDEBUG;
+  switch (level)
+  {
+    case STBP_LOG_ERROR:
+      kodiLevel = LOGERROR;
+      break;
+    case STBP_LOG_WARNING:
+      kodiLevel = LOGWARNING;
+      break;
+    case STBP_LOG_INFO:
+      kodiLevel = LOGINFO;
+      break;
+    case STBP_LOG_DEBUG:
+    case STBP_LOG_TRACE:
+      break;
+  }
+  CLog::Log(kodiLevel, "libstbplayer audio: {}", message != nullptr ? message : "");
+}
+
+bool CAESinkSTB::Initialize(AEAudioFormat& format, std::string& device)
+{
+  struct stbp_host_callbacks host = {};
+  struct stbp_audio_capabilities capabilities = {};
+  struct stbp_audio_config config = {};
+  const enum stbp_audio_codec codec = CodecForFormat(format);
+
+  Deinitialize();
+  if (codec == STBP_AUDIO_CODEC_UNKNOWN)
+  {
+    CLog::LogF(LOGERROR, "unsupported raw stream type {}",
+               static_cast<int>(format.m_streamInfo.m_type));
+    return false;
+  }
+
+  host.struct_size = sizeof(host);
+  host.log = Log;
+  if (stbp_audio_create(&host, &m_device) != STBP_OK)
+    return false;
+
+  capabilities.struct_size = sizeof(capabilities);
+  if (stbp_audio_probe(m_device, &capabilities) != STBP_OK ||
+      (capabilities.codec_mask & STBP_AUDIO_CODEC_BIT(codec)) == 0)
+  {
+    Deinitialize();
+    return false;
+  }
+
+  m_format = format;
+  config.struct_size = sizeof(config);
+  config.codec = codec;
+  if (m_format.m_dataFormat == AE_FMT_RAW)
+  {
+    config.sample_rate = m_format.m_streamInfo.m_sampleRate;
+    config.channels = m_format.m_streamInfo.m_channels;
+    m_format.m_channelLayout = AE_CH_LAYOUT_2_0;
+    m_format.m_frameSize = 1;
+    m_format.m_frames = std::min(capabilities.max_packet_size, 61440U);
+  }
+  else
+  {
+    m_format.m_dataFormat = AE_FMT_S16NE;
+    m_format.m_channelLayout = AE_CH_LAYOUT_2_0;
+    m_format.m_frameSize = 4;
+    m_format.m_frames = capabilities.preferred_period_frames;
+    config.sample_format = STBP_AUDIO_SAMPLE_S16_NATIVE;
+    config.sample_rate = m_format.m_sampleRate;
+    config.channels = 2;
+    config.bits_per_sample = 16;
+  }
+
+  if (config.sample_rate == 0 || config.channels == 0 || m_format.m_frames == 0)
+  {
+    Deinitialize();
+    return false;
+  }
+
+  if (stbp_audio_open(m_device, &config) != STBP_OK)
+  {
+    Deinitialize();
+    return false;
+  }
+
+  format = m_format;
+  device = "default";
+  m_nextPts90k = 0;
+  m_pcmSampleClock = codec == STBP_AUDIO_CODEC_PCM &&
+                    (capabilities.feature_mask & STBP_AUDIO_FEATURE_PCM_SAMPLE_CLOCK) != 0;
+  pcmMediaClock = codec == STBP_AUDIO_CODEC_PCM && !m_pcmSampleClock;
+  CLog::LogF(LOGINFO, "opened STB hardware audio output for codec {} at {} Hz",
+             static_cast<int>(codec), config.sample_rate);
+  if (m_pcmSampleClock)
+    CLog::LogF(LOGINFO, "PCM decoder clock uses elapsed samples, not media PTS");
+  return true;
+}
+
+void CAESinkSTB::Deinitialize()
+{
+  pcmMediaClock = false;
+  if (m_device != nullptr)
+  {
+    stbp_audio_destroy(m_device);
+    m_device = nullptr;
+  }
+  m_nextPts90k = 0;
+  m_firstPts90k = STBP_AUDIO_PTS_NONE;
+  m_hasMediaTimestamp = false;
+  m_clockStarted = false;
+  m_pcmSampleClock = false;
+  m_pcmFrames = 0;
+}
+
+void CAESinkSTB::SetTimestamp(int64_t timestampMs, bool valid)
+{
+  // Untimed GUI/keepalive audio still needs PES timestamps to start the decoder.
+  if (!valid || m_pcmSampleClock)
+    return;
+
+  if (!m_hasMediaTimestamp)
+  {
+    Flush();
+    m_hasMediaTimestamp = true;
+  }
+  m_nextPts90k = timestampMs * 90;
+}
+
+unsigned int CAESinkSTB::AddPackets(uint8_t** data,
+                                    unsigned int frames,
+                                    unsigned int offset)
+{
+  struct stbp_audio_packet packet = {};
+  int64_t duration90k;
+  enum stbp_result result;
+
+  if (m_device == nullptr || data == nullptr || data[0] == nullptr || frames == 0)
+    return 0;
+
+  if (m_format.m_dataFormat == AE_FMT_RAW)
+  {
+    duration90k = static_cast<int64_t>(std::llround(m_format.m_streamInfo.GetDuration() * 90.0));
+  }
+  else
+  {
+    duration90k = static_cast<int64_t>(frames) * PTS_HZ / m_format.m_sampleRate;
+  }
+
+  AEDelayStatus delay;
+  GetDelay(delay);
+  if (delay.delay + static_cast<double>(duration90k) / PTS_HZ > GetCacheTotal())
+    return 0;
+
+  packet.struct_size = sizeof(packet);
+  packet.data = data[0] + static_cast<size_t>(offset) * m_format.m_frameSize;
+  packet.size = static_cast<size_t>(frames) * m_format.m_frameSize;
+  packet.pts_90k = m_nextPts90k;
+  packet.duration_90k = duration90k;
+  result = stbp_audio_queue_packet(m_device, &packet);
+  if (result == STBP_AGAIN)
+    return 0;
+  if (result != STBP_OK)
+  {
+    CLog::LogF(LOGERROR, "failed to queue STB hardware audio: {}", stbp_result_string(result));
+    return std::numeric_limits<unsigned int>::max();
+  }
+
+  if (m_firstPts90k == STBP_AUDIO_PTS_NONE)
+    m_firstPts90k = m_nextPts90k;
+  if (m_pcmSampleClock)
+    m_pcmFrames += frames;
+  m_nextPts90k += duration90k;
+  return frames;
+}
+
+void CAESinkSTB::AddPause(unsigned int millis)
+{
+  std::this_thread::sleep_for(std::chrono::milliseconds(millis));
+}
+
+void CAESinkSTB::GetDelay(AEDelayStatus& status)
+{
+  struct stbp_audio_status audioStatus = {};
+  double delay = 0.0;
+
+  if (m_device != nullptr)
+  {
+    audioStatus.struct_size = sizeof(audioStatus);
+    if (stbp_audio_get_status(m_device, &audioStatus) == STBP_OK &&
+        audioStatus.presentation_pts_90k != STBP_AUDIO_PTS_NONE &&
+        audioStatus.queued_end_pts_90k != STBP_AUDIO_PTS_NONE)
+    {
+      if (m_pcmSampleClock)
+      {
+        const double queuedSeconds = static_cast<double>(m_pcmFrames) / m_format.m_sampleRate;
+        delay = std::max(queuedSeconds -
+                             static_cast<double>(audioStatus.presentation_pts_90k) / PTS_HZ,
+                         0.0);
+      }
+      else
+      {
+        if (!m_clockStarted && m_firstPts90k != STBP_AUDIO_PTS_NONE &&
+            audioStatus.presentation_pts_90k != 0)
+        {
+          const int64_t played = PtsDistance(audioStatus.presentation_pts_90k, m_firstPts90k);
+          const int64_t queued = PtsDistance(audioStatus.queued_end_pts_90k, m_firstPts90k);
+          m_clockStarted = played >= 0 && played <= queued;
+        }
+        // The driver can retain an old PTS until the new decoder has enough input.
+        const int64_t presented = !m_clockStarted && m_firstPts90k != STBP_AUDIO_PTS_NONE
+                                      ? m_firstPts90k
+                                      : audioStatus.presentation_pts_90k;
+        const int64_t delay90k = PtsDistance(audioStatus.queued_end_pts_90k, presented);
+        delay = std::max(static_cast<double>(delay90k) / PTS_HZ, 0.0);
+      }
+    }
+  }
+  status.SetDelay(delay);
+}
+
+void CAESinkSTB::Drain()
+{
+  if (m_device != nullptr)
+    stbp_audio_drain(m_device);
+}
+
+void CAESinkSTB::Flush()
+{
+  if (m_device != nullptr)
+  {
+    if (m_pcmSampleClock)
+    {
+      // CLEAR_BUFFER leaves the old sample counter visible until decoding resumes.
+      struct stbp_audio_config config = {};
+      config.struct_size = sizeof(config);
+      config.codec = STBP_AUDIO_CODEC_PCM;
+      config.sample_format = STBP_AUDIO_SAMPLE_S16_NATIVE;
+      config.sample_rate = m_format.m_sampleRate;
+      config.channels = 2;
+      config.bits_per_sample = 16;
+      stbp_audio_close(m_device);
+      if (stbp_audio_open(m_device, &config) != STBP_OK)
+        CLog::LogF(LOGERROR, "failed to reset PCM sample clock");
+#if !defined(TARGET_AMLOGIC)
+      SetVolume(m_volume);
+#endif
+    }
+    else
+      stbp_audio_flush(m_device, STBP_AUDIO_PTS_NONE);
+  }
+  m_nextPts90k = 0;
+  m_firstPts90k = STBP_AUDIO_PTS_NONE;
+  m_hasMediaTimestamp = false;
+  m_clockStarted = false;
+  m_pcmFrames = 0;
+}
+
+#if !defined(TARGET_AMLOGIC)
+void CAESinkSTB::SetVolume(float volume)
+{
+  m_volume = volume;
+  if (m_device == nullptr)
+    return;
+
+  const auto percentage =
+      static_cast<uint32_t>(std::lround(std::clamp(volume, 0.0f, 1.0f) * 100.0f));
+  const enum stbp_result result = stbp_audio_set_volume(m_device, percentage, percentage);
+  if (result != STBP_OK)
+    CLog::LogF(LOGWARNING, "failed to set STB hardware audio volume: {}",
+               stbp_result_string(result));
+}
+#endif
+
+void CAESinkSTB::EnumerateDevicesEx(AEDeviceInfoList& list, bool /*force*/)
+{
+  struct stbp_host_callbacks host = {};
+  struct stbp_audio_capabilities capabilities = {};
+  struct stbp_audio_device* device = nullptr;
+
+  host.struct_size = sizeof(host);
+  capabilities.struct_size = sizeof(capabilities);
+  if (stbp_audio_create(&host, &device) != STBP_OK)
+    return;
+  const enum stbp_result result = stbp_audio_probe(device, &capabilities);
+  stbp_audio_destroy(device);
+  if (result != STBP_OK)
+    return;
+
+  CAEDeviceInfo info;
+  info.m_deviceName = "default";
+  info.m_displayName = "STB hardware audio";
+  info.m_deviceType = AE_DEVTYPE_HDMI;
+  info.m_wantsIECPassthrough = false;
+  info.m_channels = AE_CH_LAYOUT_2_0;
+  info.m_sampleRates = {32000, 44100, 48000};
+  info.m_dataFormats = {AE_FMT_S16NE, AE_FMT_RAW};
+  if ((capabilities.codec_mask & STBP_AUDIO_CODEC_BIT(STBP_AUDIO_CODEC_AC3)) != 0)
+    info.m_streamTypes.emplace_back(CAEStreamInfo::STREAM_TYPE_AC3);
+  if ((capabilities.codec_mask & STBP_AUDIO_CODEC_BIT(STBP_AUDIO_CODEC_EAC3)) != 0)
+    info.m_streamTypes.emplace_back(CAEStreamInfo::STREAM_TYPE_EAC3);
+  if ((capabilities.codec_mask & STBP_AUDIO_CODEC_BIT(STBP_AUDIO_CODEC_DTS)) != 0)
+  {
+    info.m_streamTypes.emplace_back(CAEStreamInfo::STREAM_TYPE_DTS_512);
+    info.m_streamTypes.emplace_back(CAEStreamInfo::STREAM_TYPE_DTS_1024);
+    info.m_streamTypes.emplace_back(CAEStreamInfo::STREAM_TYPE_DTS_2048);
+    info.m_streamTypes.emplace_back(CAEStreamInfo::STREAM_TYPE_DTSHD_CORE);
+  }
+  list.emplace_back(std::move(info));
+}
