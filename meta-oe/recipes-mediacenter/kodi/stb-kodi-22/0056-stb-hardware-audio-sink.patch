index 0000000000..c2e88bdfe4
--- /dev/null
+++ b/xbmc/settings/STBAVSettings.cpp
@@ -0,0 +1,247 @@
+/*
+ * Copyright (C) 2026 OE-Alliance contributors
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "STBAVSettings.h"
+
+#include "ServiceBroker.h"
+#include "cores/AudioEngine/Sinks/AESinkSTB.h"
+#include "dialogs/GUIDialogYesNo.h"
+#include "resources/LocalizeStrings.h"
+#include "resources/ResourcesComponent.h"
+#include "settings/lib/Setting.h"
+#include "settings/lib/SettingsManager.h"
+#include "utils/log.h"
+
+#include <algorithm>
+#include <map>
+#include <utility>
+
+CSTBAVSettings& CSTBAVSettings::GetInstance()
+{
+  static CSTBAVSettings instance;
+  return instance;
+}
+
+void CSTBAVSettings::Initialize(CSettingsManager* manager)
+{
+  m_manager = manager;
+  manager->RegisterSettingOptionsFiller("stbavmodes", FillOptions);
+  manager->AddDynamicCondition("stbavavailable", IsAvailable);
+  manager->AddDynamicCondition("stbavenabled", IsEnabled);
+  manager->RegisterSettingsHandler(this);
+  SettingsContainer ids{"stbaudio.save", "stbvideo.save"};
+  for (const auto& control : CSTBAVControl::Controls())
+    ids.emplace(control.id);
+  manager->RegisterCallback(this, ids);
+}
+
+void CSTBAVSettings::Uninitialize()
+{
+  OnSettingsUnloaded();
+  m_manager->UnregisterCallback(this);
+  m_manager->UnregisterSettingsHandler(this);
+  m_manager->UnregisterSettingOptionsFiller("stbavmodes");
+  m_manager->RemoveDynamicCondition("stbavavailable");
+  m_manager->RemoveDynamicCondition("stbavenabled");
+  m_manager = nullptr;
+}
+
+void CSTBAVSettings::LoadGroup(const std::string& group, bool applySaved)
+{
+  m_updating = true;
+  for (const auto& control : CSTBAVControl::Controls())
+  {
+    const std::string id = control.id;
+    if (id.compare(0, group.size(), group) != 0 || !m_controls.Available(id))
+      continue;
+    auto setting = std::dynamic_pointer_cast<CSettingString>(m_manager->GetSetting(id));
+    if (!setting)
+      continue;
+    if (applySaved && IsEnabled({}, id, setting) && !setting->GetValue().empty() &&
+        !m_controls.Set(id, setting->GetValue()))
+      CLog::Log(LOGWARNING, "STB AV: cannot apply saved {}={}; keeping driver value", id,
+                setting->GetValue());
+    setting->SetValue(m_controls.Read(id));
+  }
+  m_updating = false;
+  if (group == "stbaudio")
+    CAESinkSTB::NotifyDtsModeChanged();
+}
+
+void CSTBAVSettings::OnSettingsLoaded()
+{
+  m_controls.Capture();
+  if (CAESinkSTB::DtsUsesAc3Mode())
+  {
+    if (const auto setting = m_manager->GetSetting("stbaudio.ac3"))
+    {
+      setting->SetLabel(54215);
+      setting->SetHelp(54216);
+    }
+  }
+  for (const std::string group : {"stbaudio", "stbvideo"})
+  {
+    const auto save = std::dynamic_pointer_cast<CSettingBool>(m_manager->GetSetting(group + ".save"));
+    LoadGroup(group, save && save->GetValue());
+  }
+  CLog::Log(LOGINFO, "STB AV: captured current driver settings; unsaved modes follow Enigma2");
+}
+
+void CSTBAVSettings::OnSettingsUnloaded()
+{
+  m_updating = true;
+  if (!m_controls.Restore(""))
+    CLog::Log(LOGERROR, "STB AV: failed to restore one or more original driver settings");
+  m_controls.Clear();
+}
+
+bool CSTBAVSettings::IsAvailable(const std::string&, const std::string& value,
+                                 const std::shared_ptr<const CSetting>&)
+{
+  if (value.compare(0, 8, "stbaudio") == 0 && !CAESinkSTB::IsSelected())
+    return false;
+  auto& controls = GetInstance().m_controls;
+  if (value == "stbaudio" || value == "stbvideo")
+  {
+    for (const auto& control : CSTBAVControl::Controls())
+      if (std::string(control.id).compare(0, value.size(), value) == 0 &&
+          controls.Available(control.id))
+        return true;
+    return false;
+  }
+  return controls.Available(value);
+}
+
+bool CSTBAVSettings::IsEnabled(const std::string&, const std::string& value,
+                               const std::shared_ptr<const CSetting>& setting)
+{
+  if (!IsAvailable({}, value, setting))
+    return false;
+  // A driver mode does not add a compressed format to the Kodi audio sink.
+  if (value == "stbaudio.aac" || value == "stbaudio.aacplus" ||
+      value == "stbaudio.aac_transcode" || value == "stbaudio.dtshd" ||
+      value == "stbaudio.wmapro")
+    return false;
+  if (value == "stbaudio.ac3" || value == "stbaudio.ac3plus" || value == "stbaudio.dts")
+  {
+    AEDeviceInfoList devices;
+    CAESinkSTB::EnumerateDevicesEx(devices, false);
+    const auto type = value == "stbaudio.ac3" ? CAEStreamInfo::STREAM_TYPE_AC3
+                      : value == "stbaudio.ac3plus" ? CAEStreamInfo::STREAM_TYPE_EAC3
+                                                   : CAEStreamInfo::STREAM_TYPE_DTS_512;
+    return std::any_of(devices.begin(), devices.end(), [type](const auto& device)
+                       { return std::find(device.m_streamTypes.begin(), device.m_streamTypes.end(),
+                                          type) != device.m_streamTypes.end(); });
+  }
+  return true;
+}
+
+std::vector<std::shared_ptr<CSettingString>> CSTBAVSettings::GetPlaybackSettings(
+    const std::string& group) const
+{
+  std::vector<std::shared_ptr<CSettingString>> settings;
+  if (!m_manager)
+    return settings;
+  for (const auto& control : CSTBAVControl::Controls())
+  {
+    const std::string id = control.id;
+    if (id.compare(0, group.size() + 1, group + ".") != 0 || !IsAvailable({}, id, {}))
+      continue;
+    if (auto setting = std::dynamic_pointer_cast<CSettingString>(m_manager->GetSetting(id)))
+      settings.emplace_back(std::move(setting));
+  }
+  return settings;
+}
+
+bool CSTBAVSettings::SetPlaybackValue(const std::shared_ptr<const CSetting>& setting)
+{
+  const auto value = std::dynamic_pointer_cast<const CSettingString>(setting);
+  if (!m_manager || !value || !IsEnabled({}, value->GetId(), value))
+    return false;
+  const auto target =
+      std::dynamic_pointer_cast<CSettingString>(m_manager->GetSetting(value->GetId()));
+  // Use the global callback for validation, video confirmation and E2 restore tracking.
+  return target && target->SetValue(value->GetValue());
+}
+
+bool CSTBAVSettings::OnSettingChanging(const std::shared_ptr<const CSetting>& setting)
+{
+  if (m_updating)
+    return true;
+  const auto& id = setting->GetId();
+  if (id == "stbaudio.save" || id == "stbvideo.save")
+  {
+    if (!std::static_pointer_cast<const CSettingBool>(setting)->GetValue())
+    {
+      const auto group = id.substr(0, id.find('.'));
+      if (!m_controls.Restore(group))
+        return false;
+      LoadGroup(group, false);
+    }
+    return true;
+  }
+  const auto value = std::static_pointer_cast<const CSettingString>(setting)->GetValue();
+  const auto previous = m_controls.Read(id);
+  if (previous == value)
+    return true;
+  if (!IsEnabled({}, id, setting) || !m_controls.Set(id, value))
+  {
+    CLog::Log(LOGERROR, "STB AV: rejected {}={}; driver remains {}", id, value, previous);
+    return false;
+  }
+  if (id.compare(0, 8, "stbvideo") == 0)
+  {
+    bool cancelled = false;
+    if (!CGUIDialogYesNo::ShowAndGetInput(CVariant{54000}, CVariant{54006}, cancelled,
+                                         CVariant{222}, CVariant{186}, 15000))
+    {
+      if (!m_controls.Set(id, previous))
+        CLog::Log(LOGERROR, "STB AV: failed to revert {} to {}", id, previous);
+      return false;
+    }
+  }
+  CLog::Log(LOGINFO, "STB AV: changed {} from {} to {}", id, previous, value);
+  if (id == "stbaudio.ac3")
+    CAESinkSTB::NotifyDtsModeChanged();
+  return true;
+}
+
+std::string CSTBAVSettings::Label(const std::string& id, const std::string& value)
+{
+  static const std::map<std::string, int> labels{
+      {"downmix", 54100}, {"passthrough", 54101}, {"multichannel", 54102},
+      {"force_ac3", 54103}, {"force_dts", 54104}, {"force_ddp", 54105},
+      {"use_hdmi_caps", 54106}, {"hdmi_best", 54106}, {"auto", 54106},
+      {"Edid(Auto)", 54106}, {"auto(EDID)", 54106},
+      {"none", 54107}, {"off", 54107}, {"disable", 54107}, {"no", 54107},
+      {"on", 54108}, {"enable", 54108}, {"yes", 54108},
+      {"center", 54109}, {"wide", 54110}, {"extrawide", 54111}};
+  int label = 0;
+  if (id == "stbaudio.digital_raw")
+    label = value == "0" ? 54100 : value == "1" ? 54101 : 54106;
+  else if (id == "stbvideo.allow_10bit" || id == "stbvideo.allow_12bit")
+    label = value == "0" ? 54108 : 54107;
+  else if (id == "stbaudio.audio_source" && value == "2")
+    return "Bluetooth";
+  else if (id == "stbaudio.audio_source" && (value == "0" || value == "pcm"))
+    return "PCM";
+  else if (id == "stbaudio.audio_source" && (value == "1" || value == "spdif"))
+    return "S/PDIF";
+  else if (const auto it = labels.find(value); it != labels.end())
+    label = it->second;
+  return label ? CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(label) : value;
+}
+
+void CSTBAVSettings::FillOptions(const std::shared_ptr<const CSetting>& setting,
+                                 std::vector<StringSettingOption>& options, std::string& current)
+{
+  auto& controls = GetInstance().m_controls;
+  const auto& id = setting->GetId();
+  const auto values = controls.Choices(id);
+  current = controls.Read(id);
+  for (const auto& value : values)
+    options.emplace_back(Label(id, value), value);
+  if (!current.empty() && std::find(values.begin(), values.end(), current) == values.end())
+    options.emplace_back(current, current);
+}
