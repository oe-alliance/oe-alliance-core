diff --git a/xbmc/settings/STBAVControl.cpp b/xbmc/settings/STBAVControl.cpp
new file mode 100644
index 0000000000..d3edaffba6
--- /dev/null
+++ b/xbmc/settings/STBAVControl.cpp
@@ -0,0 +1,193 @@
+/*
+ * Copyright (C) 2026 OE-Alliance contributors
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "STBAVControl.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <fcntl.h>
+#include <fstream>
+#include <sstream>
+#include <unistd.h>
+#include <utility>
+
+CSTBAVControl::CSTBAVControl(std::string root) : m_root(std::move(root))
+{
+}
+
+const std::vector<CSTBAVControl::Control>& CSTBAVControl::Controls()
+{
+  // Prefer the driver's choices. Fallbacks are fixed interfaces used by E2.
+  static const std::vector<Control> controls{
+      {"stbaudio.ac3", "/proc/stb/audio/ac3", ""},
+      {"stbaudio.ac3plus", "/proc/stb/audio/ac3plus", ""},
+      {"stbaudio.dts", "/proc/stb/audio/dts", ""},
+      {"stbaudio.dtshd", "/proc/stb/audio/dtshd", ""},
+      {"stbaudio.aac", "/proc/stb/audio/aac", ""},
+      {"stbaudio.aacplus", "/proc/stb/audio/aacplus", ""},
+      {"stbaudio.aac_transcode", "/proc/stb/audio/aac_transcode", ""},
+      {"stbaudio.wmapro", "/proc/stb/audio/wmapro", ""},
+      {"stbaudio.multichannel_pcm", "/proc/stb/audio/multichannel_pcm", "disable enable"},
+      {"stbaudio.audio_source", "/proc/stb/hdmi/audio_source", "pcm spdif"},
+      {"stbaudio.digital_raw", "/sys/class/audiodsp/digital_raw", "0 1 2"},
+      {"stbaudio.3d_surround", "/proc/stb/audio/3d_surround", ""},
+      {"stbaudio.3d_surround_speaker_position", "/proc/stb/audio/3d_surround_speaker_position", ""},
+      {"stbaudio.avl", "/proc/stb/audio/avl", ""},
+      {"stbaudio.btaudio", "/proc/stb/audio/btaudio", "off on"},
+      {"stbvideo.hdmi_colorspace", "/proc/stb/video/hdmi_colorspace", ""},
+      {"stbvideo.hdmi_colorimetry", "/proc/stb/video/hdmi_colorimetry", ""},
+      {"stbvideo.hdmi_colordepth", "/proc/stb/video/hdmi_colordepth", "auto 8bit 10bit 12bit"},
+      {"stbvideo.hdmi_hdrtype", "/proc/stb/video/hdmi_hdrtype", "auto dolby none hdr10 hdr10+ hlg"},
+      {"stbvideo.hlg_support", "/proc/stb/hdmi/hlg_support", ""},
+      {"stbvideo.hdr10_support", "/proc/stb/hdmi/hdr10_support", ""},
+      {"stbvideo.allow_10bit", "/proc/stb/video/disable_10bit", "0 1"},
+      {"stbvideo.allow_12bit", "/proc/stb/video/disable_12bit", "0 1"},
+      {"stbvideo.sync_mode", "/proc/stb/video/sync_mode", ""},
+      {"stbvideo.deinterlace", "/proc/stb/vmpeg/deinterlace", "off auto on bob"}};
+  return controls;
+}
+
+std::string CSTBAVControl::Path(const std::string& id) const
+{
+  for (const auto& control : Controls())
+  {
+    if (id == control.id)
+    {
+      // Dream uses dtshd for DTS core routing as well, without a separate dts node.
+      const auto dtsHD = m_root + "/proc/stb/audio/dtshd";
+      if (id == "stbaudio.dts" && access((m_root + control.path).c_str(), F_OK) != 0 &&
+          access(dtsHD.c_str(), R_OK | W_OK) == 0)
+      {
+        std::istringstream choices(ReadPath(dtsHD + "_choices"));
+        for (std::string choice; choices >> choice;)
+          if (choice == "force_dts")
+            return dtsHD;
+      }
+      if (id == "stbaudio.dtshd" && Path("stbaudio.dts") == dtsHD)
+        return {};
+      if (id == "stbaudio.audio_source" &&
+          access((m_root + "/sys/devices/virtual/amhdmitx/amhdmitx0/audio_source").c_str(),
+                 R_OK | W_OK) == 0)
+        return m_root + "/sys/devices/virtual/amhdmitx/amhdmitx0/audio_source";
+      return m_root + control.path;
+    }
+  }
+  return {};
+}
+
+std::string CSTBAVControl::ReadPath(const std::string& path)
+{
+  std::ifstream file(path);
+  std::string value;
+  std::getline(file, value);
+  const auto start = value.find_first_not_of(" \t\r\n");
+  if (start == std::string::npos)
+    return {};
+  return value.substr(start, value.find_last_not_of(" \t\r\n") - start + 1);
+}
+
+std::string CSTBAVControl::Read(const std::string& id) const
+{
+  return ReadPath(Path(id));
+}
+
+std::vector<std::string> CSTBAVControl::Choices(const std::string& id) const
+{
+  const auto path = Path(id);
+  if (path.empty() || access(path.c_str(), R_OK | W_OK) != 0 || ReadPath(path).empty())
+    return {};
+  auto choices = ReadPath(path + "_choices");
+  if (choices.empty())
+  {
+    for (const auto& control : Controls())
+      if (id == control.id)
+        choices = control.fallback;
+    if (id == "stbaudio.audio_source" && path.find("/sys/") != std::string::npos)
+      choices = "0 1 2";
+  }
+  std::istringstream tokens(choices);
+  std::vector<std::string> result;
+  for (std::string value; tokens >> value;)
+    if (std::find(result.begin(), result.end(), value) == result.end())
+      result.push_back(value);
+  return result;
+}
+
+bool CSTBAVControl::Available(const std::string& id) const
+{
+  return !Choices(id).empty();
+}
+
+void CSTBAVControl::Capture()
+{
+  Clear();
+  for (const auto& control : Controls())
+    if (Available(control.id))
+      m_original.emplace(control.id, Read(control.id));
+}
+
+bool CSTBAVControl::WritePath(const std::string& path, const std::string& value)
+{
+  // Never create a missing control node.
+  const int fd = open(path.c_str(), O_WRONLY | O_CLOEXEC | O_TRUNC);
+  if (fd < 0)
+    return false;
+  const auto line = value + "\n";
+  ssize_t count;
+  do
+    count = write(fd, line.data(), line.size());
+  while (count < 0 && errno == EINTR);
+  close(fd);
+  return count == static_cast<ssize_t>(line.size()) && ReadPath(path) == value;
+}
+
+bool CSTBAVControl::Set(const std::string& id, const std::string& value)
+{
+  const auto original = m_original.find(id);
+  if (original == m_original.end() || value.empty())
+    return false;
+  const auto previous = Read(id);
+  if (previous == value)
+    return true;
+  const auto choices = Choices(id);
+  if (value != original->second && std::find(choices.begin(), choices.end(), value) == choices.end())
+    return false;
+  const auto path = Path(id);
+  if (!WritePath(path, value))
+  {
+    WritePath(path, previous);
+    return false;
+  }
+  m_written[id] = value;
+  return true;
+}
+
+bool CSTBAVControl::Restore(const std::string& group)
+{
+  bool success = true;
+  for (auto it = m_written.begin(); it != m_written.end();)
+  {
+    if (it->first.compare(0, group.size(), group) != 0)
+    {
+      ++it;
+      continue;
+    }
+    // Do not overwrite a mode subsequently changed by another owner.
+    if (Read(it->first) == it->second &&
+        !WritePath(Path(it->first), m_original.at(it->first)))
+    {
+      success = false;
+      ++it;
+    }
+    else
+      it = m_written.erase(it);
+  }
+  return success;
+}
+
+void CSTBAVControl::Clear()
+{
+  m_original.clear();
+  m_written.clear();
+}
