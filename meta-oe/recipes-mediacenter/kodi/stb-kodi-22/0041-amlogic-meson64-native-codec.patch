diff --git a/xbmc/windowing/egl/EGLNativeTypeMali.cpp b/xbmc/windowing/egl/EGLNativeTypeMali.cpp
index f5c26b8..612e626 100644
--- a/xbmc/windowing/egl/EGLNativeTypeMali.cpp
+++ b/xbmc/windowing/egl/EGLNativeTypeMali.cpp
@@ -144,7 +144,21 @@ bool CEGLNativeTypeMali::CreateNativeDisplay() {
 
 bool CEGLNativeTypeMali::CreateNativeWindow() {
   CLog::Log(LOGDEBUG, "CEGLNativeTypeMali::CreateNativeWindow()\n");
+#if defined(TARGET_AMLOGIC)
+  RESOLUTION_INFO resolution;
+  if (!_GetNativeResolution(&resolution))
+  {
+    CLog::Log(LOGERROR, "CEGLNativeTypeMali: cannot query Amlogic framebuffer geometry");
+    return false;
+  }
+  m_fbdevWindow.width = static_cast<unsigned short>(resolution.iWidth);
+  m_fbdevWindow.height = static_cast<unsigned short>(resolution.iHeight);
+  m_nativeWindow = reinterpret_cast<XBNativeWindowType>(&m_fbdevWindow);
+  CLog::Log(LOGINFO, "CEGLNativeTypeMali: Amlogic fbdev window {}x{}",
+            m_fbdevWindow.width, m_fbdevWindow.height);
+#else
   m_nativeWindow = EGL_DEFAULT_DISPLAY;
+#endif
   return true;
 }
 
@@ -253,6 +267,13 @@ bool CEGLNativeTypeMali::SetNativeResolution(const RESOLUTION_INFO &res) {
   if (!applied)
     CLog::Log(LOGWARNING, "CEGLNativeTypeMali: driver kept OSD framebuffer at {}x{}",
               vinfo.xres, vinfo.yres);
+#if defined(TARGET_AMLOGIC)
+  if (applied)
+  {
+    m_fbdevWindow.width = static_cast<unsigned short>(vinfo.xres);
+    m_fbdevWindow.height = static_cast<unsigned short>(vinfo.yres);
+  }
+#endif
   return applied;
 }
 
@@ -324,4 +345,3 @@ bool CEGLNativeTypeMali::ShowWindow(bool show) {
   CLog::Log(LOGDEBUG, "CEGLNativeTypeMali::ShowWindow()\n");
   return false;
 }
