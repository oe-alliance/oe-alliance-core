From: OpenATV STB Kodi Team <oe.patch@openatv.example>
Date: Mon, 10 Aug 2026 12:00:00 +0200
Subject: [PATCH] Amlogic: add native meson64 amcodec playback

Use the proven Amlogic 4.9 libamcodec decoder and renderer while keeping
OpenATV's STB windowing/input stack. DreamOne and DreamTwo Mali fbdev EGL
requires a persistent, non-null two-field native window.

diff --git a/cmake/modules/FindAML.cmake b/cmake/modules/FindAML.cmake
new file mode 100644
index 0000000..0d28812
--- /dev/null
+++ b/cmake/modules/FindAML.cmake
@@ -0,0 +1,50 @@
+#.rst:
+# FindAML
+# -------
+# Finds the Amlogic 4.9 amcodec userspace headers.  Kodi loads libamcodec
+# dynamically, so no link library is required here.
+#
+# This defines the following target:
+#
+#   ${APP_NAME_LC}::AML - The Amlogic amcodec interface
+
+if(NOT TARGET ${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME})
+  find_path(AML_INCLUDE_DIR NAMES amcodec/codec_error.h)
+
+  if(NOT VERBOSE_FIND)
+    set(${CMAKE_FIND_PACKAGE_NAME}_FIND_QUIETLY TRUE)
+  endif()
+
+  include(FindPackageHandleStandardArgs)
+  find_package_handle_standard_args(AML REQUIRED_VARS AML_INCLUDE_DIR)
+
+  if(AML_FOUND)
+    include(CheckCSourceCompiles)
+    set(AML_INCLUDE_DIRS "${AML_INCLUDE_DIR};${AML_INCLUDE_DIR}/amcodec")
+    set(CMAKE_REQUIRED_INCLUDES "${AML_INCLUDE_DIRS}")
+    check_c_source_compiles("#include <amcodec/codec.h>
+int main(void)
+{
+  int format = VIDEO_DEC_FORMAT_VP9;
+  return format;
+}
+" AML_HAS_VP9)
+    unset(CMAKE_REQUIRED_INCLUDES)
+
+    set(AML_DEFINITIONS -DHAS_LIBAMCODEC=1)
+    if(AML_HAS_VP9)
+      list(APPEND AML_DEFINITIONS -DHAS_LIBAMCODEC_VP9=1)
+    endif()
+
+    add_library(${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME} INTERFACE IMPORTED)
+    set_target_properties(${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME} PROPERTIES
+      INTERFACE_INCLUDE_DIRECTORIES "${AML_INCLUDE_DIRS}"
+      INTERFACE_COMPILE_DEFINITIONS "HAS_LIBAMCODEC=1")
+    if(AML_HAS_VP9)
+      set_property(TARGET ${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME} APPEND PROPERTY
+        INTERFACE_COMPILE_DEFINITIONS "HAS_LIBAMCODEC_VP9=1")
+    endif()
+  endif()
+endif()
+
+mark_as_advanced(AML_INCLUDE_DIR)
