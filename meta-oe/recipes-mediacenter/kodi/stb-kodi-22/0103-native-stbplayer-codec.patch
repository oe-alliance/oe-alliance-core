+ */
+
+#include "DVDVideoCodecSTB.h"
+
+#include "RendererSTB.h"
+#include "cores/VideoPlayer/Interface/TimingConstants.h"
+#include "utils/BitstreamConverter.h"
+#include "utils/log.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <limits>
+#include <mutex>
+#include <vector>
+
+namespace
+{
+bool HasAnnexBStartCode(const uint8_t* data, size_t size)
+{
+  return data != nullptr &&
+         ((size >= 4 && data[0] == 0 && data[1] == 0 && data[2] == 0 && data[3] == 1) ||
+          (size >= 3 && data[0] == 0 && data[1] == 0 && data[2] == 1));
+}
+
+bool ConvertHEVCDecoderConfiguration(const uint8_t* data,
+                                     size_t size,
+                                     std::vector<uint8_t>& annexB,
+                                     bool parameterSetsOnly)
+{
+  static constexpr uint8_t startCode[] = {0, 0, 0, 1};
+  if (data == nullptr || size < 23 || data[0] != 1)
+    return false;
+
+  annexB.clear();
+  size_t offset = 23;
+  const unsigned int arrayCount = data[22];
+  for (unsigned int array = 0; array < arrayCount; ++array)
+  {
+    if (offset + 3 > size)
+      return false;
+    const uint8_t nalType = data[offset] & 0x3f;
+    ++offset; // array completeness and NAL unit type
+    const unsigned int nalCount = (static_cast<unsigned int>(data[offset]) << 8) |
+                                  static_cast<unsigned int>(data[offset + 1]);
+    offset += 2;
+    for (unsigned int nal = 0; nal < nalCount; ++nal)
+    {
+      if (offset + 2 > size)
+        return false;
+      const size_t nalSize = (static_cast<size_t>(data[offset]) << 8) |
+                             static_cast<size_t>(data[offset + 1]);
+      offset += 2;
+      if (nalSize == 0 || nalSize > size - offset)
+        return false;
+      if (!parameterSetsOnly || nalType == 32 || nalType == 33 || nalType == 34)
+      {
+        annexB.insert(annexB.end(), startCode, startCode + sizeof(startCode));
+        annexB.insert(annexB.end(), data + offset, data + offset + nalSize);
+      }
+      offset += nalSize;
+    }
+  }
+  return !annexB.empty();
+}
+
+uint32_t UpperFourCC(uint32_t tag)
+{
+  uint32_t result = 0;
+  for (unsigned int shift = 0; shift < 32; shift += 8)
+  {
+    uint32_t value = (tag >> shift) & 0xffU;
+    if (value >= 'a' && value <= 'z')
+      value -= 'a' - 'A';
+    result |= value << shift;
+  }
+  return result;
+}
+
+constexpr uint32_t FourCC(char a, char b, char c, char d)
+{
+  return static_cast<uint32_t>(a) | (static_cast<uint32_t>(b) << 8) |
+         (static_cast<uint32_t>(c) << 16) | (static_cast<uint32_t>(d) << 24);
+}
+} // namespace
+
+CDVDVideoCodecSTB::CDVDVideoCodecSTB(CProcessInfo& processInfo) : CDVDVideoCodec(processInfo)
+{
+}
+
+CDVDVideoCodecSTB::~CDVDVideoCodecSTB()
+{
+  // Renderer buffers deliberately keep the session alive until the render thread
+  // releases them.  The DVB decoder itself must not stay open that long: Kodi can
+  // construct the codec for the next file first and /dev/dvb/.../video0 is exclusive.
+  // Close the backend here while the session object remains safe for stale buffers.
+  if (m_session)
+    m_session->Close();
+  m_open = false;
+  m_pictures.clear();
+  m_bufferPool.reset();
+  m_session.reset();
+}
+
+enum stbp_codec CDVDVideoCodecSTB::MapCodec(const CDVDStreamInfo& hints)
+{
+  switch (hints.codec)
+  {
+    case AV_CODEC_ID_MPEG1VIDEO:
+      return STBP_CODEC_MPEG1;
+    case AV_CODEC_ID_MPEG2VIDEO:
+      return STBP_CODEC_MPEG2;
+    case AV_CODEC_ID_MPEG4:
+      switch (UpperFourCC(hints.codec_tag))
+      {
+        case FourCC('X', 'V', 'I', 'D'):
+          return STBP_CODEC_XVID;
+        case FourCC('D', 'I', 'V', 'X'):
+          return STBP_CODEC_DIVX4;
+        case FourCC('D', 'X', '5', '0'):
+          return STBP_CODEC_DIVX5;
+        default:
+          break;
+      }
+      return STBP_CODEC_MPEG4_PART2;
+    case AV_CODEC_ID_MSMPEG4V3:
+      return STBP_CODEC_MSMPEG4V3;
+    case AV_CODEC_ID_H263:
+    case AV_CODEC_ID_H263P:
+    case AV_CODEC_ID_H263I:
+      return STBP_CODEC_H263;
+    case AV_CODEC_ID_H264:
+      return STBP_CODEC_H264;
+    case AV_CODEC_ID_HEVC:
+      return STBP_CODEC_HEVC;
+    case AV_CODEC_ID_VC1:
+      return STBP_CODEC_VC1;
+    case AV_CODEC_ID_WMV3:
+      return STBP_CODEC_WMV3;
+    case AV_CODEC_ID_VP8:
+      return STBP_CODEC_VP8;
+    case AV_CODEC_ID_VP9:
+      return STBP_CODEC_VP9;
+    case AV_CODEC_ID_VP6:
+    case AV_CODEC_ID_VP6F:
+    case AV_CODEC_ID_VP6A:
+      return STBP_CODEC_VP6;
+    case AV_CODEC_ID_FLV1:
+      return STBP_CODEC_FLV1;
+    case AV_CODEC_ID_MJPEG:
+      return STBP_CODEC_MJPEG;
+    case AV_CODEC_ID_CAVS:
+      return STBP_CODEC_AVS;
+    case AV_CODEC_ID_AVS2:
+      return STBP_CODEC_AVS2;
+    default:
+      return STBP_CODEC_UNKNOWN;
+  }
+}
+
+int64_t CDVDVideoCodecSTB::To90k(double kodiTime)
+{
+  if (kodiTime == DVD_NOPTS_VALUE || !std::isfinite(kodiTime))
+    return STBP_PTS_NONE;
+  constexpr double scale = 90000.0 / static_cast<double>(DVD_TIME_BASE);
+  const double converted = std::round(kodiTime * scale);
+  if (converted > static_cast<double>(std::numeric_limits<int64_t>::max()) ||
+      converted < static_cast<double>(std::numeric_limits<int64_t>::min()))
+    return STBP_PTS_NONE;
+  return static_cast<int64_t>(converted);
+}
+
+double CDVDVideoCodecSTB::From90k(int64_t pts90k)
+{
+  if (pts90k == STBP_PTS_NONE)
+    return DVD_NOPTS_VALUE;
+  return static_cast<double>(pts90k) * static_cast<double>(DVD_TIME_BASE) / 90000.0;
+}
+
+bool CDVDVideoCodecSTB::ConfigureBitstream(const CDVDStreamInfo& hints,
+                                           const uint8_t*& extraData,
+                                           size_t& extraDataSize,
+                                           uint32_t& streamFlags,
+                                           bool preserveAllHevcArrays)
+{
+  extraData = hints.extradata.GetData();
+  extraDataSize = hints.extradata.GetSize();
+  if (hints.codec != AV_CODEC_ID_H264 && hints.codec != AV_CODEC_ID_HEVC)
+    return true;
+
+  streamFlags |= STBP_STREAM_ANNEX_B;
+  if (extraDataSize > 0)
+  {
+    if (hints.codec == AV_CODEC_ID_HEVC && !HasAnnexBStartCode(extraData, extraDataSize) &&
+        !ConvertHEVCDecoderConfiguration(extraData, extraDataSize, m_codecData,
+                                         !preserveAllHevcArrays))
+      return false;
+    m_bitstream = std::make_unique<CBitstreamConverter>();
+    if (m_bitstream->Open(hints.codec, const_cast<uint8_t*>(extraData),
+                          static_cast<int>(extraDataSize), true))
+    {
+      // Pass the converted Annex-B parameter sets to the backend as codec data as well.
+      // Some STB decoders require SPS/PPS before an initial SEI NAL, while the converter
+      // otherwise inserts them immediately before the IDR later in the same packet.
+      if (hints.codec == AV_CODEC_ID_HEVC && !m_codecData.empty())
+      {
+        // CBitstreamConverter deliberately retains only VPS/SPS/PPS from hvcC. Dream's
+        // hardware parser also submits configuration Prefix-SEI arrays; HDR metadata and
+        // some encoder configuration therefore disappear unless we preserve every array.
+        extraData = m_codecData.data();
+        extraDataSize = m_codecData.size();
+      }
+      else
+      {
+        extraData = m_bitstream->GetExtraData();
+        extraDataSize = static_cast<size_t>(m_bitstream->GetExtraSize());
+      }
+      if (extraData == nullptr || extraDataSize == 0)
+      {
+        m_bitstream.reset();
+        return false;
+      }
+      return true;
+    }
+    m_bitstream.reset();
+    if (!HasAnnexBStartCode(extraData, extraDataSize))
+      return false;
+  }
+  return true;
+}
+
+bool CDVDVideoCodecSTB::Open(CDVDStreamInfo& hints, CDVDCodecOptions& options)
+{
+  (void)options;
+  const enum stbp_codec codec = MapCodec(hints);
+  const char* configuredBackend = std::getenv("KODI_STBPLAYER_BACKEND");
+  const std::string backendName =
+      configuredBackend != nullptr && configuredBackend[0] != '\0' ? configuredBackend : "hisi-dvb";
+  const uint8_t* extraData = nullptr;
+  size_t extraDataSize = 0;
+  uint32_t streamFlags = hints.interlaced ? STBP_STREAM_INTERLACED : 0;
+  struct stbp_stream_config stream{};
+  struct stbp_clock_config clock{};
+  std::string error;
+
+  if (codec == STBP_CODEC_UNKNOWN || hints.cryptoSession || hints.width <= 0 || hints.height <= 0)
+    return false;
+  if (backendName == "dream-aml" && hints.codec == AV_CODEC_ID_MPEG2VIDEO &&
+      hints.profile == AV_PROFILE_MPEG2_422)
+  {
+    CLog::Log(LOGINFO,
+              "CDVDVideoCodecSTB: MPEG-2 4:2:2 is unsupported by Dream Amlogic; "
+              "using FFmpeg software decoding");
+    return false;
+  }
+  if (!ConfigureBitstream(hints, extraData, extraDataSize, streamFlags,
+                          backendName == "dream-aml"))
+    return false;
+
+  m_session = std::make_shared<CSTBVideoSession>();
+  if (!m_session->Load(backendName, error))
+  {
+    CLog::Log(LOGDEBUG, "CDVDVideoCodecSTB: backend '{}' unavailable: {}", backendName, error);
+    m_session.reset();
+    return false;
+  }
+  if ((m_session->Capabilities().codec_mask & STBP_CODEC_BIT(codec)) == 0)
+  {
+    CLog::Log(LOGDEBUG, "CDVDVideoCodecSTB: codec {} is not supported by '{}'",
+              static_cast<int>(codec), backendName);
+    m_session.reset();
+    return false;
+  }
+  if ((m_session->Capabilities().max_width != 0 &&
+       static_cast<uint32_t>(hints.width) > m_session->Capabilities().max_width) ||
+      (m_session->Capabilities().max_height != 0 &&
+       static_cast<uint32_t>(hints.height) > m_session->Capabilities().max_height))
+  {
+    CLog::Log(LOGDEBUG, "CDVDVideoCodecSTB: stream size {}x{} exceeds '{}' capabilities",
+              hints.width, hints.height, backendName);
+    m_session.reset();
+    return false;
+  }
+
+  stream.struct_size = sizeof(stream);
+  stream.codec = codec;
+  stream.codec_profile = hints.profile;
+  stream.codec_level = hints.level;
+  stream.width = hints.width;
+  stream.height = hints.height;
+  stream.frame_rate.numerator = hints.fpsrate;
+  stream.frame_rate.denominator = hints.fpsscale;
+  stream.pixel_aspect.numerator = 1;
+  stream.pixel_aspect.denominator = 1;
+  stream.flags = streamFlags;
+  stream.extra_data = extraData;
+  stream.extra_data_size = extraDataSize;
+  clock.struct_size = sizeof(clock);
+  clock.initial_pts_90k = STBP_PTS_NONE;
+  clock.kodi_is_clock_master = 1;
+
+  const enum stbp_result openResult = m_session->Open(stream, clock);
+  if (openResult != STBP_OK)
+  {
+    CLog::Log(LOGWARNING, "CDVDVideoCodecSTB: opening '{}' failed: {}", backendName,
+              stbp_result_string(openResult));
+    m_session.reset();
+    return false;
+  }
+
+  static std::once_flag rendererRegistration;
+  std::call_once(rendererRegistration, [] { CRendererSTB::Register(); });
+
+  m_hints = hints;
+  m_bufferPool = std::make_shared<CVideoBufferPoolSTB>(m_session);
+  m_defaultDuration = hints.fpsrate > 0 && hints.fpsscale > 0
+                          ? static_cast<double>(DVD_TIME_BASE) * hints.fpsscale / hints.fpsrate
+                          : 0.0;
+  m_name = "stbplayer/" + m_session->BackendName();
+  m_feedAheadPictures = m_session->BackendName() == "dream-aml" ? 48U : 0U;
+  m_processInfo.SetVideoDecoderName(m_name, true);
+  m_processInfo.SetVideoDimensions(hints.width, hints.height);
+  m_processInfo.SetVideoFps(hints.fpsrate > 0 && hints.fpsscale > 0
+                                ? static_cast<float>(hints.fpsrate) / hints.fpsscale
+                                : 0.0f);
+  m_processInfo.SetVideoDAR(hints.aspect > 0.0 ? static_cast<float>(hints.aspect)
+                                               : static_cast<float>(hints.width) / hints.height);
+  m_processInfo.SetVideoInterlaced(hints.interlaced);
+  m_open = true;
+  m_failed = false;
+  CLog::Log(LOGINFO, "CDVDVideoCodecSTB: using backend '{}' for codec {}", m_session->BackendName(),
+            static_cast<int>(codec));
+  return true;
+}
+
+bool CDVDVideoCodecSTB::AddData(const DemuxPacket& packet)
+{
+  struct stbp_buffer_state bufferState{};
+  struct stbp_packet backendPacket{};
+  const uint8_t* data = packet.pData;
+  int size = packet.iSize;
+  double pts = m_hints.ptsinvalid ? DVD_NOPTS_VALUE : packet.pts;
+  enum stbp_result result;
+
+  if (!m_open)
+    return false;
+  if (m_failed)
+    return true;
+  if (packet.iSize < 0 || (packet.pData == nullptr && packet.iSize != 0))
+  {
+    CLog::Log(LOGERROR, "CDVDVideoCodecSTB: invalid demux packet");
+    m_failed = true;
+    return true;
+  }
+  if (packet.iSize == 0)
+    return true;
+  bufferState.struct_size = sizeof(bufferState);
+  result = m_session->GetBufferState(bufferState);
+  if (result == STBP_AGAIN || (result == STBP_OK && !bufferState.can_accept_packet))
+    return false;
+  if (result != STBP_OK)
+  {
+    CLog::Log(LOGERROR, "CDVDVideoCodecSTB: buffer state failed: {}",
+              stbp_result_string(result));
+    m_failed = true;
+    return true;
+  }
+
+  if (m_bitstream && packet.iSize > 0)
+  {
+    if (!m_bitstream->Convert(packet.pData, packet.iSize))
+    {
+      CLog::Log(LOGERROR, "CDVDVideoCodecSTB: bitstream conversion failed");
+      m_failed = true;
+      return true;
+    }
+    data = m_bitstream->GetConvertBuffer();
+    size = m_bitstream->GetConvertSize();
+  }
+  if (pts == DVD_NOPTS_VALUE)
+    pts = packet.dts;
+
+  backendPacket.struct_size = sizeof(backendPacket);
+  backendPacket.data = data;
+  backendPacket.size = static_cast<size_t>(size);
+  backendPacket.pts_90k = To90k(pts);
+  backendPacket.dts_90k = To90k(packet.dts);
+  backendPacket.duration_90k = To90k(packet.duration);
+  if (packet.recoveryPoint)
+    backendPacket.flags |= STBP_PACKET_KEYFRAME;
+  if (m_codecControl & DVD_CODEC_CTRL_DROP)
+    backendPacket.flags |= STBP_PACKET_DROP;
+  if (!m_processInfo.IsAudioStreamActive())
+    backendPacket.flags |= STBP_PACKET_VIDEO_ONLY;
+
+  result = m_session->QueuePacket(backendPacket);
+  if (result == STBP_AGAIN)
+    return false;
+  if (result != STBP_OK)
+  {
+    CLog::Log(LOGERROR, "CDVDVideoCodecSTB: queue failed: {}", stbp_result_string(result));
+    m_failed = true;
+    return true;
+  }
+
+  if ((backendPacket.flags & STBP_PACKET_DROP) == 0)
+  {
+    m_pictures.push_back({pts, packet.dts,
+                          packet.duration > 0.0 ? packet.duration : m_defaultDuration, false});
+  }
+  if (backendPacket.pts_90k != STBP_PTS_NONE)
+    m_lastSubmittedPts90k = backendPacket.pts_90k;
+  m_drainStarted = false;
+  return true;
+}
+
+void CDVDVideoCodecSTB::Reset()
+{
+  if (!m_open)
+    return;
+  const enum stbp_result result = m_session->Flush(STBP_PTS_NONE);
+  if (result != STBP_OK)
+  {
+    CLog::Log(LOGWARNING, "CDVDVideoCodecSTB: flush failed: {}", stbp_result_string(result));
+    m_failed = true;
+  }
+  else
+    m_failed = false;
+  m_pictures.clear();
+  m_lastSubmittedPts90k = STBP_PTS_NONE;
+  m_drainStarted = false;
+  m_firstPictureOutput = false;
+  if (m_bitstream)
+    m_bitstream->ResetStartDecode();
+}
+
+CDVDVideoCodec::VCReturn CDVDVideoCodecSTB::GetPicture(VideoPicture* picture)
+{
+  if (!m_open || picture == nullptr)
+    return VC_ERROR;
+  if (m_failed)
+    return VC_ERROR;
+  if (!m_pictures.empty())
+  {
+    if (m_firstPictureOutput && m_feedAheadPictures != 0U &&
+        (m_codecControl & DVD_CODEC_CTRL_DRAIN) == 0 &&
+        m_pictures.size() <= m_feedAheadPictures)
+    {
+      struct stbp_buffer_state state{};
+      state.struct_size = sizeof(state);
+      if (m_session->GetBufferState(state) == STBP_OK && state.can_accept_packet)
+        return VC_BUFFER;
+    }
+    const PictureInfo info = m_pictures.front();
+    m_pictures.pop_front();
+    picture->Reset();
+    picture->pts = info.pts;
+    picture->dts = info.dts;
+    picture->iDuration = info.duration;
+    picture->iFlags = info.dropped ? DVP_FLAG_DROPPED : 0;
+    if (m_hints.interlaced)
+      picture->iFlags |= DVP_FLAG_INTERLACED;
+    picture->iWidth = m_hints.width;
+    picture->iHeight = m_hints.height;
+    picture->iDisplayHeight = m_hints.height;
+    picture->iDisplayWidth = m_hints.aspect > 0.0
+                                 ? static_cast<unsigned int>(std::round(m_hints.height * m_hints.aspect))
+                                 : m_hints.width;
+    picture->pixelFormat = AV_PIX_FMT_NONE;
+    picture->color_space = m_hints.colorSpace;
+    picture->color_range = m_hints.colorRange == AVCOL_RANGE_JPEG ? 1 : 0;
+    picture->color_primaries = m_hints.colorPrimaries;
+    picture->m_originalColorPrimaries = m_hints.colorPrimaries;
+    picture->color_transfer = m_hints.colorTransferCharacteristic;
+    picture->colorBits = std::max(m_hints.bitdepth, 8);
+    picture->stereoMode = m_hints.stereo_mode;
+    picture->hdrType = m_hints.hdrType;
+    if (m_hints.masteringMetadata)
+    {
+      picture->hasDisplayMetadata = true;
+      picture->displayMetadata = *m_hints.masteringMetadata;
+    }
+    if (m_hints.contentLightMetadata)
+    {
+      picture->hasLightMetadata = true;
+      picture->lightMetadata = *m_hints.contentLightMetadata;
+    }
+    picture->videoBuffer = m_bufferPool->Get();
+    m_firstPictureOutput = true;
+    return VC_PICTURE;
+  }
+
+  if (m_codecControl & DVD_CODEC_CTRL_DRAIN)
+  {
+    if (!m_drainStarted)
+    {
+      const enum stbp_result result = m_session->Drain();
+      if (result != STBP_ERROR_UNSUPPORTED && result != STBP_OK && result != STBP_AGAIN)
+        return VC_ERROR;
+      m_drainStarted = true;
+    }
+    struct stbp_buffer_state state{};
+    state.struct_size = sizeof(state);
+    if (m_session->GetBufferState(state) == STBP_OK && state.queued_bytes == 0)
+      return VC_EOF;
+    return VC_NONE;
+  }
+
+  struct stbp_buffer_state state{};
+  state.struct_size = sizeof(state);
+  if (m_session->GetBufferState(state) == STBP_OK && state.can_accept_packet)
+    return VC_BUFFER;
+  return VC_NONE;
+}
+
+void CDVDVideoCodecSTB::SetSpeed(int speed)
+{
+  if (!m_open)
+    return;
+  if (speed == DVD_PLAYSPEED_PAUSE)
+  {
+    (void)m_session->SetPaused(true);
+    return;
+  }
+  (void)m_session->SetPaused(false);
+  struct stbp_rational rate{speed, DVD_PLAYSPEED_NORMAL};
+  const enum stbp_result result = m_session->SetSpeed(rate);
+  if (result != STBP_OK && result != STBP_ERROR_UNSUPPORTED)
+    CLog::Log(LOGWARNING, "CDVDVideoCodecSTB: speed change failed: {}", stbp_result_string(result));
+}
+
+bool CDVDVideoCodecSTB::GetCodecStats(double& pts, int& droppedFrames, int& skippedPics)
+{
+  struct stbp_status status{};
+  status.struct_size = sizeof(status);
+  if (!m_open || m_session->GetStatus(status) != STBP_OK)
+    return false;
+  pts = From90k(status.presentation_pts_90k);
+  droppedFrames = status.packets_dropped > static_cast<uint64_t>(std::numeric_limits<int>::max())
+                      ? std::numeric_limits<int>::max()
+                      : static_cast<int>(status.packets_dropped);
+  skippedPics = -1;
+  return pts != DVD_NOPTS_VALUE;
+}
