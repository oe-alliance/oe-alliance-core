diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/STBVideoSession.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/STBVideoSession.cpp
new file mode 100644
index 0000000000..18f47360cd
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/STBVideoSession.cpp
@@ -0,0 +1,228 @@
+/*
+ *  Copyright (C) 2026 OE-Alliance contributors
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "STBVideoSession.h"
+
+#include "utils/log.h"
+
+#include <chrono>
+#include <utility>
+
+CSTBVideoSession::~CSTBVideoSession()
+{
+  Close();
+}
+
+bool CSTBVideoSession::Load(const std::string& backendName, std::string& error)
+{
+  char loaderError[512]{};
+  struct stbp_host_callbacks host{};
+  enum stbp_result result;
+
+  std::unique_lock lock(m_mutex);
+  if (m_loaded != nullptr)
+  {
+    error = "backend already loaded";
+    return false;
+  }
+
+  result = stbp_backend_load(nullptr, backendName.c_str(), &m_loaded, loaderError,
+                             sizeof(loaderError));
+  if (result != STBP_OK)
+  {
+    error = loaderError;
+    return false;
+  }
+
+  m_api = stbp_backend_api(m_loaded);
+  host.struct_size = sizeof(host);
+  host.userdata = this;
+  host.log = Log;
+  host.monotonic_time_us = MonotonicTimeUs;
+  result = m_api->create(&host, &m_instance);
+  if (result != STBP_OK)
+  {
+    error = stbp_result_string(result);
+    stbp_backend_unload(m_loaded);
+    m_loaded = nullptr;
+    m_api = nullptr;
+    return false;
+  }
+
+  m_capabilities.struct_size = sizeof(m_capabilities);
+  result = m_api->probe(m_instance, &m_capabilities);
+  if (result != STBP_OK)
+  {
+    error = stbp_result_string(result);
+    m_api->destroy(m_instance);
+    m_instance = nullptr;
+    stbp_backend_unload(m_loaded);
+    m_loaded = nullptr;
+    m_api = nullptr;
+    return false;
+  }
+
+  m_backendName = m_api->backend_name;
+  return true;
+}
+
+enum stbp_result CSTBVideoSession::Open(const struct stbp_stream_config& stream,
+                                        const struct stbp_clock_config& clock)
+{
+  std::unique_lock lock(m_mutex);
+  if (m_api == nullptr || m_instance == nullptr || m_open)
+    return STBP_ERROR_BAD_STATE;
+  const enum stbp_result result = m_api->open(m_instance, &stream, &clock);
+  m_open = result == STBP_OK;
+  return result;
+}
+
+enum stbp_result CSTBVideoSession::QueuePacket(const struct stbp_packet& packet)
+{
+  std::unique_lock lock(m_mutex);
+  return m_open ? m_api->queue_packet(m_instance, &packet) : STBP_ERROR_BAD_STATE;
+}
+
+enum stbp_result CSTBVideoSession::GetBufferState(struct stbp_buffer_state& state)
+{
+  std::unique_lock lock(m_mutex);
+  return m_open ? m_api->get_buffer_state(m_instance, &state) : STBP_ERROR_BAD_STATE;
+}
+
+enum stbp_result CSTBVideoSession::GetStatus(struct stbp_status& status)
+{
+  std::unique_lock lock(m_mutex);
+  return m_open ? m_api->get_status(m_instance, &status) : STBP_ERROR_BAD_STATE;
+}
+
+enum stbp_result CSTBVideoSession::Flush(int64_t nextPts90k)
+{
+  std::unique_lock lock(m_mutex);
+  return m_open ? m_api->flush(m_instance, nextPts90k) : STBP_ERROR_BAD_STATE;
+}
+
+enum stbp_result CSTBVideoSession::Drain()
+{
+  std::unique_lock lock(m_mutex);
+  return m_open ? m_api->drain(m_instance) : STBP_ERROR_BAD_STATE;
+}
+
+enum stbp_result CSTBVideoSession::SetSpeed(struct stbp_rational speed)
+{
+  std::unique_lock lock(m_mutex);
+  return m_open ? m_api->set_speed(m_instance, speed) : STBP_ERROR_BAD_STATE;
+}
+
+enum stbp_result CSTBVideoSession::SetPaused(bool paused)
+{
+  std::unique_lock lock(m_mutex);
+  return m_open ? m_api->set_paused(m_instance, paused ? 1 : 0) : STBP_ERROR_BAD_STATE;
+}
+
+enum stbp_result CSTBVideoSession::SetVideoRect(const struct stbp_rect& source,
+                                                const struct stbp_rect& destination)
+{
+  std::unique_lock lock(m_mutex);
+  if (!m_open)
+    return STBP_ERROR_BAD_STATE;
+  if ((m_capabilities.feature_mask & STBP_FEATURE_VIDEO_RECT) == 0)
+    return STBP_ERROR_UNSUPPORTED;
+  return m_api->set_video_rect(m_instance, &source, &destination);
+}
+
+enum stbp_result CSTBVideoSession::SetVisible(bool visible)
+{
+  std::unique_lock lock(m_mutex);
+  if (!m_open)
+    return STBP_ERROR_BAD_STATE;
+  if ((m_capabilities.feature_mask & STBP_FEATURE_VISIBILITY) == 0)
+    return STBP_ERROR_UNSUPPORTED;
+  return m_api->set_visible(m_instance, visible ? 1 : 0);
+}
+
+bool CSTBVideoSession::Supports(uint64_t feature) const
+{
+  std::unique_lock lock(m_mutex);
+  return (m_capabilities.feature_mask & feature) != 0;
+}
+
+void CSTBVideoSession::CloseLocked()
+{
+  if (m_api != nullptr && m_instance != nullptr)
+  {
+    if (m_open)
+      (void)m_api->close(m_instance);
+    m_api->destroy(m_instance);
+    m_instance = nullptr;
+  }
+  if (m_loaded != nullptr)
+    stbp_backend_unload(m_loaded);
+  m_loaded = nullptr;
+  m_api = nullptr;
+  m_open = false;
+  m_backendName.clear();
+  m_capabilities = {};
+}
+
+void CSTBVideoSession::Close()
+{
+  std::unique_lock lock(m_mutex);
+  CloseLocked();
+}
+
+void CSTBVideoSession::Log(void* userdata, enum stbp_log_level level, const char* message)
+{
+  (void)userdata;
+  int kodiLevel = LOGDEBUG;
+  if (level == STBP_LOG_ERROR)
+    kodiLevel = LOGERROR;
+  else if (level == STBP_LOG_WARNING)
+    kodiLevel = LOGWARNING;
+  else if (level == STBP_LOG_INFO)
+    kodiLevel = LOGINFO;
+  CLog::Log(kodiLevel, "stbplayer: {}", message != nullptr ? message : "");
+}
+
+int64_t CSTBVideoSession::MonotonicTimeUs(void* userdata)
+{
+  (void)userdata;
+  const auto now = std::chrono::steady_clock::now().time_since_epoch();
+  return std::chrono::duration_cast<std::chrono::microseconds>(now).count();
+}
+
+CVideoBufferSTB::CVideoBufferSTB(int id, std::shared_ptr<CSTBVideoSession> session)
+  : CVideoBuffer(id), m_session(std::move(session))
+{
+}
+
+CVideoBufferPoolSTB::CVideoBufferPoolSTB(std::shared_ptr<CSTBVideoSession> session)
+  : m_session(std::move(session))
+{
+}
+
+CVideoBuffer* CVideoBufferPoolSTB::Get()
+{
+  std::unique_lock lock(m_mutex);
+  int id;
+  if (m_free.empty())
+  {
+    id = static_cast<int>(m_buffers.size());
+    m_buffers.emplace_back(std::make_unique<CVideoBufferSTB>(id, m_session));
+  }
+  else
+  {
+    id = m_free.front();
+    m_free.pop_front();
+  }
+  m_buffers[id]->Acquire(GetPtr());
+  return m_buffers[id].get();
+}
+
+void CVideoBufferPoolSTB::Return(int id)
+{
+  std::unique_lock lock(m_mutex);
+  if (id >= 0 && static_cast<size_t>(id) < m_buffers.size())
+    m_free.push_back(id);
+}
