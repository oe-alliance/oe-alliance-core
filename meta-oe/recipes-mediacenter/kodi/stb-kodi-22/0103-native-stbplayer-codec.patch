+
+CRendererSTB::~CRendererSTB()
+{
+  UnInit();
+}
+
+CBaseRenderer* CRendererSTB::Create(CVideoBuffer* buffer)
+{
+  return dynamic_cast<CVideoBufferSTB*>(buffer) != nullptr ? new CRendererSTB() : nullptr;
+}
+
+void CRendererSTB::Register()
+{
+  VIDEOPLAYER::CRendererFactory::RegisterRenderer("stbplayer", CRendererSTB::Create);
+}
+
+bool CRendererSTB::Configure(const VideoPicture& picture, float fps, unsigned int orientation)
+{
+  auto* buffer = dynamic_cast<CVideoBufferSTB*>(picture.videoBuffer);
+  if (buffer == nullptr)
+    return false;
+  m_session = buffer->Session();
+  m_format = AV_PIX_FMT_NONE;
+  m_sourceWidth = picture.iWidth;
+  m_sourceHeight = picture.iHeight;
+  m_displayWidth = picture.iDisplayWidth;
+  m_displayHeight = picture.iDisplayHeight;
+  m_renderOrientation = orientation;
+  m_fps = fps;
+  m_iFlags = GetFlagsChromaPosition(picture.chroma_position) |
+             GetFlagsColorMatrix(picture.color_space, picture.iWidth, picture.iHeight) |
+             GetFlagsColorPrimaries(picture.color_primaries) |
+             GetFlagsStereoMode(picture.stereoMode);
+  CalculateFrameAspectRatio(picture.iDisplayWidth, picture.iDisplayHeight);
+  SetViewMode(m_videoSettings.m_ViewMode);
+  ManageRenderArea();
+  (void)m_session->SetVisible(true);
+  m_configured = true;
+  return true;
+}
+
+void CRendererSTB::AddVideoPicture(const VideoPicture& picture, int index)
+{
+  if (index < 0 || static_cast<size_t>(index) >= m_buffers.size())
+    return;
+  ReleaseBuffer(index);
+  auto* buffer = dynamic_cast<CVideoBufferSTB*>(picture.videoBuffer);
+  if (buffer != nullptr)
+  {
+    buffer->Acquire();
+    m_buffers[index] = buffer;
+    m_session = buffer->Session();
+  }
+}
+
+void CRendererSTB::UnInit()
+{
+  for (size_t index = 0; index < m_buffers.size(); ++index)
+    ReleaseBuffer(static_cast<int>(index));
+  if (m_session)
+    (void)m_session->SetVisible(false);
+  m_session.reset();
+  m_configured = false;
+}
+
+bool CRendererSTB::Flush(bool saveBuffers)
+{
+  if (!saveBuffers)
+  {
+    for (size_t index = 0; index < m_buffers.size(); ++index)
+      ReleaseBuffer(static_cast<int>(index));
+  }
+  return saveBuffers;
+}
+
+void CRendererSTB::ReleaseBuffer(int index)
+{
+  if (index < 0 || static_cast<size_t>(index) >= m_buffers.size())
+    return;
+  if (m_buffers[index] != nullptr)
+  {
+    m_buffers[index]->Release();
+    m_buffers[index] = nullptr;
+  }
+}
+
+CRenderInfo CRendererSTB::GetRenderInfo()
+{
+  CRenderInfo info;
+  info.max_buffer_size = 4;
+  info.formats.push_back(AV_PIX_FMT_NONE);
+  return info;
+}
+
+void CRendererSTB::Update()
+{
+}
+
+void CRendererSTB::RenderUpdate(int index,
+                                int index2,
+                                bool clear,
+                                unsigned int flags,
+                                unsigned int alpha)
+{
+  (void)index;
+  (void)index2;
+  (void)clear;
+  (void)flags;
+  (void)alpha;
+  if (m_configured)
+    ManageRenderArea();
+}
+
+bool CRendererSTB::ConfigChanged(const VideoPicture& picture)
+{
+  const auto* buffer = dynamic_cast<CVideoBufferSTB*>(picture.videoBuffer);
+  return buffer == nullptr || buffer->Session() != m_session || picture.iWidth != m_sourceWidth ||
+         picture.iHeight != m_sourceHeight || picture.iDisplayWidth != m_displayWidth ||
+         picture.iDisplayHeight != m_displayHeight;
+}
+
+bool CRendererSTB::Supports(ERENDERFEATURE feature) const
+{
+  if (!m_session || !m_session->Supports(STBP_FEATURE_VIDEO_RECT))
+    return false;
+  return feature == RENDERFEATURE_ZOOM || feature == RENDERFEATURE_STRETCH ||
+         feature == RENDERFEATURE_PIXEL_RATIO || feature == RENDERFEATURE_VERTICAL_SHIFT;
+}
+
+void CRendererSTB::ManageRenderArea()
+{
+  CBaseRenderer::ManageRenderArea();
+  if (!m_session || !m_session->Supports(STBP_FEATURE_VIDEO_RECT) || m_sourceRect.IsEmpty() ||
+      m_destRect.IsEmpty())
+    return;
+  if (m_sourceRect == m_appliedSource && m_destRect == m_appliedDestination)
+    return;
+
+  const struct stbp_rect source{static_cast<int32_t>(std::lround(m_sourceRect.x1)),
+                                static_cast<int32_t>(std::lround(m_sourceRect.y1)),
+                                static_cast<int32_t>(std::lround(m_sourceRect.Width())),
+                                static_cast<int32_t>(std::lround(m_sourceRect.Height()))};
+  const struct stbp_rect destination{static_cast<int32_t>(std::lround(m_destRect.x1)),
+                                     static_cast<int32_t>(std::lround(m_destRect.y1)),
+                                     static_cast<int32_t>(std::lround(m_destRect.Width())),
+                                     static_cast<int32_t>(std::lround(m_destRect.Height()))};
+  if (m_session->SetVideoRect(source, destination) == STBP_OK)
+  {
+    m_appliedSource = m_sourceRect;
+    m_appliedDestination = m_destRect;
+  }
+}
