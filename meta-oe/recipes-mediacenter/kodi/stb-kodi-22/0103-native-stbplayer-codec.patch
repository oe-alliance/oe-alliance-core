+#.rst:
+# FindStbplayer
+# -------------
+# Finds the versioned STB hardware-video backend loader.
+#
+# This defines the following target:
+#
+#   ${APP_NAME_LC}::Stbplayer - The libstbplayer loader library
+
+if(NOT TARGET ${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME})
+  find_path(STBPLAYER_INCLUDE_DIR NAMES stbplayer/loader.h)
+  find_library(STBPLAYER_LIBRARY NAMES stbplayer)
+
+  if(NOT VERBOSE_FIND)
+    set(${CMAKE_FIND_PACKAGE_NAME}_FIND_QUIETLY TRUE)
+  endif()
+
+  include(FindPackageHandleStandardArgs)
+  find_package_handle_standard_args(Stbplayer
+                                    REQUIRED_VARS STBPLAYER_LIBRARY STBPLAYER_INCLUDE_DIR)
+
+  if(Stbplayer_FOUND)
+    add_library(${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME} UNKNOWN IMPORTED)
+    set_target_properties(${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME} PROPERTIES
+      IMPORTED_LOCATION "${STBPLAYER_LIBRARY}"
+      INTERFACE_INCLUDE_DIRECTORIES "${STBPLAYER_INCLUDE_DIR}"
+      INTERFACE_COMPILE_DEFINITIONS "HAVE_STBPLAYER")
+  endif()
+endif()
