+    "mjpeg",
+    eVideo,
+    "V_MJPEG",
+    VIDEO_ENCODING_AUTO,
+    STREAMTYPE_MJPEG,
+    -1
+};
+
+struct Writer_s WriterVideoMJPEG = {
+    &reset,
+    &writeData,
+    NULL,
+    &caps
+};
+
