+
+bool CDvbVdec::OpenDecoder(CDVDStreamInfo& hints)
+{
+  m_mode = VIDEO_MODE_NORMAL;
+  m_zoom = -1;
+  m_contrast = -1;
+  m_brightness = -1;
+  m_hints = hints;
+  m_extraneed = true;
+
+  m_dst_rect.SetRect(0, 0, 0, 0);
+
+  CLog::Log(LOGDEBUG, "CDvbVdec::OpenDecoder in, Param:\n");
+  CLog::Log(LOGDEBUG, "\t|codec        : {}", hints.codec);
+  CLog::Log(LOGDEBUG, "\t|type         : {}", hints.type);
+  CLog::Log(LOGDEBUG, "\t|uniqueId     : {}", hints.uniqueId);
+  CLog::Log(LOGDEBUG, "\t|filename     : {}", hints.filename);
+  CLog::Log(LOGDEBUG, "\t|flags        : {}", hints.flags);
+  CLog::Log(LOGDEBUG, "\t|dvd          : {}", hints.dvd);
+  CLog::Log(LOGDEBUG, "\t|fpsscale     : {}", hints.fpsscale);
+  CLog::Log(LOGDEBUG, "\t|fpsrate      : {}", hints.fpsrate);
+  CLog::Log(LOGDEBUG, "\t|vfr          : {}", hints.vfr);
+  CLog::Log(LOGDEBUG, "\t|stills       : {}", hints.stills);
+  CLog::Log(LOGDEBUG, "\t|height       : {}", hints.height);
+  CLog::Log(LOGDEBUG, "\t|width        : {}", hints.width);
+  CLog::Log(LOGDEBUG, "\t|aspect       : {:f}", hints.aspect);
+  CLog::Log(LOGDEBUG, "\t|level        : {}", hints.level);
+  CLog::Log(LOGDEBUG, "\t|profile      : {}", hints.profile);
+  CLog::Log(LOGDEBUG, "\t|ptsinvalid   : {}", hints.ptsinvalid);
+  CLog::Log(LOGDEBUG, "\t|orientation  : {}", hints.orientation);
+  CLog::Log(LOGDEBUG, "\t|bitsperpixel : {}", hints.bitsperpixel);
+
+  m_extradata = (unsigned char*)malloc(hints.extradata.GetSize());
+  m_extrasize = hints.extradata.GetSize();
+  memcpy(m_extradata, hints.extradata.GetData(), m_extrasize);
+
+  CLog::Log(LOGINFO, "CDvbVdec::OpenDecoder extra size %d", m_extrasize);
+
+  // handle video rate
+  if (hints.fpsrate > 0 && hints.fpsscale != 0)
+  {
+    // then ffmpeg avg_frame_rate next
+    m_video_rate = 0.5f + (float)UNIT_FREQ * hints.fpsscale / hints.fpsrate;
+  }
+
+  // check for 1920x1080, interlaced, 25 fps
+  // incorrectly reported as 50 fps (yes, video_rate == 1920)
+  if (hints.width == 1920 && m_video_rate == 1920)
+  {
+    //CLog::Log(LOGINFO, "CDvbVdec::OpenDecoder video_rate exception");
+    m_video_rate = 0.5f + (float)UNIT_FREQ * 1001 / 25000;
+  }
+
+  // check for SD h264 content incorrectly reported as 60 fsp
+  // mp4/avi containers :(
+  if (hints.codec == AV_CODEC_ID_H264 && hints.width <= 720 && m_video_rate == 1602)
+  {
+    //CLog::Log(LOGINFO, "CDvbVdec::OpenDecoder video_rate exception");
+    m_video_rate = 0.5f + (float)UNIT_FREQ * 1001 / 24000;
+  }
+
+  // check for SD h264 content incorrectly reported as some form of 30 fsp
+  // mp4/avi containers :(
+  if (hints.codec == AV_CODEC_ID_H264 && hints.width <= 720)
+  {
+    if (m_video_rate >= 3200 && m_video_rate <= 3210)
+    {
+      //CLog::Log(LOGINFO, "CDvbVdec::OpenDecoder video_rate exception");
+      m_video_rate = 0.5f + (float)UNIT_FREQ * 1001 / 24000;
+    }
+  }
+
+  if (hwDec->VideoOpen(hints) == false)
+  {
+    CLog::Log(LOGINFO,"OpenVideo return falied");
+    return false;
+  }
+
+  CLog::Log(LOGINFO,"OpenDecoder success");
+
+  Create();
+
+  m_opened = true;
+
+  return m_opened;
+}
+
+void CDvbVdec::CloseDecoder()
+{
+  m_opened = false;
+
+  StopThread();
+
+  hwDec->VideoClose();
+
+  SAFE_DELETE(m_extradata);
+  SAFE_DELETE(m_header);
+
+}
+
+void CDvbVdec::Reset()
+{
+
+  if (!m_opened)
+    return;
+
+  m_extraneed = true;
+
+  m_ptsQueue.clear();
+  hwDec->VideoReset();
+}
+
+void CDvbVdec::ReSync(double pts)
+{
+
+  if (!m_opened)
+    return;
+
+  pts = pts < 0 ? 0.0 : pts;
+
+  m_extraneed = true;
+
+  m_ptsQueue.clear();
+  hwDec->VideoReSync(pts);
+}
+CDVDVideoCodec::VCReturn CDvbVdec::Decode(
+    uint8_t* pData, size_t iSize, double dts, double pts, std::atomic_bool& abort)
+{
+  if (!m_opened)
+    return CDVDVideoCodec::VC_ERROR;
+
+  unsigned int package_pts_ms = 0;
+  unsigned int package_dts_ms = 0;
+
+
+  if (pData)
+  {
+    package_dts_ms = (dts == DVD_NOPTS_VALUE) ? AV_NOPTS_VALUE : dts;
+    package_pts_ms = (pts == DVD_NOPTS_VALUE) ? AV_NOPTS_VALUE : pts;
+
+    if (pts == DVD_NOPTS_VALUE && dts != DVD_NOPTS_VALUE)
+    {
+      package_pts_ms = package_dts_ms;
+    }
+
+    while (m_opened && !abort)
+    {
+      if (hwDec->VideoBufferFull())
+      {
+        KODI::TIME::Sleep(10ms);
+        continue;
+      }
+
+        bool ret;
+        if (m_extraneed)
+           ret = hwDec->VideoWrite(pData, iSize, package_pts_ms,m_hints.extradata.GetData(),m_hints.extradata.GetSize());
+        else
+           ret = hwDec->VideoWrite(pData, iSize, package_pts_ms,NULL,0);
+        if (!ret)
+        {
+          KODI::TIME::Sleep(10ms);
+          continue;
+        }
+
+      break;
+    }
+  }
+
+  // if we have still frames, demux size will be small
+  // and we need to pre-buffer more.
+
+  CDVDVideoCodec::VCReturn rtn = CDVDVideoCodec::VC_NONE;
+  // keep hw buffered demux above 1 second
+  if (!hwDec->VideoBufferFull())
+    rtn = CDVDVideoCodec::VC_BUFFER;
+
+  // wait until we get a new frame or 25ms,
+  if (m_ptsQueue.size() == 0)
+    m_ready_event.Wait(25ms);
+
+  if (m_ptsQueue.size() > 0)
+  {
+    CSingleExit lock(m_ptsQueueMutex);
+    m_ptsQueue.pop_front();
+    rtn = CDVDVideoCodec::VC_PICTURE;
+  }
+
+  return rtn;
+}
+
+bool CDvbVdec::GetFramePts(double& pts)
+{
+  return hwDec->VideoFramePts(pts);
+}
+
+bool CDvbVdec::PlayStarted()
+{
+  return hwDec->VideoPlayStarted();
+}
+
+bool CDvbVdec::BufferFull()
+{
+  return hwDec->VideoBufferFull();
+}
+
+bool CDvbVdec::BufferReady()
+{
+  return hwDec->VideoBufferReady();
+}
+
+double CDvbVdec::FirstPts()
+{
+  return hwDec->VideoFirstPts();
+}
+
+double CDvbVdec::GetCurrentPts()
+{
+  return hwDec->GetPicturePts();
+
+}
+
+
+bool CDvbVdec::GetPicture(VideoPicture* pDvdVideoPicture)
+{
+  if (!m_opened)
+    return false;
+
+  pDvdVideoPicture->iDuration = (double)(m_video_rate * DVD_TIME_BASE) / UNIT_FREQ;
+  pDvdVideoPicture->dts = DVD_NOPTS_VALUE;
+  pDvdVideoPicture->pts = hwDec->VideoCurrentPts();
+
+  return true;
+}
+
+void CDvbVdec::SetSpeed(int speed)
+{
+  if (!m_opened)
+  {
+    return;
+  }
+
+  hwDec->VideoSetSpeed(speed);
+}
+
+int CDvbVdec::GetDataSize()
+{
+  return 0;
+}
+
+double CDvbVdec::GetTimeSize()
+{
+  return 0;
+}
+
+void CDvbVdec::Process()
+{
+
+  while (!m_bStop)
+  {
+    KODI::TIME::Sleep(10ms);
+    {
+      CSingleExit lock(m_ptsQueueMutex);
+      double pts = 0;
+      if (GetFramePts(pts))
+      {
+        m_ptsQueue.push_back(pts);
+        m_ready_event.Set();
+      }
+    CServiceBroker::GetGUI()->GetWindowManager().MarkDirty();
+    }
+  }
+
+}
+
+void CDvbVdec::SetFreeRun(const bool freerun)
+{
+}
+
+void CDvbVdec::SubmitEos()
+{
+  hwDec->VideoSubmitEOS();
+}
+
+bool CDvbVdec::EOS()
+{
+  return hwDec->IsEOS();
+}
+
+void CDvbVdec::SetVideoRect(const CRect& SrcRect, const CRect& DestRect)
+{
+}
