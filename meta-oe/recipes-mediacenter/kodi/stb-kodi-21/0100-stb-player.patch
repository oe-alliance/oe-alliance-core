+  CLog::Log(LOGINFO, "=======================================================\n");                 \
+  CLog::Log(LOGINFO, "FROM LINE: {} TO LINE: {} COST: {} us = {} ms\n", line_start, __LINE__,      \
+            time_cost, time_cost / 1000);                                                          \
+  CLog::Log(LOGINFO, "=======================================================\n")
