+bool DvbAvDecoder::VideoOpen(CDVDStreamInfo& hints)
+{
+   Init();
+
+   if (m_video_opend)
+    VideoClose();
+
+   CSingleExit lock(m_section);
+
+   char *codec = getcodecname(hints.codec);
+
+   CLog::Log(LOGINFO, "Use codec {}  {}",codec,hints.codec);
+
+   avOut.extradata  =  (unsigned char*)malloc(hints.extradata.GetSize()); //  videoTrack->extraData;
+   avOut.extralen   =  hints.extradata.GetSize();// videoTrack->extraSize;
+   avOut.frameRate = 1000 * hints.fpsscale / hints.fpsrate;
+   if (avOut.frameRate < 23970)
+       avOut.timeScale  = 1001;
+   else
+       avOut.timeScale  = 1000;
+   avOut.width      =  hints.width; // videoTrack->width;
+   avOut.height     =  hints.height; //videoTrack->height;
+   avOut.Encoding    = codec;
+
+   if(AV_CODEC_ID_HEVC == hints.codec)
+       avOut.infoFlags = 1;
+
+   CLog::Log(LOGDEBUG, "\t|Framerate : {}",avOut.frameRate);
+   CLog::Log(LOGDEBUG, "\t|Timesca;e : {}",avOut.timeScale);
+   CLog::Log(LOGDEBUG, "\t|Wight : {}",avOut.width);
+   CLog::Log(LOGDEBUG, "\t|Height : {}",avOut.height);
+   CLog::Log(LOGDEBUG, "\t|Codec : {}",avOut.Encoding);
+
+   m_codec = codec;
+
+   DvbOpenVideo();
+   DvbPlayVideo(codec);
+
+
+   m_video_opend = true;
+   m_video_full = false;
+   m_video_eos = false;
+   m_video_1st_pts = DVD_NOPTS_VALUE;
+   m_video_play_started = false;
+   m_video_ready = false;
+   m_vptsQueue.clear();
+
+  return true;
+}
