+bool DvbAvDecoder::VideoBufferFull()
+{
+  return m_video_full;
+}
+
+bool DvbAvDecoder::VideoBufferReady()
+{
+  return m_video_ready;
+}
+
+
+bool DvbAvDecoder::VideoWrite(uint8_t* pData, size_t iSize, double pts_ms,uint8_t* extradata,size_t extralen)
+{
+  double pts;
+  
+  if (pts_ms < m_seekpts)
+     return true;
+
+
+  if (!m_video_opend)
+    return false;
+    
+  avOut.data = pData;
+  avOut.len = iSize;
+
+  if (extralen > 2)
+    {
+      avOut.extralen = extralen;
+      avOut.extradata = extradata;
+    }
+  else
+      avOut.extralen = 0;
+
+  pts_ms = pts_ms * 9LL / 100; 
+ 
+  avOut.pts = pts_ms;
+  avOut.dts = pts_ms;
+
+  if (WriteDvb(&avOut) != 0)
+      {
+      CLog::Log(LOGINFO,"writing data to video device failed");
+      }
+
+  pts = DvbGetPts();
+  pts *= 11.111 ;
+
+  if ((pts) != m_video_1st_pts)
+  {
+
+
+  if (m_vptsQueue.empty()){
+        m_video_1st_pts = pts;
+        }
+      m_vptsQueue.push_back(pts);
+  }
+
+  return true;
+}
+
+
+void DvbAvDecoder::VideoSubmitEOS()
+{
+  if (m_video_eos)
+    return;
+
+  m_video_eos = true;
+  SubmitEOS();
+}
