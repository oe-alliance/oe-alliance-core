+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA 02111-1307 USA
+ *
+ */
+
+/* ***************************** */
+/* Includes                      */
+/* ***************************** */
+
+#include <stdio.h>
+#include <inttypes.h>
+#include <string.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <stdbool.h>
+#include <fcntl.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <sys/ioctl.h>
+#include <linux/dvb/video.h>
+#include <linux/dvb/audio.h>
+#include <memory.h>
+#include <asm/types.h>
+#include <pthread.h>
+#include <errno.h>
+#include <poll.h>
+#include "stm_ioctls.h"
+#include "bcm_ioctls.h"
+#include "writer.h"
+
+
+
+#define cERR_LINUXDVB_NO_ERROR      0
+#define cERR_LINUXDVB_ERROR        -1
+
+static const char VIDEODEV[] = "/dev/dvb/adapter0/video0";
+
+
+static int videofd 	= -1;
+char *codec;
+
+struct DVBApiVideoInfo_s
+{
+    int aspect_ratio;
+    int progressive;
+    int frame_rate;
+    int width, height;
+};
+static struct DVBApiVideoInfo_s videoInfo = {-1,-1,-1,-1,-1};
+
+unsigned long long int sCURRENT_PTS = 0;
+bool isBufferedOutput = false;
+
+static int LinuxDvbMapBypassMode(int bypass, bool primary)
+{
+    if (STB_DREAMBOX == GetSTBType()) {
+        primary = !primary;
+    }
+
+    switch(bypass) {
+        case AUDIOTYPE_RAW:
+            bypass = primary ? 0x30 : 0xf;
+            break;
+        case AUDIOTYPE_AC3_PLUS:
+            bypass = primary ? 0x22 : 7;
+            break;
+        case AUDIOTYPE_WMA:
+            bypass = primary ? 0x20 : 0xd;
+            break;
+        case AUDIOTYPE_WMA_PRO:
+            bypass = primary ? 0x21 : 0xe;
+            break;
+        default:
+            break;
+    };
+
+    return bypass;
+}
+
+static int LinuxDvbMapStreamType(int streamtype, bool primary)
+{
+    if (STB_DREAMBOX == GetSTBType()) {
+        primary = !primary;
+    }
+
+    switch(streamtype) {
+        case STREAMTYPE_MPEG4_H265:
+            streamtype = primary ? 7 : 22;
+            break;
+        case STREAMTYPE_VC1:
+            streamtype = primary ? 3 : 16;
+            break;
+        case STREAMTYPE_VC1_SM:
+            streamtype = primary ? 5 : 17;
+            break;
+        case STREAMTYPE_VB8:
+            streamtype = primary ? 8 : 20;
+            break;
+        case STREAMTYPE_VB9:
+            streamtype = primary ? 9 : 23;
+            break;
+        default:
+            break;
+    };
+
+    return streamtype;
+}
+
+uint64_t DvbGetPts() {
+    int32_t ret = cERR_LINUXDVB_ERROR;
+uint64_t pts;
+    if (videofd > -1 && !ioctl(videofd, VIDEO_GET_PTS, &pts))
+    {
+        ret = cERR_LINUXDVB_NO_ERROR;
+    }
+    else
+    {
+    }
+
+
+    if (ret != cERR_LINUXDVB_NO_ERROR)
+    {
+        sCURRENT_PTS = 0;
+    }
+
+    return pts;
+}
+
+
+
+int DvbOpenVideo()
+{
+
+
+    if (videofd < 0)
+    {
+        videofd = open(VIDEODEV, O_RDWR | O_NONBLOCK);
+
+        if (videofd < 0)
+        {
+            DvbPrintError("Unable to open VIDEODEV");
+            return cERR_LINUXDVB_ERROR;
+        }
+
+        if (ioctl( videofd, VIDEO_CLEAR_BUFFER) == -1)
+        {
+        DvbPrintError("Unable to CLEAR_VIDEO_BUFFER");
+        }
+
+        if (ioctl( videofd, VIDEO_SELECT_SOURCE,VIDEO_SOURCE_MEMORY) == -1)
+
+        {
+        DvbPrintError("Unable to set VIDEO_SOURCE_MEMORY");
+        }
+
+        if (ioctl(videofd, VIDEO_FREEZE) == -1)
+        {
+        DvbPrintError("Unable to FREEZE_VIDEO");
+        }
+
+    }
+    return 0;
+}
+int DvbStopVideo()
+{
+    int ret = cERR_LINUXDVB_NO_ERROR;
+
+
+    if (videofd != -1)
+    {
+        if (ioctl(videofd, VIDEO_CLEAR_BUFFER) == -1)
+        {
+            DvbPrintError("Unable to CLEAR_VIDEO_BUFFER");
+        }
+
+        if (ioctl(videofd, VIDEO_STOP) == -1)
+        {
+            DvbPrintError("Unable to STOP_VIDEO");
+            ret = cERR_LINUXDVB_ERROR;
+        }
+
+        ioctl(videofd, VIDEO_SLOWMOTION, 0);
+        ioctl(videofd, VIDEO_FAST_FORWARD, 0);
+        ioctl(videofd, VIDEO_SELECT_SOURCE, VIDEO_SOURCE_DEMUX);
+    }
+
+    return ret;
+}
+
+
+int DvbCloseVideo()
+{
+
+    DvbStopVideo();
+
+    if (videofd != -1)
+    {
+        close(videofd);
+        videofd = -1;
+    }
+    return cERR_LINUXDVB_NO_ERROR;
+}
+
+int DvbPlayVideo(char *Encoding) {
+    int32_t ret = cERR_LINUXDVB_NO_ERROR;
+    Writer_t *writer;
+codec = Encoding;
+    if (videofd != -1) {
+
+        writer = getWriter(Encoding);
+        if (writer == NULL)
+        {
+            ret = cERR_LINUXDVB_ERROR;
+        }
+        else
+        {
+            ret = ioctl( videofd, VIDEO_SET_STREAMTYPE, LinuxDvbMapStreamType(writer->caps->dvbStreamType, true));
+            if (ret < 0) ret = ioctl( videofd, VIDEO_SET_STREAMTYPE, LinuxDvbMapStreamType(writer->caps->dvbStreamType, false));
+            if (ret < 0)
+            {
+                DvbPrintError("Unable to set VIDEO_STREAM_TYPE");
+                ret = cERR_LINUXDVB_ERROR;
+            }
+        }
+
+        if (0 != ioctl(videofd, VIDEO_PLAY))
+        {
+            DvbPrintError("Unable to PLAY_VIDEO");
+            ret = cERR_LINUXDVB_ERROR;
+        }
+
+        if (ioctl(videofd, VIDEO_CONTINUE) == -1)
+        {
+            DvbPrintError("Unable to CONTINEUE_VIDEO");
+        }
+
+        if (ioctl( videofd, VIDEO_CLEAR_BUFFER) == -1)
+        {
+            DvbPrintError("Unable to CLEAR_BUFFER");
+        }
+    }
+    return ret;
+}
+
+int DvbClearVideo()
+{
+    int32_t ret = cERR_LINUXDVB_NO_ERROR;
+
+
+    if (videofd != -1)
+    {
+      if (ioctl(videofd, VIDEO_CLEAR_BUFFER) == -1)
+         {
+             DvbPrintError("Unable to CLEAR_BUFFER");
+             ret = cERR_LINUXDVB_ERROR;
+         }
+    }
+return ret;
+}
+
+void DvbSpeedVideo(int Speed)
+{
+char str[127];
+sprintf(str, "STBmsg DvbSpeedVideo %d", Speed/1000);
+
+DvbPrintlog(str);
+
+ if (Speed > 1000)
+      {
+        if(ioctl(videofd, VIDEO_FAST_FORWARD, Speed/1000) == -1)
+         {
+         DvbPrintError("failure VIDEO_FAST_FORWARD");
+         }
+      ioctl(videofd, VIDEO_CONTINUE);
+      }
+}
+int DvbPauseVideo() {
+
+    int32_t ret = cERR_LINUXDVB_NO_ERROR;
+
+    if (videofd != -1)
+    {
+        if (ioctl(videofd, VIDEO_FREEZE, NULL) == -1)
+        {
+            DvbPrintError("VIDEO_FREEZE");
+            ret = cERR_LINUXDVB_ERROR;
+        }
+    }
+
+    return ret;
+}
+int DvbRestartVideo()
+{
+        if (ioctl(videofd, VIDEO_CLEAR_BUFFER) == -1)
+        {
+            DvbPrintError("Unable to CLEAR_VIDEO_BUFFER");
+        }
+
+        if (ioctl(videofd, VIDEO_STOP) == -1)
+        {
+            DvbPrintError("Unable to STOP_VIDEO");
+        }
+        ioctl(videofd, VIDEO_SLOWMOTION, 0);
+        ioctl(videofd, VIDEO_FAST_FORWARD, 0);
+        ioctl(videofd, VIDEO_SELECT_SOURCE, VIDEO_SOURCE_MEMORY);
+        DvbPlayVideo(codec);
+
+
+
+}
+
+int DvbFlush()
+{
+    if (videofd != -1)
+    {
+        ioctl(videofd, VIDEO_CLEAR_BUFFER);
+    }
+}
+
+int DvbContinueVideo() {
+    int32_t ret = cERR_LINUXDVB_NO_ERROR;
+
+    if (videofd != -1)
+    {
+        ioctl(videofd, VIDEO_FAST_FORWARD, 0);
+        ioctl(videofd, VIDEO_SLOWMOTION, 0);
+        if (ioctl(videofd, VIDEO_CONTINUE, NULL) == -1)
+        {
+            DvbPrintError("VIDEO_CONTINUE");
+            ret = cERR_LINUXDVB_ERROR;
+        }
+   }
+
+
+    return ret;
+}
+
+
+
+
+
+int WriteDvb(void *_out)
+{
+    char  str[127];
+
+    VideoOut_t    *out      = (VideoOut_t*) _out;
+    int32_t            ret       = cERR_LINUXDVB_NO_ERROR;
+    int32_t            res       = 0;
+    Writer_t           *writer   = NULL;
+    WriterAVCallData_t call;
+
+    if (out == NULL)
+    {
+       return cERR_LINUXDVB_ERROR;
+    }
+
+          writer = getWriter(out->Encoding);
+
+        if (writer == NULL)
+        {
+           sprintf(str,"Could not find correct writer");
+           DvbPrintError(str);
+           writer = getDefaultVideoWriter();
+        }
+
+        if (writer == NULL)
+        {
+           sprintf(str,"Could not find default writer");
+           DvbPrintError(str);
+
+            ret = cERR_LINUXDVB_ERROR;
+        }
+        else
+        {
+            struct pollfd pfd[1];
+            pfd[0].fd = videofd;
+            pfd[0].events = POLLPRI;
+            int pollret = poll(pfd, 1, 0);
+            if (pollret > 0 && pfd[0].revents & POLLPRI)
+            {
+                struct video_event evt;
+                if (ioctl(videofd, VIDEO_GET_EVENT, &evt) == -1)
+                {
+                    sprintf(str,"ioctl failed with errno %d\n", errno);
+                    DvbPrintError(str);
+                }
+                else
+                {
+                    if (evt.type == VIDEO_EVENT_SIZE_CHANGED)
+                    {
+                        videoInfo.width = evt.u.size.w;
+                        videoInfo.height = evt.u.size.h;
+                        videoInfo.aspect_ratio = evt.u.size.aspect_ratio;
+                    }
+                    else if (evt.type == VIDEO_EVENT_FRAME_RATE_CHANGED)
+                    {
+                        videoInfo.frame_rate = evt.u.frame_rate;
+                    }
+                    else if (evt.type == 16)
+                    {
+                        videoInfo.progressive = evt.u.frame_rate;
+                    }
+
+                }
+            }
+
+            call.fd           = videofd;
+            call.data         = out->data;
+            call.len          = out->len;
+            call.Pts          = out->pts;
+            call.Dts          = out->dts;
+            call.private_data = out->extradata;
+            call.private_size = out->extralen;
+            call.FrameRate    = out->frameRate;
+            call.FrameScale   = out->timeScale;
+            call.Width        = out->width;
+            call.Height       = out->height;
+            call.InfoFlags    = out->infoFlags;
+            call.Version      = 0;
+            call.WriteV       = writev_with_retry;
+
+            if (writer->writeData)
+            {
+                res = writer->writeData(&call);
+            }
+
+            if (res < 0)
+            {
+                ret = cERR_LINUXDVB_ERROR;
+            }
+        }
+
+
+    return ret;
+}
+
+stb_type_t GetSTBType()
+{
+    static stb_type_t type = STB_UNKNOWN;
+    if (type == STB_UNKNOWN) {
+        if (access("/proc/stb/tpm/0/serial", F_OK) != -1) {
+            type = STB_DREAMBOX;
+        }
+        else if (access("/proc/stb/info/vumodel", F_OK) != -1 && \
+                 access("/proc/stb/info/boxtype", F_OK) == -1 ) {
+            // some STB like Octagon SF4008 has also /proc/stb/info/vumodel
+            // but VU PLUS does not have /proc/stb/info/boxtype
+            // please see: https://gitlab.com/e2i/e2iplayer/issues/282
+            type = STB_VUPLUS;
+        }
+        else if (access("/sys/firmware/devicetree/base/soc/hisilicon_clock/name", F_OK) != -1) {
+            type = STB_HISILICON;
+        }
+        else {
+            type = STB_OTHER;
+        }
+    }
+
+    return type;
+}
+
+
diff --git a/xbmc/cores/DvbPlayer/STBplayer/stm_ioctls.h b/xbmc/cores/DvbPlayer/STBplayer/stm_ioctls.h
