+
+void DvbAvDecoder::VideoSetSpeed(int speed)
+{
+
+if (!m_opened)
+    return;
+
+
+
+if (speed == m_speed)
+    return;
+
+if (speed > 1000)
+  {
+        CLog::Log(LOGINFO, "DvbCodec::SetSpeed goes forward, speed:{}", speed);
+        m_mode = VIDEO_MODE_FORWARD;
+        DvbSpeedVideo(speed);
+        m_speed = speed;
+        return;
+  }
+if (speed < 0)
+  {
+        CLog::Log(LOGINFO, "DvbCodec::SetSpeed goes backward, speed:{}", speed);
+        m_mode = VIDEO_MODE_BACKWARD;
+        DvbSpeedVideo(speed);
+        m_speed = speed;
+        return;
+  }
+
+if (speed == DVD_PLAYSPEED_PAUSE)
+  {
+      CLog::Log(LOGINFO, "DvbAvDecoder speed do pause");
+
+      DvbPauseVideo();
+      m_mode = VIDEO_MODE_PAUSE;
+      m_speed = speed;
+      return;
+ }
+
+if (speed == DVD_PLAYSPEED_NORMAL)
+{
+      CLog::Log(LOGINFO, "DvbAvDecoder speed do PLAY");
+
+      DvbContinueVideo();
+      m_mode = VIDEO_MODE_NORMAL;
+      m_speed = speed;
+      return;
+}
