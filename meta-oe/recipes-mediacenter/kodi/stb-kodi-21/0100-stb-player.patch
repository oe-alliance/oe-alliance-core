+ssize_t write_with_retry(int fd, const void *buf, int size)
+{
+    ssize_t ret;
+    int retval = 0;
+
+    while(size > 0)
+    {
+        ret = write(fd, buf, size);
+        if (ret < 0)
+        {
+            switch(errno)
+            {
+                case EINTR:
+                case EAGAIN:
+                    usleep(1000);
+                    continue;
+                default:
+                    retval = -3;
+                    break;
+            }
+            if (retval < 0)
+            {
+                break;
+            }
+        }
+            
+        if (ret < 0)
+        {
+            return ret;
+        }
+        
+        size -= ret;
+        buf += ret;
+        
+        if(size > 0)
+        {
+            if( usleep(1000) )
+            {
+                //hanswriter_err("usleep error \n");
+            }
+        }
+    }
+    return 0;
+}
+
+ssize_t writev_with_retry(int fd, const struct iovec *iov, int ic) 
+{
+    ssize_t len = 0;
+    int i = 0;
+    for(i=0; i<ic; ++i)
+    {
+        write_with_retry(fd, iov[i].iov_base, iov[i].iov_len); 
+        len += iov[i].iov_len;
+    }
+    return len;
+}
