+double DvbAvDecoder::GetPicturePts()
+{
+double pts;
+  if (!m_opened)
+    return DVD_NOPTS_VALUE;
+
+  pts = DvbGetPts();
+
+  pts *= 11.111; 
+
+  if (pts < m_seekpts){
+     pts = DVD_NOPTS_VALUE;
+     }
+return pts;
+}
+
+double DvbAvDecoder::VideoCurrentPts()
+{
+double pts;
+
+  if (!m_opened)
+    return DVD_NOPTS_VALUE;
+
+  pts = DvbGetPts();
+  
+  pts *= 11.111;
+  
+  return pts;
+}
