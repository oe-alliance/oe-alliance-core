+CDVDVideoCodecDvb::CDVDVideoCodecDvb(CProcessInfo& processInfo)
+    : CDVDVideoCodec(processInfo)
+    , m_Codec(NULL)
+    , m_pFormatName("hisicodec")
+    , m_last_pts(0.0)
+    , m_frame_queue(NULL)
+    , m_queue_depth(0)
+    , m_framerate(0.0)
+    , m_video_rate(0)
+    , m_mpeg2_sequence(NULL)
+    , m_bitparser(NULL)
+    , m_bitstream(nullptr)
+    , m_opened(false)
+    , m_drop(false)
+{
+  pthread_mutex_init(&m_queue_mutex, NULL);
+}
+
+CDVDVideoCodecDvb::~CDVDVideoCodecDvb()
+{
+  Dispose();
+  pthread_mutex_destroy(&m_queue_mutex);
+}
