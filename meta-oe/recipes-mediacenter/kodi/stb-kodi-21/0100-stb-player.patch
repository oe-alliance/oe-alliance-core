+    eVideo,
+    "V_HEVC",
+    -1,
+    STREAMTYPE_MPEG4_H265,
+    CT_H265
+};
+
+struct Writer_s WriterVideoH265 = {
+    &reset,
+    &writeData,
+    &writeReverseData,
+    &caps
+};
