+bool DvbAvDecoder::VideoClose()
+{
+  {
+    CSingleExit lock(m_section);
+
+
+    if (m_video_opend == false)
+      return false;
+
+    VideoReset();
+    DvbClearVideo();
+    DvbCloseVideo();
+
+    m_video_opend = false;
+    m_video_eos = true;
+    m_vptsQueue.clear();
+  }
+
+  return true;
+}
