From 7de38053f8ad1a4d4280b86279f2504547d33a43 Mon Sep 17 00:00:00 2001
From: OpenATV STB Kodi <noreply@openatv.local>
Date: Fri, 28 Aug 2026 20:35:00 +0200
Subject: [PATCH] bcm-dvb: add Gigablue driver variant

Gigablue's Nexus decoder follows the same startup order as its Enigma2
dvbmediasink. Clearing the decoder before or immediately after VIDEO_PLAY can
restore the stale Enigma2 shutdown surface after the first decoded frame.

Add a dedicated variant which retains the normal Broadcom codec handling but
omits both startup VIDEO_CLEAR_BUFFER calls. Also preserve dvbvideosink's
separate codec-data, PES-header and access-unit writes: the Gigablue Nexus
driver parses a combined write but does not present its frames.
---
 CMakeLists.txt     | 6 +++---
 backends/bcm_dvb.c | 27 +++++++++++++++++++++++++--
 2 files changed, 28 insertions(+), 5 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8716abf..aaae1fc 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -12,8 +12,8 @@ option(STBP_HISI_LINUX_DVB "Use the receiver Linux-DVB video driver instead of A
 option(STBP_BUILD_BCM_DVB_BACKEND "Build the Linux-DVB/PES backend used by Broadcom STBs" OFF)
 option(STBP_BUILD_DREAM_AML_BACKEND "Build the native DreamOne/DreamTwo Amlogic backend" OFF)
 set(STBP_BCM_DVB_VARIANT "normal" CACHE STRING
-    "Broadcom DVB stream-type/framing variant: normal, type2, dreambox or vuplus")
-set_property(CACHE STBP_BCM_DVB_VARIANT PROPERTY STRINGS normal type2 dreambox vuplus)
+    "Broadcom DVB stream-type/framing variant: normal, type2, dreambox, vuplus or gigablue")
+set_property(CACHE STBP_BCM_DVB_VARIANT PROPERTY STRINGS normal type2 dreambox vuplus gigablue)
 option(STBP_BCM_DVB_HAVE_HEVC "Advertise Broadcom HEVC decoding" OFF)
 option(STBP_BCM_DVB_HAVE_WMV "Advertise Broadcom VC-1/WMV3 decoding" OFF)
 option(STBP_BCM_DVB_HAVE_VP6 "Advertise Broadcom VP6 decoding" OFF)
@@ -111,7 +111,7 @@ if(STBP_BUILD_DREAM_AML_BACKEND)
 endif()
 
 if(STBP_BUILD_BCM_DVB_BACKEND)
-  if(NOT STBP_BCM_DVB_VARIANT MATCHES "^(normal|type2|dreambox|vuplus)$")
+  if(NOT STBP_BCM_DVB_VARIANT MATCHES "^(normal|type2|dreambox|vuplus|gigablue)$")
     message(FATAL_ERROR "Unsupported STBP_BCM_DVB_VARIANT: ${STBP_BCM_DVB_VARIANT}")
   endif()
   find_package(Threads REQUIRED)
diff --git a/backends/bcm_dvb.c b/backends/bcm_dvb.c
index 87d4854..7f04461 100644
--- a/backends/bcm_dvb.c
+++ b/backends/bcm_dvb.c
@@ -315,10 +315,27 @@ static enum stbp_result prepare_standard_packet_locked(struct bcm_instance* inst
   instance->pending = (uint8_t*)malloc(total_size);
   if (instance->pending == NULL)
     return STBP_ERROR_BACKEND;
+#if defined(STBP_BCM_DVB_VARIANT_GIGABLUE)
+  /* Gigablue's reference dvbvideosink submits codec data, the PES header and
+   * the encoded access unit in separate writes.  Its Nexus DVB driver parses
+   * the stream headers from a combined write but never presents a frame
+   * (VIDEO_GET_PTS remains zero).  Preserve the reference syscall boundaries. */
+  instance->pending_boundaries =
+      (size_t*)malloc((raw_codec_size != 0U ? 2U : 1U) *
+                      sizeof(*instance->pending_boundaries));
+  if (instance->pending_boundaries == NULL)
+  {
+    release_pending(instance);
+    return STBP_ERROR_BACKEND;
+  }
+#endif
   if (raw_codec_size != 0U)
   {
     memcpy(instance->pending + offset, instance->codec_data, raw_codec_size);
     offset += raw_codec_size;
+#if defined(STBP_BCM_DVB_VARIANT_GIGABLUE)
+    instance->pending_boundaries[instance->pending_boundary_count++] = offset;
+#endif
   }
   memcpy(instance->pending + offset, pes_header, pes_header_size);
   offset += pes_header_size;
@@ -332,6 +349,10 @@ static enum stbp_result prepare_standard_packet_locked(struct bcm_instance* inst
     memcpy(instance->pending + offset, prefix, prefix_size);
     offset += prefix_size;
   }
+#if defined(STBP_BCM_DVB_VARIANT_GIGABLUE)
+  instance->pending_boundaries[instance->pending_boundary_count++] = offset;
+  instance->pending_boundary_index = 0U;
+#endif
   if (packet->size != 0U)
     memcpy(instance->pending + offset, packet->data, packet->size);
   instance->pending_size = total_size;
@@ -803,7 +824,8 @@ static enum stbp_result bcm_open(void* opaque,
    * previous Enigma2 decoder surface until the device buffer is cleared.
    * The TYPE2 xcore driver uses the reference E2 order without either
    * startup clear; clearing here prevents HEVC from starting on BCM73565. */
-#if !defined(STBP_BCM_DVB_VARIANT_TYPE2)
+#if !defined(STBP_BCM_DVB_VARIANT_TYPE2) && \
+    !defined(STBP_BCM_DVB_VARIANT_GIGABLUE)
   if (ioctl(instance->video_fd, VIDEO_CLEAR_BUFFER) < 0)
     bcm_log_errno(instance, STBP_LOG_DEBUG, "initial VIDEO_CLEAR_BUFFER");
 #endif
@@ -832,7 +854,8 @@ static enum stbp_result bcm_open(void* opaque,
   }
   /* Keep the BCM7425 post-start reset, but do not disturb the TYPE2 decoder
    * after VIDEO_PLAY/VIDEO_CONTINUE. */
-#if !defined(STBP_BCM_DVB_VARIANT_TYPE2)
+#if !defined(STBP_BCM_DVB_VARIANT_TYPE2) && \
+    !defined(STBP_BCM_DVB_VARIANT_GIGABLUE)
   if (ioctl(instance->video_fd, VIDEO_CLEAR_BUFFER) < 0)
     bcm_log_errno(instance, STBP_LOG_DEBUG, "post-start VIDEO_CLEAR_BUFFER");
 #endif
-- 
2.50.1
