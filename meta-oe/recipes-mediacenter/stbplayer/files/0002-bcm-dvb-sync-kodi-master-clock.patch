diff --git a/include/stbplayer/backend.h b/include/stbplayer/backend.h
index d3523e3..66510c0 100644
--- a/include/stbplayer/backend.h
+++ b/include/stbplayer/backend.h
@@ -223,6 +223,9 @@ struct stbp_backend_api_v1
   enum stbp_result (*flush)(void* instance, int64_t next_pts_90k);
   enum stbp_result (*drain)(void* instance);
   enum stbp_result (*reset)(void* instance);
+  /* Align the hardware presentation clock to the frontend master clock
+   * without flushing queued decoder data. */
+  enum stbp_result (*sync_clock)(void* instance, int64_t pts_90k);
   enum stbp_result (*set_speed)(void* instance, struct stbp_rational speed);
   enum stbp_result (*set_paused)(void* instance, int paused);
   enum stbp_result (*set_video_rect)(void* instance,
diff --git a/src/loader.c b/src/loader.c
index 61e53c7..9b7867a 100644
--- a/src/loader.c
+++ b/src/loader.c
@@ -51,7 +51,8 @@ static int api_has_required_functions(const struct stbp_backend_api_v1* api)
   return api->create != NULL && api->destroy != NULL && api->probe != NULL &&
          api->open != NULL && api->queue_packet != NULL && api->get_buffer_state != NULL &&
          api->get_status != NULL && api->flush != NULL && api->drain != NULL &&
-         api->reset != NULL && api->set_speed != NULL && api->set_paused != NULL &&
