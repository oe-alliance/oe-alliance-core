+typedef struct
+{
+  GstPad *sinkpad;
+  gchar *title;
+} TitleTestData;
+
+static gboolean
+title_test_event (GstPad * pad, GstObject * parent, GstEvent * event)
+{
+  TitleTestData *data = gst_pad_get_element_private (pad);
+
+  if (GST_EVENT_TYPE (event) == GST_EVENT_TAG) {
+    GstTagList *tags;
+    gchar *title = NULL;
+
+    gst_event_parse_tag (event, &tags);
+    if (gst_tag_list_get_scope (tags) == GST_TAG_SCOPE_STREAM
+        && gst_tag_list_get_string (tags, GST_TAG_TITLE, &title)) {
+      g_free (data->title);
+      data->title = title;
+    }
+  }
+  gst_event_unref (event);
+  return TRUE;
+}
+
+static void
+title_test_pad_added (GstElement * element, GstPad * pad, TitleTestData * data)
+{
+  fail_unless (data->sinkpad == NULL);
+  data->sinkpad = gst_pad_new_from_static_template (&sinktemplate, "sink");
+  gst_pad_set_element_private (data->sinkpad, data);
+  gst_pad_set_event_function (data->sinkpad, title_test_event);
+  gst_pad_set_chain_function (data->sinkpad, _sink_chain);
+  gst_pad_set_active (data->sinkpad, TRUE);
+  fail_unless (gst_pad_link (pad, data->sinkpad) == GST_PAD_LINK_OK);
+}
+
+GST_START_TEST (test_qtdemux_early_adaptive_title)
+{
+  guint i;
+
+  load_files ();
+  for (i = 0; i < 4; i++) {
+    GstElement *demux = gst_element_factory_make ("qtdemux", NULL);
+    GstPad *sinkpad = gst_element_get_static_pad (demux, "sink");
+    GstSegment segment;
+    GstBuffer *buffer;
+    TitleTestData data = { 0, };
+
+    g_signal_connect (demux, "pad-added", G_CALLBACK (title_test_pad_added),
+        &data);
+    gst_element_set_state (demux, GST_STATE_PLAYING);
+    fail_unless (gst_pad_send_event (sinkpad, gst_event_new_stream_start ("a")));
+    gst_segment_init (&segment, GST_FORMAT_TIME);
+    fail_unless (gst_pad_send_event (sinkpad, gst_event_new_segment (&segment)));
+    if (i != 1) {
+      GstTagList *tags = gst_tag_list_new (GST_TAG_TITLE, "Klare Sprache", NULL);
+
+      if (i == 2)
+        gst_tag_list_set_scope (tags, GST_TAG_SCOPE_GLOBAL);
+      fail_unless (gst_pad_send_event (sinkpad, gst_event_new_tag (tags)));
+    }
+    if (i == 3) {
+      /* A new stream without a label must not inherit the previous title. */
+      fail_unless (gst_pad_send_event (sinkpad, gst_event_new_stream_start ("b")));
+      fail_unless (gst_pad_send_event (sinkpad, gst_event_new_segment (&segment)));
+    }
+    buffer = gst_buffer_new_and_alloc (init_mp4_len);
+    gst_buffer_fill (buffer, 0, init_mp4, init_mp4_len);
+    GST_BUFFER_PTS (buffer) = 0;
+    GST_BUFFER_OFFSET (buffer) = 0;
+    fail_unless (gst_pad_chain (sinkpad, buffer) == GST_FLOW_OK);
+    buffer = gst_buffer_new_and_alloc (seg_1_m4f_len);
+    gst_buffer_fill (buffer, 0, seg_1_m4f, seg_1_m4f_len);
+    GST_BUFFER_PTS (buffer) = 0;
+    GST_BUFFER_OFFSET (buffer) = 0;
+    fail_unless (gst_pad_chain (sinkpad, buffer) == GST_FLOW_OK);
+    fail_unless (data.sinkpad != NULL);
+    fail_unless (g_strcmp0 (data.title, i == 0 ? "Klare Sprache" : NULL) == 0);
+    gst_element_set_state (demux, GST_STATE_NULL);
+    gst_pad_set_active (data.sinkpad, FALSE);
+    gst_object_unref (data.sinkpad);
+    gst_object_unref (sinkpad);
+    gst_object_unref (demux);
+    g_free (data.title);
+  }
+  unload_files ();
+}
+
+GST_END_TEST;
 
