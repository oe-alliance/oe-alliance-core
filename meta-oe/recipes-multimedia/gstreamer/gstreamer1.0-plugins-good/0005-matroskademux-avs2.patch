Subject: [PATCH] matroskademux: AVS2 video

The codec id V_AVS2 came out as video/x-unknown and no element took it.
Map it to video/x-avs2; the sequence header comes in band with every
keyframe, there is no codec data.

diff --git a/gst/matroska/matroska-demux.c b/gst/matroska/matroska-demux.c
index 988b489..2f90c12 100644
--- a/gst/matroska/matroska-demux.c
+++ b/gst/matroska/matroska-demux.c
@@ -7006,6 +7006,10 @@ gst_matroska_demux_video_caps (GstMatroskaTrackVideoContext *
       GST_WARNING ("No AV1 codec data found!");
     }
     *codec_name = g_strdup_printf ("AOM AV1");
+  } else if (!strcmp (codec_id, GST_MATROSKA_CODEC_ID_VIDEO_AVS2)) {
+    /* the sequence header comes in band with every keyframe */
+    caps = gst_caps_new_empty_simple ("video/x-avs2");
+    *codec_name = g_strdup ("AVS2");
   } else if (!strcmp (codec_id, GST_MATROSKA_CODEC_ID_VIDEO_FFV1)) {
     caps =
         gst_caps_new_simple ("video/x-ffv", "ffvversion", G_TYPE_INT, 1, NULL);
diff --git a/gst/matroska/matroska-ids.h b/gst/matroska/matroska-ids.h
index 336585a..a9bb886 100644
--- a/gst/matroska/matroska-ids.h
+++ b/gst/matroska/matroska-ids.h
@@ -389,6 +389,7 @@
 #define GST_MATROSKA_CODEC_ID_VIDEO_VP8          "V_VP8"
 #define GST_MATROSKA_CODEC_ID_VIDEO_VP9          "V_VP9"
 #define GST_MATROSKA_CODEC_ID_VIDEO_AV1          "V_AV1"
+#define GST_MATROSKA_CODEC_ID_VIDEO_AVS2         "V_AVS2"
 #define GST_MATROSKA_CODEC_ID_VIDEO_MPEGH_HEVC   "V_MPEGH/ISO/HEVC"
 #define GST_MATROSKA_CODEC_ID_VIDEO_MPEGI_VVC    "V_MPEGI/ISO/VVC"
 #define GST_MATROSKA_CODEC_ID_VIDEO_PRORES       "V_PRORES"
