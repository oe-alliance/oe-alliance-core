+/* The hardware decoder index is selectable (property "decoder") so a second
+ * instance can drive the PiP decoder (video1, /proc/stb/vmpeg/1). */
+static const char *video_device_path(GstDVBVideoSink *self, char *buf)
+{
+	sprintf(buf, "/dev/dvb/adapter0/video%u", self->decoder);
+	return buf;
+}
