+#ifdef VUPLUS
+/* Returns a padded copy of a lone DTS core frame the driver would otherwise
+ * not lock onto (see dvb_dts_aligned_size), or NULL to use the buffer as is. */
+static GstBuffer *gst_dvbaudiosink_dts_align_buffer(GstBuffer *buffer)
+{
+	GstMapInfo input, output;
+	GstBuffer *aligned;
+	gsize padded;
+	if (!gst_buffer_map(buffer, &input, GST_MAP_READ))
+		return NULL;
+	padded = dvb_dts_aligned_size(input.data, input.size);
+	if (!padded)
+	{
+		gst_buffer_unmap(buffer, &input);
+		return NULL;
+	}
+	aligned = gst_buffer_new_allocate(NULL, padded, NULL);
+	if (!aligned || !gst_buffer_map(aligned, &output, GST_MAP_WRITE))
+	{
+		if (aligned) gst_buffer_unref(aligned);
+		gst_buffer_unmap(buffer, &input);
+		return NULL;
+	}
+	dvb_dts_align(output.data, padded, input.data, input.size);
+	gst_buffer_unmap(aligned, &output);
+	gst_buffer_unmap(buffer, &input);
+	if (!gst_buffer_copy_into(aligned, buffer, GST_BUFFER_COPY_METADATA, 0, -1))
+	{
+		gst_buffer_unref(aligned);
+		return NULL;
+	}
+	return aligned;
+}
+#endif
