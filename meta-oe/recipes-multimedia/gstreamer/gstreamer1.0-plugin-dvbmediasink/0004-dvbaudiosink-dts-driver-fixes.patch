+/*
+ * Some drivers pass DTS-HD MA and DTS:X through in full only in their
+ * DTS-HD mode (bypass mode 0x10); in plain DTS mode (2) they send the core
+ * alone.  The caps do not say whether a stream carries the HD extension, so
+ * for DTS the decoder is not started from set_caps but on the first frame,
+ * in the mode that frame calls for.
+ *
+ * Only where the driver's DTS-HD mode is known to cope with a receiver that
+ * has no DTS-HD: the drivers with /proc/stb/audio/dtshd (e.g. the Vu+ Duo 4K
+ * Lite's dvb.ko / nexus.ko, GigaBlue), and the dvb-bcm7444.ko of the Vu+
+ * Ultimo 4K and Duo 4K SE, which images patch
+ * for this (vuplus-driver-fix.py).  An unpatched dvb-bcm7444.ko would give
+ * such a receiver no sound at all, so everything else stays on plain DTS.
+ */
+static gboolean gst_dvbaudiosink_dts_hd_mode_usable(void)
+{
+#if defined(DREAMBOX) || !defined(machine)
+	/* Dreambox: DTS is handled by gst_dvbaudiosink_dts_buffer() */
+	return FALSE;
+#else
+	return access("/proc/stb/audio/dtshd", F_OK) == 0 ||
+		!strcmp(machine, "vuultimo4k") || !strcmp(machine, "vuduo4kse");
+#endif
+}
