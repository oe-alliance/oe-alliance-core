+static gboolean gst_dvbaudiosink_dts_start(GstDVBAudioSink *self, GstBuffer *buffer)
+{
+	GstMapInfo map;
+	gboolean hd = FALSE;
+	self->dts_start_pending = FALSE;
+	if (gst_buffer_map(buffer, &map, GST_MAP_READ))
+	{
+		hd = dvb_dts_has_hd_extension(map.data, map.size);
+		gst_buffer_unmap(buffer, &map);
+	}
+	self->bypass = hd ? AUDIOTYPE_DTS_HD : AUDIOTYPE_DTS;
+	GST_INFO_OBJECT(self, "DTS %s, set bypass 0x%02x", hd ? "with HD extension" : "core only", self->bypass);
+	if (self->fd < 0 || ioctl(self->fd, AUDIO_SET_BYPASS_MODE, self->bypass) < 0)
+	{
+		GST_ELEMENT_ERROR(self, STREAM, TYPE_NOT_FOUND,(NULL),("hardware decoder can't be set to bypass mode 0x%02x", self->bypass));
+		return FALSE;
+	}
+	ioctl(self->fd, AUDIO_PLAY);
+	/* the state change to PLAYING may have gone by with nothing to continue */
+	if (!self->paused)
+		ioctl(self->fd, AUDIO_CONTINUE);
+	self->playing = TRUE;
+
+	GST_OBJECT_LOCK(self);
+	gst_dvbaudiosink_apply_audio_channel(self, self->audio_channel);
+	GST_OBJECT_UNLOCK(self);
+	return TRUE;
+}
