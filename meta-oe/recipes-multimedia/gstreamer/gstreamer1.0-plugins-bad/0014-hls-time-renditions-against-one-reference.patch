+static void
+gst_hls_demux_clear_time_ref (GstHLSDemux * demux)
+{
+  g_mutex_lock (&demux->time_ref_lock);
+  demux->time_ref_ts = GST_CLOCK_TIME_NONE;
+  demux->time_ref_mpeg = GST_CLOCK_TIME_NONE;
+  g_mutex_unlock (&demux->time_ref_lock);
+}
+
+/* A fragment that starts a stream, or follows a discontinuity or a variant
+ * switch, is timed by its position in the playlist. The playlist durations
+ * are rounded, and each playlist sums up its own: renditions with their own
+ * playlist drift against the variant. Time such a fragment by its MPEG time
+ * against the time reference of all streams instead. */
+static void
+gst_hls_demux_stream_apply_time_ref (GstHLSDemux * demux,
+    GstAdaptiveDemuxStream * stream, GstClockTime mpeg_time)
+{
+  GstHLSDemuxStream *hls_stream = GST_HLS_DEMUX_STREAM_CAST (stream);
+  GstClockTimeDiff ts;
+
+  if (hls_stream->time_ref_done)
+    return;
+  hls_stream->time_ref_done = TRUE;
+
+  if (!stream->first_fragment_buffer
+      || !GST_CLOCK_TIME_IS_VALID (stream->fragment.timestamp)
+      || !GST_CLOCK_TIME_IS_VALID (mpeg_time)
+      || demux->parent.segment.rate < 0.0)
+    return;
+
+  g_mutex_lock (&demux->time_ref_lock);
+  if (!GST_CLOCK_TIME_IS_VALID (demux->time_ref_ts)) {
+    /* The MPEG time of a rendition, the ID3 PTS of packed audio, can be up to
+     * a second later than the first PCR of the variant: keep the variant
+     * from starting before the segment */
+    demux->time_ref_ts = stream->fragment.timestamp +
+        (hls_stream->is_primary_playlist ? 0 : GST_SECOND);
+    demux->time_ref_mpeg = mpeg_time;
+    stream->fragment.timestamp = demux->time_ref_ts;
+    GST_DEBUG_OBJECT (stream->pad, "Time reference %" GST_TIME_FORMAT
+        " at MPEG time %" GST_TIME_FORMAT, GST_TIME_ARGS (demux->time_ref_ts),
+        GST_TIME_ARGS (mpeg_time));
+  } else {
+    ts = (GstClockTimeDiff) demux->time_ref_ts +
+        GST_CLOCK_DIFF (demux->time_ref_mpeg, mpeg_time);
+    GST_DEBUG_OBJECT (stream->pad, "Fragment at MPEG time %" GST_TIME_FORMAT
+        " timed %" GST_STIME_FORMAT " instead of %" GST_TIME_FORMAT,
+        GST_TIME_ARGS (mpeg_time), GST_STIME_ARGS (ts),
+        GST_TIME_ARGS (stream->fragment.timestamp));
+    if (ts >= 0)
+      stream->fragment.timestamp = ts;
+  }
+  g_mutex_unlock (&demux->time_ref_lock);
+}
+
 static GstFlowReturn
