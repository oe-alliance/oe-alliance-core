+      if (xmlStrcmp (cur_node->name, (xmlChar *) "Label") == 0) {
+        /* Preserve the supplied name; do not infer it from language or role.
+         * Multiple localized labels are allowed. Retain the first non-empty
+         * one without depending on the receiver's locale. */
+        if (!new_adap_set->label) {
+          xmlChar *content = xmlNodeGetContent (cur_node);
+
+          if (content) {
+            gchar *label = g_strstrip (g_strdup ((const gchar *) content));
+
+            xmlFree (content);
+            if (*label)
+              new_adap_set->label = label;
+            else
+              g_free (label);
+          }
+        }
+      } else if (xmlStrcmp (cur_node->name, (xmlChar *) "Accessibility") == 0) {
