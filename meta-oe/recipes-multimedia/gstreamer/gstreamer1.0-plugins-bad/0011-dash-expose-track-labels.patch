 GST_END_TEST;
 
 /*
- * Test parsing Period AdaptationSet RepresentationBase attributes
- *
- */
+ * Test supplied adaptation-set labels and unchanged missing metadata.
+ *
+ */
+GST_START_TEST (dash_mpdparser_adaptation_set_labels)
+{
+  const gchar *xml =
+      "<MPD xmlns=\"urn:mpeg:dash:schema:mpd:2011\" "
+      "profiles=\"urn:mpeg:dash:profile:isoff-live:2011\"><Period>"
+      "<AdaptationSet lang=\"ger\"><Label>TV Ton</Label></AdaptationSet>"
+      "<AdaptationSet lang=\"ger\"><Label>Originalton</Label></AdaptationSet>"
+      "<AdaptationSet lang=\"ger\"><Label>Audiodeskription</Label></AdaptationSet>"
+      "<AdaptationSet lang=\"ger\"><Label>Klare Sprache</Label></AdaptationSet>"
+      "<AdaptationSet lang=\"ger\"/>"
+      "<AdaptationSet><Label/><Label> \n\t </Label></AdaptationSet>"
+      "<AdaptationSet><Label/><Label lang=\"de\">  H&#246;rfilm &amp; Ton  </Label>"
+      "<Label lang=\"en\">Audio description</Label></AdaptationSet>"
+      "</Period></MPD>";
+  const gchar *expected[] = { "TV Ton", "Originalton", "Audiodeskription",
+    "Klare Sprache", NULL, NULL, "H\303\266rfilm & Ton"
+  };
+  GstMPDClient *client = gst_mpd_client_new ();
+  GstMPDPeriodNode *period;
+  guint i;
+
+  fail_unless (gst_mpd_client_parse (client, xml, strlen (xml)));
+  period = client->mpd_root_node->Periods->data;
+  assert_equals_int (g_list_length (period->AdaptationSets),
+      G_N_ELEMENTS (expected));
+  for (i = 0; i < G_N_ELEMENTS (expected); i++) {
+    GstMPDAdaptationSetNode *set =
+        g_list_nth_data (period->AdaptationSets, i);
+    xmlNodePtr node = gst_mpd_node_get_xml_pointer (GST_MPD_NODE (set));
+    xmlNodePtr child;
+    gchar *serialized_label = NULL;
+
+    fail_unless (g_strcmp0 (set->label, expected[i]) == 0);
+    if (i < 5) {
+      assert_equals_string (set->lang, "ger");
+    } else {
+      fail_unless (set->lang == NULL);
+    }
+    for (child = node->children; child; child = child->next) {
+      if (xmlStrcmp (child->name, (xmlChar *) "Label") == 0) {
+        fail_unless (serialized_label == NULL);
+        serialized_label = (gchar *) xmlNodeGetContent (child);
+      }
+    }
+    fail_unless (g_strcmp0 (serialized_label, expected[i]) == 0);
+    xmlFree (serialized_label);
+    xmlFreeNode (node);
+  }
+  gst_mpd_client_free (client);
+}
+
+GST_END_TEST;
+
