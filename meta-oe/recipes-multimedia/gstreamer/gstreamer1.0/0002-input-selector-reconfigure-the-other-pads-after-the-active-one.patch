Subject: [PATCH] input-selector: reconfigure the other pads after the active one

An inactive sink pad answers not-linked, and adaptivedemux stops the
download of such a stream until a reconfigure event comes. When the active
pad goes away, input-selector waits for another pad to push data, but none
was told to start: Pluto TV muxes audio into the content video segments
and lists it as a rendition as well; the inserted ads carry no muxed audio,
the muxed audio pad goes away and playback hung for good.

Send a reconfigure event upstream on the other pads when the active pad
is released.

Upstream-Status: Pending
---
diff --git a/plugins/elements/gstinputselector.c b/plugins/elements/gstinputselector.c
index 330cc14..04e177b 100644
--- a/plugins/elements/gstinputselector.c
+++ b/plugins/elements/gstinputselector.c
@@ -2099,6 +2099,8 @@ gst_input_selector_release_pad (GstElement * element, GstPad * pad)
 {
   GstSelectorPad *selpad;
   GstInputSelector *sel;
+  gboolean was_active = FALSE;
+  GList *pads, *walk;
 
   sel = GST_INPUT_SELECTOR (element);
   selpad = GST_SELECTOR_PAD (pad);
@@ -2120,6 +2122,7 @@ gst_input_selector_release_pad (GstElement * element, GstPad * pad)
     gst_object_unref (sel->active_sinkpad);
     sel->active_sinkpad = NULL;
     sel->active_sinkpad_from_user = FALSE;
+    was_active = TRUE;
   }
 
   /* wake up the pad if it's currently waiting for EOS or a running time to be
@@ -2134,6 +2137,20 @@ gst_input_selector_release_pad (GstElement * element, GstPad * pad)
 
   gst_pad_set_active (pad, FALSE);
   gst_element_remove_pad (GST_ELEMENT (sel), pad);
+
+  if (!was_active)
+    return;
+
+  /* An inactive pad answers not-linked, and an upstream that stopped on it
+   * (adaptivedemux) waits for a reconfigure: tell the other pads, one of
+   * them becomes the active pad now */
+  GST_OBJECT_LOCK (sel);
+  pads = g_list_copy_deep (GST_ELEMENT_CAST (sel)->sinkpads,
+      (GCopyFunc) gst_object_ref, NULL);
+  GST_OBJECT_UNLOCK (sel);
+  for (walk = pads; walk; walk = walk->next)
+    gst_pad_push_event (GST_PAD_CAST (walk->data), gst_event_new_reconfigure ());
+  g_list_free_full (pads, gst_object_unref);
 }
 
 static void
