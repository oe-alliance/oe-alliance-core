+/* The A2DP control paths serialize thread creation and reaping with the
+ * adapter devices mutex. The worker keeps its ID intact during cleanup. */
+static int transport_a2dp_thread_join(struct ba_transport *t, bool cancel) {
+	const pthread_t thread = t->thread;
+	if (pthread_equal(thread, config.main_thread))
+		return 0;
+	if (pthread_equal(thread, pthread_self())) {
+		warn("Couldn't join A2DP transport thread: %s", strerror(EDEADLK));
+		return EDEADLK;
+	}
+
+	int err;
+	if (cancel) {
+		if ((err = pthread_cancel(thread)) != 0 && err != ESRCH) {
+			warn("Couldn't cancel A2DP transport thread: %s", strerror(err));
+			return err;
+		}
+		err = pthread_join(thread, NULL);
+	}
+	else
+		err = pthread_tryjoin_np(thread, NULL);
+
+	if (err == 0)
+		t->thread = config.main_thread;
+	else if (cancel || err != EBUSY)
+		warn("Couldn't join A2DP transport thread: %s", strerror(err));
+	return err;
+}
