From d315ac35b0b15471a4db0916d4e473c8c503c15e Mon Sep 17 00:00:00 2001
From: Captain <captain.onboard@web.de>
Date: Thu, 8 Apr 2021 13:49:17 +0200
Subject: [PATCH] fix build openssl102q

---
 librtmp/hashswf.c | 5 +++++
 librtmp/rtmp.c    | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/librtmp/hashswf.c b/librtmp/hashswf.c
index 40aba37..296b52f 100644
--- a/librtmp/hashswf.c
+++ b/librtmp/hashswf.c
@@ -62,6 +62,11 @@
 #include <openssl/ssl.h>
 #include <openssl/sha.h>
 #include <openssl/hmac.h>
+#if OPENSSL_VERSION_NUMBER < 0x10100000L
+#ifndef RC4_INT
+#define RC4_INT unsigned int
+#endif
+#endif
 #include <openssl/rc4.h>
 #if OPENSSL_VERSION_NUMBER >= 0x10100000
 #define HMAC_CTX HMAC_CTX *
diff --git a/librtmp/rtmp.c b/librtmp/rtmp.c
index 58111ef..d429877 100644
--- a/librtmp/rtmp.c
+++ b/librtmp/rtmp.c
@@ -61,6 +61,11 @@ static const char *my_dhm_G = "4";
 #include <nettle/version.h>
 #else	/* USE_OPENSSL */
 #include <openssl/ssl.h>
+#if OPENSSL_VERSION_NUMBER < 0x10100000L
+#ifndef RC4_INT
+#define RC4_INT unsigned int
+#endif
+#endif
 #include <openssl/rc4.h>
 #include <openssl/md5.h>
 #include <openssl/bio.h>
