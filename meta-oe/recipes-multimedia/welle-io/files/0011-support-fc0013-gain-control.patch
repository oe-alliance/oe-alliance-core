 }
 
+void CRTL_SDR::reportInputOverrun()
+{
+    const uint32_t bytes = droppedBytes.exchange(0, std::memory_order_relaxed);
+    if (bytes)
+        std::clog << "RTL_SDR: input buffer overrun, discarded " << bytes / 2
+                  << " I/Q samples (decoder cannot keep up)" << std::endl;
+}
