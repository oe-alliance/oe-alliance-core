@@ -247,13 +259,33 @@
 
 void CRTL_SDR::setAgc(bool AGC)
 {
-    if (AGC == true) {
-        isAGC = true;
-    }
-    else {
-        isAGC = false;
-        setGain(currentGainIndex);
-    }
+    std::lock_guard<std::mutex> lock(tunerMutex);
+    if (isFC0013) {
+        // The FC0013 has I/Q outputs. old-dab requires digital AGC together
+        // with its tuner hardware AGC to avoid overloading the RTL2832 ADC.
+        int ret;
+        if (AGC) {
+            ret = rtlsdr_set_agc_mode(device, 1);
+            if (!ret)
+                ret = rtlsdr_set_tuner_gain_mode(device, 0);
+        }
+        else {
+            ret = rtlsdr_set_tuner_gain_mode(device, 1);
+            if (!ret)
+                ret = rtlsdr_set_agc_mode(device, 0);
+        }
+        if (ret) {
+            std::clog << "RTL_SDR: FC0013 gain mode failed: " << ret << std::endl;
+            return;
+        }
+        if (isHwAGC != AGC)
+            std::clog << "RTL_SDR: FC0013 " << (AGC ? "hardware AGC" : "manual IF gain")
+                      << ", periodic LNA control enabled" << std::endl;
+        isHwAGC = AGC;
+    }
+    isAGC = AGC;
+    if (!AGC)
+        setGainLocked(currentGainIndex);
 }
 
