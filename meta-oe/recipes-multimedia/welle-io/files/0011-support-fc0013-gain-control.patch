 void CRTL_SDR::agc_timer_thread(void)
 {
+    auto nextTunerUpdate = std::chrono::steady_clock::now();
+    auto nextOverrunReport = nextTunerUpdate + std::chrono::seconds(5);
+    bool tunerReadFailed = false;
     while (rtlsdrRunning && not rtlsdrUnplugged) {
         std::this_thread::sleep_for(std::chrono::milliseconds(50));
+        if (!rtlsdrRunning || rtlsdrUnplugged)
+            break;
+
+        const auto now = std::chrono::steady_clock::now();
+        if (now >= nextOverrunReport) {
+            reportInputOverrun();
+            nextOverrunReport = now + std::chrono::seconds(5);
+        }
+
+        std::lock_guard<std::mutex> lock(tunerMutex);
+        if (isFC0013 && now >= nextTunerUpdate) {
+            // In old-dab this read also adjusts the FC0013 LNA from RSSI.
+            // rtl_tcp does the same even without a connected status client.
+            // It is needed with both automatic and manual IF gain.
+            unsigned char registers[256] = {};
+            int length = 0, gain = 0;
+            const int ret = rtlsdr_get_tuner_i2c_register(device, registers, &length, &gain);
+            if (ret && !tunerReadFailed)
+                std::clog << "RTL_SDR: FC0013 LNA control failed: " << ret << std::endl;
+            tunerReadFailed = ret != 0;
+            nextTunerUpdate = now + std::chrono::milliseconds(500);
+        }
+
+        if (isHwAGC)
+            continue;
+
+        const uint16_t range = amplitudeRange.load(std::memory_order_relaxed);
+        const uint8_t minAmplitude = range >> 8;
+        const uint8_t maxAmplitude = range & 0xff;
 
         if (isAGC) {
             // Check for overloading
             if (minAmplitude == 0 || maxAmplitude == 255) {
                 // We have to decrease the gain
                 if (currentGainIndex > 0) {
-                    setGain(currentGainIndex - 1);
+                    setGainLocked(currentGainIndex - 1);
                     //std::clog << "RTL_SDR: " << "Decreased gain to " << (float)currentGain / 10.0f << std::endl;
                 }
             }
@@ -320,7 +385,7 @@
 
                     // We have to increase the gain
                     if(NewMinValue >= 0 && NewMaxValue <= 255) {
-                        setGain(currentGainIndex + 1);
+                        setGainLocked(currentGainIndex + 1);
                         //std::clog << "RTL_SDR: " << "Increased gain to " << (float) currentGain / 10 << std::endl;
                     }
                 }
@@ -336,6 +401,14 @@
