+# PTY checks after the OpenATV patches
+
+```sh
+g++ -std=c++17 -g -O1 -fsanitize=address,undefined -fno-omit-frame-pointer \
+  -ffunction-sections -fdata-sections -Isrc -Isrc/backend -Isrc/various \
+  -Wl,--gc-sections tests/pty/test_pty.cpp src/backend/fib-processor.cpp \
+  -o /tmp/test-rtl-pty
+/tmp/test-rtl-pty
+python3 tests/pty/test_frontend.py
+```
+
+The production FIB processor is compiled; unused RF/audio decoding code is
+discarded at link time. The frontend test compiles the production selected-service
+publisher with an in-memory receiver and its bundled JSON implementation.
+It checks initial, late, changed, missing and unchanged metadata snapshots.
+The decoding test covers early FIG 0/17 before service announcement, dynamic
+changes, legacy language/complementary fields, truncation and ensemble reset.
+
+Optional replay of the same ERT ETI-NI used for the DVB checks:
+
+```sh
+python3 tests/pty/extract_eti_fic.py /path/to/ert.eti /tmp/ert.fib
+/tmp/test-rtl-pty /tmp/ert.fib
+```
+
+Expected: 22,461 CRC-checked FIBs, matching PTY values for 14 services, table 1.
+The capture is not included. SHA-256:
+`923acf1bf43dabf0e284624726db81e93bab98b12159291d478179ea36874814`.
+
+These host checks do not replace a complete OE image build or live RTL-SDR test.
diff --git a/tests/pty/extract_eti_fic.py b/tests/pty/extract_eti_fic.py
new file mode 100644
--- /dev/null
+++ b/tests/pty/extract_eti_fic.py
@@ -0,0 +1,30 @@
+"""Extract CRC-checked FIBs: python3 extract_eti_fic.py ert.eti ert.fib."""
+import sys
+from pathlib import Path
+
+
+def valid_crc(block):
+    crc = 0xffff
+    for value in block:
+        crc ^= value << 8
+        for _ in range(8):
+            crc = ((crc << 1) ^ (0x1021 if crc & 0x8000 else 0)) & 0xffff
+    return crc == 0x1d0f
+
+
+capture = Path(sys.argv[1]).read_bytes()
+assert len(capture) % 6144 == 0
+fibs = bytearray()
+for offset in range(0, len(capture), 6144):
+    frame = capture[offset:offset + 6144]
+    assert frame[:4] in (b"\xff\x07\x3a\xb6", b"\xff\xf8\xc5\x49")
+    if not frame[5] & 0x80:
+        continue
+    start = 12 + (frame[5] & 127) * 4
+    length = 128 if (frame[6] >> 3) & 3 == 3 else 96
+    for index in range(start, start + length, 32):
+        fib = frame[index:index + 32]
+        assert valid_crc(fib), (offset, index)
+        fibs.extend(fib)
+Path(sys.argv[2]).write_bytes(fibs)
+print(len(fibs) // 32, "CRC-checked FIBs extracted")
diff --git a/tests/pty/test_frontend.py b/tests/pty/test_frontend.py
new file mode 100644
--- /dev/null
+++ b/tests/pty/test_frontend.py
@@ -0,0 +1,84 @@
+"""Compile the production metadata publisher with an in-memory receiver.
+
+Run from a patched welle.io checkout: python3 tests/pty/test_frontend.py
+The decoder itself is exercised separately by test_pty.cpp.
+"""
+import subprocess
+import tempfile
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[2]
+source = (root / "src/welle-e2/welle-e2.cpp").read_text()
+
+
+def function(signature):
+    start = source.index(signature)
+    return source[start:source.index("\n}", start) + 2]
+
+
+start = source.index("struct SelectedServiceMetadata {")
+metadata = source[start:source.index("\n};", start) + 3]
+test = r'''
+#include <cassert>
+#include <string>
+#include <vector>
+#include "libs/json.hpp"
+using nlohmann::json;
+std::vector<json> updates;
+void emitMetadata(const json& value) { updates.push_back(value); }
+enum class TransportMode { Audio };
+enum class AudioServiceComponentType { DABPlus };
+struct Component {
+    TransportMode transportMode() const { return TransportMode::Audio; }
+    AudioServiceComponentType audioType() const { return AudioServiceComponentType::DABPlus; }
+};
+struct Label { std::string utf8_label() const { return "ERT"; } };
+struct Service { Label serviceLabel; int language=112; int programType=-1; };
+struct Subchannel {
+    int language=112;
+    bool valid() const { return true; }
+    int bitrate() const { return 96; }
+    std::string protection() const { return "EEP 2-A"; }
+};
+struct RadioReceiver {
+    int table=-1;
+    Subchannel subchannel;
+    std::vector<Component> getComponents(const Service&) { return {Component()}; }
+    const Subchannel& getSubchannel(const Component&) { return subchannel; }
+    int getProgrammeTypeTable() const { return table; }
+};
+'''
+test += function("std::string trimLabel(") + "\n" + metadata + "\n" + function("void announceSelectedService(")
+test += r'''
+int main() {
+    RadioReceiver receiver;
+    Service service;
+    SelectedServiceMetadata previous;
+    announceSelectedService(receiver,service,previous);
+    assert(updates.size()==2);
+    assert(updates.back()["pty"]=="-1");
+    assert(updates.back().count("programType")==0);
+    announceSelectedService(receiver,service,previous);
+    assert(updates.size()==2);
+    service.programType=1;
+    announceSelectedService(receiver,service,previous);
+    assert(updates.size()==3 && updates.back()["pty"]=="1");
+    receiver.table=1;
+    announceSelectedService(receiver,service,previous);
+    assert(updates.size()==4 && updates.back()["ptyTable"]=="1");
+    service.programType=24;
+    announceSelectedService(receiver,service,previous);
+    assert(updates.size()==5 && updates.back()["pty"]=="24");
+    service.programType=-1;
+    announceSelectedService(receiver,service,previous);
+    assert(updates.size()==6 && updates.back()["pty"]=="-1");
+    announceSelectedService(receiver,service,previous);
+    assert(updates.size()==6);
+}
+'''
+with tempfile.TemporaryDirectory() as directory:
+    path = Path(directory)
+    (path / "test.cpp").write_text(test)
+    subprocess.run(["g++", "-std=c++17", "-I" + str(root / "src"), str(path / "test.cpp"), "-o", str(path / "test")], check=True)
+    subprocess.run([str(path / "test")], check=True)
+print("RTL production metadata publisher: late/change/unavailable/change-only checks passed")
diff --git a/tests/pty/test_pty.cpp b/tests/pty/test_pty.cpp
new file mode 100644
--- /dev/null
+++ b/tests/pty/test_pty.cpp
@@ -0,0 +1,115 @@
+#include <cassert>
+#include <iostream>
+#include <fstream>
+#include <array>
+#include <chrono>
+#include <mutex>
+#include <unordered_map>
+#include "backend/msc-handler.h"
+#define private public
+#include "backend/fib-processor.h"
+#undef private
+
+struct Controller : RadioControllerInterface {
+    void onSNR(float) override {}
+    void onFrequencyCorrectorChange(int, int) override {}
+    void onSyncChange(char) override {}
+    void onSignalPresence(bool) override {}
+    void onServiceDetected(uint32_t) override {}
+    void onNewEnsemble(uint16_t) override {}
+    void onSetEnsembleLabel(DabLabel&) override {}
+    void onDateTimeUpdate(const dab_date_time_t&) override {}
+    void onFIBDecodeSuccess(bool, const uint8_t*) override {}
+    void onNewImpulseResponse(std::vector<float>&&) override {}
+    void onConstellationPoints(std::vector<DSPCOMPLEX>&&) override {}
+    void onNewNullSymbol(std::vector<DSPCOMPLEX>&&) override {}
+    void onTIIMeasurement(tii_measurement_t&&) override {}
+    void onMessage(message_level_t, const std::string&, const std::string&) override {}
+};
+
+static std::array<uint8_t, 256> bits(std::initializer_list<uint8_t> bytes)
+{
+    std::array<uint8_t, 256> result{};
+    size_t pos=0;
+    for (const auto byte : bytes)
+        for (int bit=7; bit>=0; --bit)
+            result[pos++] = (byte >> bit) & 1;
+    return result;
+}
+
+int main(int argc, char **argv)
+{
+    Controller controller;
+    FIBProcessor decoder(controller);
+    assert(decoder.getProgrammeTypeTable() == -1);
+    auto early = bits({5,17,0x12,1,0,1});
+    decoder.FIG0Extension17(early.data());
+    assert(decoder.programmeTypes.at(0x1201) == 1);
+    assert(decoder.services.empty());
+    // The second FIG 0/2 announces the service, retaining its early PTY.
+    auto service = bits({6,2,0x12,1,1,0x3f,2});
+    decoder.FIG0Extension2(service.data());
+    decoder.FIG0Extension2(service.data());
+    assert(decoder.getService(0x1201).programType == 1);
+    auto table = bits({4,9,0,0xe1,1});
+    decoder.FIG0Extension9(table.data());
+    assert(decoder.getProgrammeTypeTable() == 1);
+    auto change = bits({5,17,0x12,1,0x80,24});
+    decoder.FIG0Extension17(change.data());
+    assert(decoder.getService(0x1201).programType == 24);
+    auto legacy = bits({7,17,0x12,1,0x30,112,14,0});
+    decoder.FIG0Extension17(legacy.data());
+    assert(decoder.getService(0x1201).programType == 14);
+    assert(decoder.getService(0x1201).language == 112);
+    auto truncated = bits({6,17,0x12,1,0x30,112,4});
+    decoder.FIG0Extension17(truncated.data());
+    assert(decoder.getService(0x1201).programType == 14);
+    auto zero = bits({5,17,0x12,1,0,0});
+    decoder.FIG0Extension17(zero.data());
+    assert(decoder.getService(0x1201).programType == 0);
+    decoder.clearEnsemble();
+    assert(decoder.programmeTypes.empty());
+    assert(decoder.getProgrammeTypeTable() == -1);
+    assert(decoder.getService(0x1201).programType == -1);
+    std::cout << "RTL FIG PTY cases passed\n";
+    if (argc == 2) {
+        std::ifstream input(argv[1], std::ios::binary);
+        assert(input);
+        std::array<uint8_t,32> fib{};
+        size_t count=0;
+        while (input.read(reinterpret_cast<char*>(fib.data()), fib.size())) {
+            std::array<uint8_t,256> data{};
+            for (size_t i=0;i<fib.size();++i)
+                for (int bit=7;bit>=0;--bit)
+                    data[i*8+7-bit]=(fib[i]>>bit)&1;
+            size_t offset=0;
+            while (offset<30) {
+                const int length=fib[offset]&31;
+                if (fib[offset]==0xff || offset+length+1>30)
+                    break;
+                if ((fib[offset]>>5)==0 && length) {
+                    const int extension=fib[offset+1]&31;
+                    auto start=data.data()+offset*8;
+                    if (extension==2)
+                        decoder.FIG0Extension2(start);
+                    else if (extension==9)
+                        decoder.FIG0Extension9(start);
+                    else if (extension==17)
+                        decoder.FIG0Extension17(start);
+                }
+                offset+=length+1;
+            }
+            ++count;
+        }
+        const std::vector<std::pair<uint16_t,int>> expected={
+            {0x1201,1},{0x1202,15},{0x1203,14},{0x1204,4},{0x1205,15},
+            {0x1206,9},{0x1207,11},{0x1208,24},{0x1209,28},{0x120a,13},
+            {0x120b,28},{0x120c,12},{0x120d,27},{0x1332,9}
+        };
+        for (const auto &entry:expected) {
+            assert(decoder.getService(entry.first).programType==entry.second);
+        }
+        assert(decoder.getProgrammeTypeTable()==1);
+        std::cout << "ERT: " << count << " FIBs, 14 service PTYs passed\n";
+    }
+}
