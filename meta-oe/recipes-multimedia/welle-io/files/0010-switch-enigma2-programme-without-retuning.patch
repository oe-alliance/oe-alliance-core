         while (running) {
+            struct pollfd commandFd = {};
+            commandFd.fd = controlOpen ? STDIN_FILENO : -1;
+            commandFd.events = POLLIN;
+            if (poll(&commandFd, 1, 100) > 0 && commandFd.revents) {
+                char data[512];
+                const ssize_t length = read(STDIN_FILENO, data, sizeof(data));
+                if (length == 0 || (length < 0 && errno != EINTR && errno != EAGAIN))
+                    controlOpen = false;
+                if (length > 0) for (const auto& command : control.feed(data, length)) {
+                    if (command.select && command.generation > generation) {
+                        // Join the old audio decoder before destroying its callbacks.
+                        // The input, OFDM synchronisation, FIC and packet services stay alive.
+                        if (selected && !receiver.removeServiceToDecode(receiver.getService(options.serviceId))) {
+                            emitMetadata({{"switchError", std::to_string(command.generation)}});
+                            running = 0;
+                            break;
+                        }
+                        programme.reset();
+                        selected = false;
+                        selectedMetadata = SelectedServiceMetadata();
+                        options.serviceId = command.serviceId;
+                        options.cachePrefix = command.cachePrefix;
+                        generation = command.generation;
+                        awaitingStart = true;
+                        announced.clear();
+                        announcedPacketComponents.clear();
+                        // Enigma2 drains the old compressed/PCM pipes before START.
+                        emitMetadata({{"switchReady", std::to_string(generation)}});
+                    }
+                    else if (!command.select && awaitingStart && command.generation == generation) {
+                        emitMetadata({{"switchStarted", std::to_string(generation)}});
+                        awaitingStart = false;
+                    }
+                }
+            }
+            if (!running)
