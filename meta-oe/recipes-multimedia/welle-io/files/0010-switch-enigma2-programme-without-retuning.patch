diff --git a/src/welle-e2/service-control.h b/src/welle-e2/service-control.h
new file mode 100644
--- /dev/null
+++ b/src/welle-e2/service-control.h
@@ -0,0 +1,75 @@
+/* Same-ensemble service selection protocol used by Enigma2. */
+#ifndef WELLE_E2_SERVICE_CONTROL_H
+#define WELLE_E2_SERVICE_CONTROL_H
+
+#include <cerrno>
+#include <cstdint>
+#include <cstdlib>
+#include <sstream>
+#include <string>
+#include <vector>
+
+class ServiceControl
+{
+public:
+    struct Command {
+        bool select = false;
+        uint64_t generation = 0;
+        uint32_t serviceId = 0;
+        std::string cachePrefix;
+    };
+
+    std::vector<Command> feed(const char *data, size_t length)
+    {
+        std::vector<Command> commands;
+        for (size_t index = 0; index < length; ++index) {
+            if (data[index] == '\n') {
+                Command command;
+                if (!overflow && parse(line, command))
+                    commands.push_back(command);
+                line.clear();
+                overflow = false;
+            }
+            else if (!overflow) {
+                if (line.size() == 512) {
+                    line.clear();
+                    overflow = true;
+                }
+                else
+                    line += data[index];
+            }
+        }
+        return commands;
+    }
+
+private:
+    static bool parse(const std::string& line, Command& command)
+    {
+        std::istringstream input(line);
+        std::string action, generation, serviceId, extra;
+        if (!(input >> action >> generation) ||
+                (action != "SELECT" && action != "START") ||
+                generation.empty() || generation.find_first_not_of("0123456789") != std::string::npos)
+            return false;
+        errno = 0;
+        command.generation = std::strtoull(generation.c_str(), nullptr, 10);
+        if (errno == ERANGE || !command.generation)
+            return false;
+        command.select = action == "SELECT";
+        if (command.select) {
+            if (!(input >> serviceId >> command.cachePrefix) || serviceId.empty() || serviceId.size() > 8 ||
+                    serviceId.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos ||
+                    command.cachePrefix.find_first_of("\"\\") != std::string::npos)
+                return false;
+            command.serviceId = std::strtoul(serviceId.c_str(), nullptr, 16);
+            if (!command.serviceId)
+                return false;
+        }
+        return !(input >> extra);
+    }
+
+    std::string line;
+    bool overflow = false;
+};
+
+#endif
