+                        if (component.transportMode() != TransportMode::PacketData)
+                            continue;
+                        const auto& subchannel = receiver.getSubchannel(component);
+                        const uint64_t componentKey =
+                                (static_cast<uint64_t>(component.SCId) << 32) |
+                                (static_cast<uint64_t>(component.DSCTy & 0x3f) << 26) |
+                                (static_cast<uint64_t>(component.subchannelId & 0x3f) << 20) |
+                                static_cast<uint64_t>(component.packetAddress & 0x3ff);
+                        if (announcedPacketComponents.insert(componentKey).second) {
+                            json value;
+                            const std::string label = trimLabel(service.serviceLabel.utf8_label());
+                            value["data_service"] = label.empty() ? hexId(service.serviceId) : label;
+                            value["service_id"] = hexId(service.serviceId);
+                            value["scid"] = std::to_string(component.SCId);
+                            if (component.DSCTy == 60)
+                                value["spi_service"] = value["data_service"];
+                            value["dsc_type"] = std::to_string(component.DSCTy);
+                            value["app_type"] = "7";
+                            value["packet_address"] = std::to_string(component.packetAddress);
+                            value["subchannel"] = std::to_string(component.subchannelId);
+                            value["resolved"] = subchannel.valid() ? "true" : "false";
