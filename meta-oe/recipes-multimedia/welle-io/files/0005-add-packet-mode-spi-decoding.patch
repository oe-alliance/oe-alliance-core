@@ -0,0 +1,103 @@
+/*
+ * Packet-mode MSC subchannel decoder for welle.io.
+ *
+ * Copyright (C) 2026 OpenATV contributors
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "dab-data.h"
+
+#include "eep-protection.h"
+#include "uep-protection.h"
+
+namespace {
+const int16_t interleaveMap[] = {0, 8, 4, 12, 2, 10, 6, 14,
+                                 1, 9, 5, 13, 3, 11, 7, 15};
+}
+
+DabData::DabData(int16_t fragmentSize, int16_t bitRate,
+        ProtectionSettings protection, const DataCallback& callback) :
+    running(true),
+    fragmentSize(fragmentSize),
+    bitRate(bitRate),
+    callback(callback),
+    inputBuffer(64 * 32768)
+{
+    outputBits.resize(bitRate * 24);
+    for (auto& entry : interleaveData)
+        entry.resize(fragmentSize);
+
+    if (protection.shortForm) {
+        protectionHandler.reset(new UEPProtection(bitRate, protection.uepLevel));
+    }
+    else {
+        const bool profileA = protection.eepProfile == EEPProtectionProfile::EEP_A;
+        protectionHandler.reset(new EEPProtection(
+                bitRate, profileA, static_cast<int>(protection.eepLevel)));
+    }
+
+    worker = std::thread(&DabData::run, this);
+}
+
+DabData::~DabData()
+{
+    running = false;
+    dataAvailable.notify_all();
+    if (worker.joinable())
+        worker.join();
+}
+
+int32_t DabData::process(const softbit_t *data, int16_t count)
+{
+    /* Packet carousels repeat. Dropping a CIF is preferable to blocking the
+     * OFDM dispatcher and therefore the selected audio service. */
+    const int32_t available = inputBuffer.GetRingBufferWriteAvailable();
+    if (!running || available < count)
+        return 0;
+    inputBuffer.putDataIntoBuffer(data, count);
+    dataAvailable.notify_one();
+    return available;
+}
+
+void DabData::run()
+{
+    int countForInterleaver = 0;
+    int interleaverIndex = 0;
+    std::vector<softbit_t> input(fragmentSize);
+    std::vector<softbit_t> deinterleaved(fragmentSize);
+    std::vector<uint8_t> bytes(outputBits.size() / 8);
+
+    while (running) {
+        std::unique_lock<std::mutex> lock(mutex);
+        dataAvailable.wait(lock, [this]() {
+            return !running || inputBuffer.GetRingBufferReadAvailable() >= fragmentSize;
+        });
+        if (!running)
+            break;
+        lock.unlock();
+
+        inputBuffer.getDataFromBuffer(input.data(), fragmentSize);
+        for (int index = 0; index < fragmentSize; ++index) {
+            deinterleaved[index] = interleaveData[(interleaverIndex +
+                    interleaveMap[index & 0x0f]) & 0x0f][index];
+            interleaveData[interleaverIndex][index] = input[index];
+        }
+        interleaverIndex = (interleaverIndex + 1) & 0x0f;
+        if (countForInterleaver++ <= 15)
+            continue;
+
+        protectionHandler->deconvolve(
+                deinterleaved.data(), fragmentSize, outputBits.data());
+        energyDispersal.dedisperse(outputBits);
+
+        for (size_t byte = 0; byte < bytes.size(); ++byte) {
+            uint8_t value = 0;
+            for (int bit = 0; bit < 8; ++bit)
+                value = static_cast<uint8_t>((value << 1) |
+                        (outputBits[byte * 8 + bit] & 1));
+            bytes[byte] = value;
+        }
+        if (callback && !bytes.empty())
+            callback(bytes.data(), bytes.size());
+    }
+}
