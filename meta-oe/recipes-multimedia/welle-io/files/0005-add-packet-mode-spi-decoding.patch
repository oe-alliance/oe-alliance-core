+bool MscHandler::addPacketSubchannel(
+        const PacketDataCallback& callback,
+        const Subchannel& sub)
+{
+    std::lock_guard<std::mutex> lock(mutex);
+
+    for (const auto& stream : streams) {
+        if (stream.subCh.subChId == sub.subChId)
+            return true;
+    }
+
+    SelectedStream stream(sub);
+    stream.dabHandler = std::make_shared<DabData>(
+            sub.length * CUSize,
+            sub.bitrate(),
+            sub.protectionSettings,
+            callback);
+    streams.push_back(std::move(stream));
+    work_to_be_done = true;
+    return true;
+}
