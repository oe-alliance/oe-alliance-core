--- a/src/backend/radio-controller.h
+++ b/src/backend/radio-controller.h
@@ -143,6 +143,19 @@ class ProgrammeHandlerInterface {
     public:
         virtual ~ProgrammeHandlerInterface() { }
 
+        /* Some consumers, such as Enigma2, pass the original DAB+ AAC
+         * access units to a hardware decoder.  They do not need the
+         * additional software AAC-to-PCM conversion. */
+        virtual bool needsDecodedAudio(void) const { return true; }
+
+        /* AudioSyncStream (LOAS/LATM) generated directly from the corrected
+         * DAB+ superframe.  The default keeps existing programme handlers
+         * source-compatible. */
+        virtual void onUntouchedStream(const uint8_t* data, size_t len,
+                size_t duration_ms) {
+            (void)data; (void)len; (void)duration_ms;
+        }
+
         /* Count the number of frame errors from the MP2, AAC or data
          * decoder.  */
         virtual void onFrameErrors(int frameErrors) = 0;
