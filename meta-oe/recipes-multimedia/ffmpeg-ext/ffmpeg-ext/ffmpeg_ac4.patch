+/* Compat shims for ffmpeg-ext 6.1.1 libavutil/libavcodec API. */
+static void ff_vector_fmul_reverse_c(float *dst, const float *src0,
+                                      const float *src1, int len)
+{
+    src1 += len - 1;
+    for (int i = 0; i < len; i++)
