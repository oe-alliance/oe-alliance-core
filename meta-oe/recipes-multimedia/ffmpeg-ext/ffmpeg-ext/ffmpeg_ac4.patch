+            //audio_data_ajoc();
+        } else {
+            //audio_data_objs();
+        }
+
+        ret = AVERROR_PATCHWELCOME;
+    }
+    if (ret < 0)
+        return ret;
+
+    align_get_bits(gb);
+    consumed = (get_bits_count(gb) >> 3) - offset;
+    if (consumed > audio_size)
+        av_log(s->avctx, AV_LOG_WARNING, "substream audio data overread: %d\n", consumed - audio_size);
