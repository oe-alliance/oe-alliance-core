+// Vu+ related local variables
+static VUGLES_PlatformHandle vugles_handle = 0;
+
+static unsigned int vuplClientIdFromWindow(EGLNativeWindowType window)
+{
+    if (!window)
+        return 0;
+
+    return VUGLES_GetClientID(reinterpret_cast<void *>(window));
+}
+
+static int vuplPositiveOrFallback(int value, int fallback)
+{
+    return value > 0 ? value : fallback;
+}
+
+static const char *vuplStringOrNull(const GLubyte *value)
+{
+    return value ? reinterpret_cast<const char *>(value) : "(null)";
+}
+
+static bool vuplEnvEnabled(const char *name, bool defaultValue = false)
+{
+    const QByteArray value = qgetenv(name).trimmed().toLower();
+    if (value.isEmpty())
+        return defaultValue;
+
+    return value == "1" || value == "yes" || value == "true" || value == "on" || value == "enabled";
+}
+
+static bool vuplAlphaEnabled()
+{
+    return vuplEnvEnabled("QT_QPA_EGLFS_LIBVUPL_ALPHA", true);
+}
+
+static bool vuplUpdateGeometryEnabled()
+{
+    return vuplEnvEnabled("QT_QPA_EGLFS_LIBVUPL_UPDATE_GEOMETRY", false);
+}
+
+static bool vuplSafeCompositorEnabled()
+{
+    return vuplEnvEnabled("QT_QPA_EGLFS_SAFE_COMPOSITOR", true);
+}
+
+static bool vuplSetVisibleEnabled()
+{
+    return vuplEnvEnabled("QT_QPA_EGLFS_LIBVUPL_SET_VISIBLE", false);
+}
+
+static void vuplApplyNativeWindowInfo(EGLNativeWindowType window,
+                                      unsigned int clientId,
+                                      const QRect &rect,
+                                      const char *reason)
+{
+    if (!window || !clientId)
+        return;
+
+    VUGLES_NativeWindowInfo win_info;
+    VUGLES_GetDefaultNativeWindowInfo(&win_info);
+    win_info.clientID = clientId;
+    win_info.x = rect.x();
+    win_info.y = rect.y();
+    win_info.width = vuplPositiveOrFallback(rect.width(), 1);
+    win_info.height = vuplPositiveOrFallback(rect.height(), 1);
+
+    fprintf(stderr, "[eglfs_libvupl] VUGLES_UpdateNativeWindow client=%u reason=%s x=%d y=%d w=%d h=%d\n",
+            clientId, reason, win_info.x, win_info.y, win_info.width, win_info.height);
+    VUGLES_UpdateNativeWindow(reinterpret_cast<void *>(window), &win_info);
+
+    vuRect vuRectValue;
+    vuRectValue.x = win_info.x;
+    vuRectValue.y = win_info.y;
+    vuRectValue.width = win_info.width;
+    vuRectValue.height = win_info.height;
+
+    VUGLES_SetPosition(clientId, vuRectValue, true);
+}
+
+QSize QEglFSlibvuplIntegration::screenSize() const
+{
+    return mScreenSize;
+}
+
+int QEglFSlibvuplIntegration::screenDepth() const
+{
+    return 32;
+}
+
+QImage::Format QEglFSlibvuplIntegration::screenFormat() const
+{
+    return vuplAlphaEnabled() ? QImage::Format_ARGB32 : QImage::Format_RGB32;
+}
+
+qreal QEglFSlibvuplIntegration::refreshRate() const
+{
+    return 50;
+}
+
+QSurfaceFormat QEglFSlibvuplIntegration::surfaceFormatFor(const QSurfaceFormat &inputFormat) const
+{
+    QSurfaceFormat format = inputFormat;
+    format.setAlphaBufferSize(vuplAlphaEnabled() ? 8 : 0);
+    format.setRedBufferSize(8);
+    format.setGreenBufferSize(8);
+    format.setBlueBufferSize(8);
+    return format;
+}
+
+void QEglFSlibvuplIntegration::platformInit()
+{
+    printf("DEBUG %s %s %d\n", __FILE__, __FUNCTION__, __LINE__);
+    fprintf(stderr, "[eglfs_libvupl] build id openhbbtv-v21-alpha-keep-visible-20260612\n");
+    fprintf(stderr, "[eglfs_libvupl] settings alpha=%d update_geometry=%d safe_compositor=%d set_visible=%d\n",
+            vuplAlphaEnabled() ? 1 : 0,
+            vuplUpdateGeometryEnabled() ? 1 : 0,
+            vuplSafeCompositorEnabled() ? 1 : 0,
+            vuplSetVisibleEnabled() ? 1 : 0);
+
+    QList<QByteArray> env = qgetenv("EGLFS_LIBVUPL_SIZE").split('x');
+    if (env.length() == 2) {
+        const int width = env.at(0).toInt();
+        const int height = env.at(1).toInt();
+        if (width > 0 && height > 0)
+            mScreenSize = QSize(width, height);
+    }
+
+    if (!mScreenSize.isValid())
+        mScreenSize = QSize(1920, 1080);
+
+    float aspect = 1.0f;
+
+    vuInitResult res = VUGLES_InitPlatformAndDefaultDisplay("EGLFS", &aspect,
+                            mScreenSize.width(),  mScreenSize.height());
+    if (res != vuInitSuccess) {
+        fprintf(stderr, "[eglfs_libvupl] VUGLES_InitPlatformAndDefaultDisplay failed: %d\n", int(res));
+        return;
+    }
+
+    printf("DEBUG %s %s %d\n", __FILE__, __FUNCTION__, __LINE__);
+
+    VUGLES_RegisterDisplayPlatform(&vugles_handle);
+
+    printf("DEBUG %s %s %d\n", __FILE__, __FUNCTION__, __LINE__);
+}
+
+void QEglFSlibvuplIntegration::platformDestroy()
+{
+    printf("DEBUG %s %s %d\n", __FILE__, __FUNCTION__, __LINE__);
+    VUGLES_UnregisterDisplayPlatform(vugles_handle);
+    VUGLES_TermPlatform();
+    printf("DEBUG %s %s %d\n", __FILE__, __FUNCTION__, __LINE__);
+}
+
+EGLDisplay QEglFSlibvuplIntegration::createDisplay(EGLNativeDisplayType nativeDisplay)
+{
+    Q_UNUSED(nativeDisplay);
+
+    printf("DEBUG %s %s %d\n", __FILE__, __FUNCTION__, __LINE__);
+    EGLDisplay display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (display == EGL_NO_DISPLAY) {
+       printf("DEBUG EGL_FALSE %s %s %d\n", __FILE__, __FUNCTION__, __LINE__);
+       return EGL_NO_DISPLAY;
+    }
+    printf("DEBUG %s %s %d\n", __FILE__, __FUNCTION__, __LINE__);
+
+    return display;
+}
+
+EGLNativeDisplayType QEglFSlibvuplIntegration::platformDisplay() const
+{
+    return EGL_DEFAULT_DISPLAY;
+}
+
+EGLNativeWindowType QEglFSlibvuplIntegration::createNativeWindow(QPlatformWindow *platformWindow,
+                                                       const QSize &size,
+                                                       const QSurfaceFormat &format)
+{
+    Q_UNUSED(platformWindow);
+    Q_UNUSED(format);
+
+    void *native_window = 0;
+
+    VUGLES_NativeWindowInfo win_info;
+    printf("DEBUG %s %s %d\n", __FILE__, __FUNCTION__, __LINE__);
+    VUGLES_GetDefaultNativeWindowInfo(&win_info);
+    printf("DEBUG %s %s %d\n", __FILE__, __FUNCTION__, __LINE__);
+
+    const int screenWidth = vuplPositiveOrFallback(mScreenSize.width(), 1920);
+    const int screenHeight = vuplPositiveOrFallback(mScreenSize.height(), 1080);
+    const int windowWidth = vuplPositiveOrFallback(size.width(), screenWidth);
+    const int windowHeight = vuplPositiveOrFallback(size.height(), screenHeight);
+
+    printf("DEBUG %s %s win_info %d %d screen %d %d\n", __FILE__, __FUNCTION__, windowWidth, windowHeight, screenWidth, screenHeight);
+
+    win_info.width = windowWidth;
+    win_info.height = windowHeight;
+    win_info.x = 0;
+    win_info.y = 0;
+
+    printf("DEBUG %s %s %d\n", __FILE__, __FUNCTION__, __LINE__);
+    native_window = VUGLES_CreateNativeWindow(&win_info);
+    printf("DEBUG %s %s %d\n", __FILE__, __FUNCTION__, __LINE__);
+    if (native_window == NULL)
+        return EGL_FALSE;
+
+    win_info.clientID = VUGLES_GetClientID(native_window);
+    fprintf(stderr, "%26s ---------------\n", "--------------------------");
+    fprintf(stderr, "%26s #%d\n", "dvb_client", win_info.clientID);
+
+    fprintf(stderr, "%26s ---------------\n", "------- EGL INFO ---------");
+    EGLDisplay display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    fprintf(stderr, "%26s %s\n", "egl vendor", eglQueryString(display, EGL_VENDOR));
+    fprintf(stderr, "%26s %s\n", "egl version", eglQueryString(display, EGL_VERSION));
+    fprintf(stderr, "%26s ---------------\n", "------- GL INFO ----------");
+    if (eglGetCurrentContext() != EGL_NO_CONTEXT) {
+        fprintf(stderr, "%26s %s\n", "vendor", vuplStringOrNull(glGetString(GL_VENDOR)));
+        fprintf(stderr, "%26s %s\n", "renderer", vuplStringOrNull(glGetString(GL_RENDERER)));
+        fprintf(stderr, "%26s %s\n", "version", vuplStringOrNull(glGetString(GL_VERSION)));
+        fprintf(stderr, "%26s %s\n", "shading language version", vuplStringOrNull(glGetString(GL_SHADING_LANGUAGE_VERSION)));
+    } else {
+        fprintf(stderr, "%26s %s\n", "context", "not current yet");
+    }
+    fprintf(stderr, "%26s ---------------\n", "--------------------------");
+
+    vuRect rect = {
+        (screenWidth - windowWidth) / 2,
+        (screenHeight - windowHeight) / 2,
+        windowWidth,
+        windowHeight
+    };
+
+    fprintf(stderr, "[eglfs_libvupl] create native window client=%u x=%d y=%d w=%d h=%d screen=%dx%d\n",
+            win_info.clientID, rect.x, rect.y, rect.width, rect.height, screenWidth, screenHeight);
+    VUGLES_SetPosition(win_info.clientID, rect, true);
+    if (vuplSetVisibleEnabled()) {
+        fprintf(stderr, "[eglfs_libvupl] VUGLES_SetVisible create client=%u visible=1\n", win_info.clientID);
+        VUGLES_SetVisible(win_info.clientID, true);
+    } else {
+        fprintf(stderr, "[eglfs_libvupl] keep native window compositor-visible client=%u create\n", win_info.clientID);
+    }
+
+    return (EGLNativeWindowType) native_window;
+}
+
+void QEglFSlibvuplIntegration::destroyNativeWindow(EGLNativeWindowType window)
+{
+    const unsigned int clientId = vuplClientIdFromWindow(window);
+    if (clientId && vuplSetVisibleEnabled()) {
+        fprintf(stderr, "[eglfs_libvupl] destroy native window client=%u\n", clientId);
+        VUGLES_SetVisible(clientId, false);
+    } else if (clientId) {
+        fprintf(stderr, "[eglfs_libvupl] destroy native window client=%u without VUGLES_SetVisible\n", clientId);
+    }
+
+    VUGLES_DestroyNativeWindow((void*)window);
+}
+
+void QEglFSlibvuplIntegration::setNativeWindowVisible(EGLNativeWindowType window, bool visible)
+{
+    const unsigned int clientId = vuplClientIdFromWindow(window);
+    if (!clientId)
+        return;
+
+    if (!vuplSetVisibleEnabled()) {
+        fprintf(stderr, "[eglfs_libvupl] ignore Qt native window visible client=%u visible=%d\n",
+                clientId, visible ? 1 : 0);
+        return;
+    }
+
+    fprintf(stderr, "[eglfs_libvupl] VUGLES_SetVisible client=%u visible=%d\n", clientId, visible ? 1 : 0);
+    VUGLES_SetVisible(clientId, visible);
+}
+
+void QEglFSlibvuplIntegration::setNativeWindowGeometry(EGLNativeWindowType window, const QRect &rect)
+{
+    const unsigned int clientId = vuplClientIdFromWindow(window);
+    if (!clientId)
+        return;
+
+    fprintf(stderr, "[eglfs_libvupl] VUGLES_SetPosition client=%u x=%d y=%d w=%d h=%d\n",
+            clientId, rect.x(), rect.y(), rect.width(), rect.height());
+
+    if (vuplUpdateGeometryEnabled()) {
+        vuplApplyNativeWindowInfo(window, clientId, rect, "geometry");
+        return;
+    }
+
+    vuRect vuRectValue;
+    vuRectValue.x = rect.x();
+    vuRectValue.y = rect.y();
+    vuRectValue.width = vuplPositiveOrFallback(rect.width(), 1);
+    vuRectValue.height = vuplPositiveOrFallback(rect.height(), 1);
+    VUGLES_SetPosition(clientId, vuRectValue, true);
+}
+
+bool QEglFSlibvuplIntegration::hasCapability(QPlatformIntegration::Capability cap) const
+{
+    if (vuplSafeCompositorEnabled()) {
+        switch (cap) {
+        case QPlatformIntegration::ThreadedOpenGL:
+        case QPlatformIntegration::BufferQueueingOpenGL:
+        case QPlatformIntegration::RasterGLSurface:
+        case QPlatformIntegration::OpenGLOnRasterSurface:
+            return false;
+        default:
+            break;
+        }
+    }
+
+    switch (cap) {
+    case QPlatformIntegration::ThreadedPixmaps:
+    case QPlatformIntegration::OpenGL:
+        return true;
+    default:
+        return false;
+    }
+}
+
+QT_END_NAMESPACE
