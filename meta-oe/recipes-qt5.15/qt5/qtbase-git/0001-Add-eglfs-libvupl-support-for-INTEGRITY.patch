+static bool eglfsEnvEnabled(const char *name, bool defaultValue = false)
+{
+    const QByteArray value = qgetenv(name).trimmed().toLower();
+    if (value.isEmpty())
+        return defaultValue;
+
+    return value == "1" || value == "yes" || value == "true" || value == "on" || value == "enabled";
+}
+
+static bool eglfsSafeCompositorEnabled()
+{
+    const QByteArray safeValue = qgetenv("QT_QPA_EGLFS_SAFE_COMPOSITOR").trimmed().toLower();
+    if (!safeValue.isEmpty())
+        return eglfsEnvEnabled("QT_QPA_EGLFS_SAFE_COMPOSITOR", false);
+
+    const QByteArray integration = qgetenv("QT_QPA_EGLFS_INTEGRATION").trimmed().toLower();
+    return integration == "eglfs_libvupl";
+}
+
 bool QEglFSIntegration::hasCapability(QPlatformIntegration::Capability cap) const
 {
+    static const bool safeCompositor = eglfsSafeCompositorEnabled();
+    if (safeCompositor) {
+        switch (cap) {
+        case ThreadedOpenGL:
+        case BufferQueueingOpenGL:
+        case RasterGLSurface:
+        case OpenGLOnRasterSurface:
+            return false;
+        default:
+            break;
+        }
+    }
+
     // We assume that devices will have more and not less capabilities
     if (qt_egl_device_integration()->hasCapability(cap))
         return true;
