 #endif
 
+int opkg_check_picon_storage(pkg_t *pkg);
+
 int opkg_install_pkg(pkg_t * pkg, pkg_t * old_pkg);
 
 #ifdef __cplusplus
diff --git a/libopkg/opkg_install.c b/libopkg/opkg_install.c
