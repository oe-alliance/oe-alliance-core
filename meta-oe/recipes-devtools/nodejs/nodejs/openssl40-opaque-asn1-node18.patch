From: OpenATV <openatv@opena.tv>
Subject: [PATCH] fix build with OpenSSL 4.0 (opaque ASN1 types)

OpenSSL 4.0 makes ASN1_STRING and derived types opaque. Replace direct
struct member access with accessor functions. Fix const correctness for
X509_EXTENSION, X509_NAME, and X509_NAME_ENTRY pointers.

Upstream-Status: Inappropriate [OE specific]

--- a/src/crypto/crypto_common.cc	2026-05-04 16:29:37.973541451 +0200
+++ b/src/crypto/crypto_common.cc	2026-05-04 16:29:53.172724726 +0200
@@ -670,14 +670,14 @@
 static inline void PrintLatin1AltName(const BIOPointer& out,
                                       const ASN1_IA5STRING* name,
                                       const char* safe_prefix = nullptr) {
-  PrintAltName(out, reinterpret_cast<const char*>(name->data), name->length,
+  PrintAltName(out, reinterpret_cast<const char*>(ASN1_STRING_get0_data(name)), ASN1_STRING_length(name),
                false, safe_prefix);
 }
 
 static inline void PrintUtf8AltName(const BIOPointer& out,
                                     const ASN1_UTF8STRING* name,
                                     const char* safe_prefix = nullptr) {
-  PrintAltName(out, reinterpret_cast<const char*>(name->data), name->length,
+  PrintAltName(out, reinterpret_cast<const char*>(ASN1_STRING_get0_data(name)), ASN1_STRING_length(name),
                true, safe_prefix);
 }
 
@@ -733,17 +733,17 @@
   } else if (gen->type == GEN_IPADD) {
     BIO_printf(out.get(), "IP Address:");
     const ASN1_OCTET_STRING* ip = gen->d.ip;
-    const unsigned char* b = ip->data;
-    if (ip->length == 4) {
+    const unsigned char* b = ASN1_STRING_get0_data(ip);
+    if (ASN1_STRING_length(ip) == 4) {
       BIO_printf(out.get(), "%d.%d.%d.%d", b[0], b[1], b[2], b[3]);
-    } else if (ip->length == 16) {
+    } else if (ASN1_STRING_length(ip) == 16) {
       for (unsigned int j = 0; j < 8; j++) {
         uint16_t pair = (b[2 * j] << 8) | b[2 * j + 1];
         BIO_printf(out.get(), (j == 0) ? "%X" : ":%X", pair);
       }
     } else {
 #if OPENSSL_VERSION_MAJOR >= 3
-      BIO_printf(out.get(), "<invalid length=%d>", ip->length);
+      BIO_printf(out.get(), "<invalid length=%d>", ASN1_STRING_length(ip));
 #else
       BIO_printf(out.get(), "<invalid>");
 #endif
