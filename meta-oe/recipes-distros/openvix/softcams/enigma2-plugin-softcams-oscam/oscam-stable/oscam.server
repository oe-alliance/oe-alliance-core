
[reader]
label                         = CCcam-server
enable			      = 0
protocol                      = cccam
device                        = ip_adress_server,12000
user                          = user
password                      = pass
fallback                      = 1
group                         = 1
ccckeepalive                  = 1

[reader]
label                         = line_camd3
enable                        = 0
protocol                      = cs357x
device                        = ip_adress_server,35000
user                          = user
password                      = password
group                         = 1

[reader]
label                         = line_newcamd
enable                        = 0
protocol                      = newcamd
device                        = ip_adress_server,35000
key                           = 0102030405060708091011121314
user                          = user
password                      = password
fallback                      = 1
group                         = 1

[reader]
label                         = keyfile
enable                        = 0
protocol                      = constcw
device                        = /etc/tuxbox/config/constant.cw
group                         = 1
