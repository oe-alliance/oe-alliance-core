#!/bin/sh
STAMP="/var/lib/fstrim.last"
LOGTAG="fstrim"
NOW="$(date +%s)"

LAST=0
if [ -f "$STAMP" ]; then
    LAST="$(cat "$STAMP" 2>/dev/null)"
    case "$LAST" in
        ''|*[!0-9]*) LAST=0 ;;
    esac
fi

if [ $((NOW - LAST)) -lt 604800 ]; then
    exit 0
fi

/usr/sbin/fstrim-all 2>&1 | logger -t "$LOGTAG"
echo "$NOW" > "$STAMP"
exit 0
