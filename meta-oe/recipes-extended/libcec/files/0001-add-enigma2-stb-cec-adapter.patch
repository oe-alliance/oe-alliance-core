diff --git a/src/libcec/adapter/STB/STBCECAdapterCommunication.cpp b/src/libcec/adapter/STB/STBCECAdapterCommunication.cpp
new file mode 100644
index 0000000..13890e8
--- /dev/null
+++ b/src/libcec/adapter/STB/STBCECAdapterCommunication.cpp
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "STBCECAdapterCommunication.h"
+#if defined(HAVE_STB_API)
+#include "STBCECProtocol.h"
+#include "LibCEC.h"
+#include <cerrno>
+#include <chrono>
+#include <cstring>
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+using namespace CEC;
+using namespace CEC::STBCEC;
+
+bool CSTBCECAdapterCommunication::IsDevicePath(const std::string &path)
+{
+  if (path != "/dev/hdmi_cec" && path != "/dev/misc/hdmi_cec0")
+    return false;
+  struct stat st;
+  // Detection must not open/flush a queue that Enigma2 may still own.
+  return stat(path.c_str(), &st) == 0 && S_ISCHR(st.st_mode);
+}
+
+CSTBCECAdapterCommunication::CSTBCECAdapterCommunication(
+    IAdapterCommunicationCallback *callback, const std::string &path) :
+  IAdapterCommunication(callback), m_path(path), m_dream(path == "/dev/misc/hdmi_cec0")
+{
+}
+
+bool CSTBCECAdapterCommunication::Open(uint32_t, bool, bool startListening)
+{
+  Close();
+  if (!IsDevicePath(m_path))
+    return false;
+  m_fd = open(m_path.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC);
+  m_failed = false;
+  if (m_fd < 0 || !RefreshAddress() || (startListening && !Flush()))
+  {
+    m_callback->GetLib()->AddLog(CEC_LOG_ERROR, "STB CEC: cannot open %s: %s",
+                                m_path.c_str(), strerror(errno));
+    Close();
+    return false;
+  }
+  m_callback->GetLib()->AddLog(CEC_LOG_NOTICE,
+      "STB CEC: %s, driver-owned logical address %X, physical address %04X; no poll ACK API",
+      m_path.c_str(), static_cast<int>(m_logical.load()), m_physical.load());
+  m_stop = false;
+  m_reportedLogical = m_logical;
+  m_reportedPhysical = m_physical;
+  if (startListening)
+    m_reader = std::thread(&CSTBCECAdapterCommunication::Process, this);
+  return true;
+}
+
+void CSTBCECAdapterCommunication::Close(void)
+{
+  m_stop = true;
+  if (m_reader.joinable())
+    m_reader.join();
+  std::lock_guard<std::mutex> lock(m_writeMutex);
+  const int fd = m_fd.exchange(-1);
+  if (fd >= 0)
+    close(fd);
+  // Do not clear the driver's address or send Standby on handover to Enigma2.
+  m_logical = CECDEVICE_UNKNOWN;
+  m_physical = CEC_INVALID_PHYSICAL_ADDRESS;
+}
+
+bool CSTBCECAdapterCommunication::Flush(void)
+{
+  unsigned int clear = 0;
+  return (m_dream ? ioctl(m_fd, 4, &clear) : ioctl(m_fd, 0)) >= 0;
+}
+
+bool CSTBCECAdapterCommunication::RefreshAddress(void)
+{
+  BcmAddress address{};
+  if (m_dream)
+  {
+    DreamAddress dream{};
+    if (ioctl(m_fd, 1, &dream) < 0)
+      return false;
+    address.logical = dream.logical;
+    memcpy(address.physical, dream.physical, 2);
+  }
+  else if (ioctl(m_fd, 1, &address) < 0)
+    return false;
+  if (!IsLogicalAddress(address.logical))
+    return false;
+  const cec_logical_address logical = static_cast<cec_logical_address>(address.logical);
+  const uint16_t physical = (address.physical[0] << 8) | address.physical[1];
+  m_logical = logical;
+  m_physical = physical;
+  return true;
+}
+
+void CSTBCECAdapterCommunication::ProcessEvents(void)
+{
+  const cec_logical_address logical = m_logical;
+  const uint16_t physical = m_physical;
+  if (m_stop || logical == CECDEVICE_UNKNOWN)
+    return;
+  if (m_reportedLogical != logical)
+  {
+    const cec_logical_address previous = m_reportedLogical;
+    m_reportedLogical = logical;
+    m_callback->HandleLogicalAddressLost(previous);
+  }
+  if (m_reportedPhysical != physical)
+  {
+    m_reportedPhysical = physical;
+    m_callback->HandlePhysicalAddressChanged(physical);
+  }
+}
+
+cec_logical_addresses CSTBCECAdapterCommunication::GetLogicalAddresses(void) const
+{
+  cec_logical_addresses addresses;
+  addresses.Clear();
+  if (m_logical != CECDEVICE_UNKNOWN)
+    addresses.Set(m_logical);
+  return addresses;
+}
+
+bool CSTBCECAdapterCommunication::SetLogicalAddresses(const cec_logical_addresses &addresses)
+{
+  // Clearing libCEC's client map must not unregister the kernel-owned address.
+  if (addresses.IsEmpty())
+    return true;
+  const cec_logical_address logical = m_logical;
+  if (logical == CECDEVICE_UNKNOWN)
+    return false;
+  for (int i = 0; i < 16; ++i)
+    if (addresses.IsSet(static_cast<cec_logical_address>(i)) && i != logical)
+      return false;
+  return addresses.IsSet(logical);
+}
+
+cec_adapter_message_state CSTBCECAdapterCommunication::Write(
+    const cec_command &data, bool &retry, uint8_t, bool)
+{
+  retry = false;
+  if (!data.opcode_set || data.parameters.size > 14 ||
+      data.destination < CECDEVICE_TV || data.destination > CECDEVICE_BROADCAST ||
+      !SupportsSourceLogicalAddress(data.initiator))
+    return ADAPTER_MESSAGE_STATE_ERROR;
+  std::lock_guard<std::mutex> lock(m_writeMutex);
+  if (!IsOpen())
+    return ADAPTER_MESSAGE_STATE_ERROR;
+  BcmMessage message{};
+  message.address = data.destination;
+  message.length = data.parameters.size + 1;
+  message.data[0] = data.opcode;
+  memcpy(message.data + 1, data.parameters.data, data.parameters.size);
+  int result;
+  if (m_dream)
+  {
+    DreamTx dream{};
+    dream.address = message.address;
+    dream.length = message.length;
+    dream.flag = 1;
+    memcpy(dream.data, message.data, message.length);
+    result = ioctl(m_fd, 3, &dream);
+    if (result >= 0)
+      return ADAPTER_MESSAGE_STATE_SENT;
+  }
+  else
+  {
+    result = write(m_fd, &message, message.length + 2);
+    if (result == message.length + 2)
+      return ADAPTER_MESSAGE_STATE_SENT;
+  }
+  // There is no ACK result in either ABI. Never report SENT_ACKED or infer
+  // device presence from a successful write, especially for address polls.
+  m_callback->GetLib()->AddLog(CEC_LOG_WARNING, "STB CEC: transmit failed (%d): %s",
+                              result, result < 0 ? strerror(errno) : "short write");
+  return ADAPTER_MESSAGE_STATE_ERROR;
+}
+
+bool CSTBCECAdapterCommunication::ReadExact(uint8_t *buffer, size_t length)
+{
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(200);
+  size_t offset = 0;
+  while (offset < length && !m_stop)
+  {
+    const ssize_t count = read(m_fd, buffer + offset, length - offset);
+    if (count > 0)
+      offset += count;
+    else if (count == 0 || (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR))
+      return false;
+    if (std::chrono::steady_clock::now() >= deadline)
+      return false;
+    if (count < 0)
+    {
+      pollfd event{m_fd, POLLIN, 0};
+      poll(&event, 1, 10);
+    }
+  }
+  return offset == length;
+}
+
+void CSTBCECAdapterCommunication::Receive(void)
+{
+  cec_command command;
+  bool valid = false;
+  if (m_dream)
+  {
+    DreamRx message{};
+    if (ioctl(m_fd, 2, &message) < 0)
+      return;
+    Flush();
+    valid = Decode(message.address, message.destination, message.data, message.length, command);
+  }
+  else
+  {
+    BcmMessage message{};
+    if (!ReadExact(reinterpret_cast<uint8_t *>(&message), 2) ||
+        !ReadExact(message.data, message.length))
+    {
+      Flush();
+      return;
+    }
+    const uint8_t destination = IsBroadcastOpcode(message.data[0]) ?
+        static_cast<uint8_t>(CECDEVICE_BROADCAST) : static_cast<uint8_t>(m_logical.load());
+    valid = Decode(message.address, destination, message.data, message.length, command);
+  }
+  if (valid)
+    m_callback->OnCommandReceived(command);
+}
+
+void CSTBCECAdapterCommunication::Process(void)
+{
+  auto addressCheck = std::chrono::steady_clock::now();
+  while (!m_stop)
+  {
+    pollfd event{m_fd, POLLIN | POLLPRI, 0};
+    const int result = poll(&event, 1, 250);
+    if (m_stop)
+      break;
+    if ((result < 0 && errno != EINTR) || (event.revents & (POLLERR | POLLHUP | POLLNVAL)))
+    {
+      m_failed = true;
+      m_callback->GetLib()->AddLog(CEC_LOG_ERROR, "STB CEC: device disconnected");
+      break;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if ((event.revents & POLLPRI) || now >= addressCheck)
+    {
+      RefreshAddress();
+      addressCheck = now + std::chrono::seconds(1);
+    }
+    if (event.revents & POLLIN)
+      Receive();
+  }
+}
+#endif
