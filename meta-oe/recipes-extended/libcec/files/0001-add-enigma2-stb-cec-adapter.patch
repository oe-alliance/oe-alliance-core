diff --git a/src/libcec/adapter/STB/STBCECProtocol.h b/src/libcec/adapter/STB/STBCECProtocol.h
new file mode 100644
index 0000000..2f92088
--- /dev/null
+++ b/src/libcec/adapter/STB/STBCECProtocol.h
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include "cectypes.h"
+#include <cstddef>
+#include <cstdint>
+
+namespace CEC
+{
+namespace STBCEC
+{
+// These are the two different legacy Enigma2 driver ABIs, not linux/cec.h.
+struct BcmAddress { uint8_t logical, physical[2], type; };
+struct DreamAddress { uint8_t physical[2], logical, type; };
+struct BcmMessage { uint8_t address, length, data[256]; };
+struct DreamTx { uint8_t address, data[16], length, flag; };
+struct DreamRx { uint8_t address, destination, data[16], length; };
+static_assert(sizeof(BcmAddress) == 4 && sizeof(DreamAddress) == 4, "CEC address ABI");
+static_assert(sizeof(BcmMessage) == 258 && sizeof(DreamTx) == 19 &&
+              sizeof(DreamRx) == 19, "CEC message ABI");
+
+inline bool IsLogicalAddress(uint8_t address)
+{
+  return address > CECDEVICE_TV && address < CECDEVICE_BROADCAST;
+}
+
+inline bool IsBroadcastOpcode(uint8_t opcode)
+{
+  // The BCM receive ABI discards the destination nibble. Directed messages
+  // delivered by its address filter belong to us; infer mandatory broadcasts.
+  switch (opcode)
+  {
+    case 0x32: // Set Menu Language
+    case 0x72: // Set System Audio Mode (also valid as a direct reply)
+    case 0x80: // Routing Change
+    case 0x81: // Routing Information
+    case 0x82: // Active Source
+    case 0x84: // Report Physical Address
+    case 0x85: // Request Active Source
+    case 0x86: // Set Stream Path
+    case 0x87: // Device Vendor ID
+    case 0xa6: // Report Features
+    case 0xa7: // Request Current Latency
+    case 0xa8: // Report Current Latency
+    case 0xf8: // CDC Message
+      return true;
+    default:
+      return false;
+  }
+}
+
+inline bool Decode(uint8_t initiator, uint8_t destination, const uint8_t *payload,
+                   size_t length, cec_command &command)
+{
+  if (initiator > 15 || destination > 15 || length == 0 || length > 15)
+    return false;
+  cec_command::Format(command, static_cast<cec_logical_address>(initiator),
+                      static_cast<cec_logical_address>(destination),
+                      static_cast<cec_opcode>(payload[0]));
+  for (size_t i = 1; i < length; ++i)
+    command.parameters.PushBack(payload[i]);
+  return true;
+}
+}
+}
