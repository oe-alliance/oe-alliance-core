+namespace CEC
+{
+class CSTBCECAdapterCommunication : public IAdapterCommunication
+{
+public:
+  static bool IsDevicePath(const std::string &path);
+  CSTBCECAdapterCommunication(IAdapterCommunicationCallback *callback, const std::string &path);
+  ~CSTBCECAdapterCommunication(void) override { Close(); }
+
+  bool Open(uint32_t timeout = CEC_DEFAULT_CONNECT_TIMEOUT, bool skipChecks = false,
+            bool startListening = true) override;
+  void Close(void) override;
+  bool IsOpen(void) override { return m_fd >= 0 && !m_failed; }
+  cec_adapter_message_state Write(const cec_command &data, bool &retry,
+                                 uint8_t lineTimeout, bool isReply) override;
+  bool SetLineTimeout(uint8_t) override { return true; }
+  bool StartBootloader(void) override { return false; }
+  bool SetLogicalAddresses(const cec_logical_addresses &addresses) override;
+  cec_logical_addresses GetLogicalAddresses(void) const override;
+  cec_logical_address GetFixedLogicalAddress(void) const override { return m_logical; }
+  bool SupportsPolling(void) const override { return false; }
+  void ProcessEvents(void) override;
+  bool PingAdapter(void) override { return IsOpen(); }
+  uint16_t GetFirmwareVersion(void) override { return 0; }
+  uint32_t GetFirmwareBuildDate(void) override { return 0; }
+  bool IsRunningLatestFirmware(void) override { return true; }
+  bool SetControlledMode(bool) override { return true; }
+  bool SaveConfiguration(const libcec_configuration &) override { return false; }
+  bool SetAutoMode(bool) override { return false; }
+  bool GetConfiguration(libcec_configuration &) override { return false; }
+  std::string GetPortName(void) override { return m_path; }
+  uint16_t GetPhysicalAddress(void) override { return m_physical; }
+  cec_vendor_id GetVendorId(void) override { return CEC_VENDOR_UNKNOWN; }
+  bool SupportsSourceLogicalAddress(cec_logical_address address) override
+  { return address == m_logical && address != CECDEVICE_UNKNOWN; }
+  cec_adapter_type GetAdapterType(void) override { return ADAPTERTYPE_STB; }
+  uint16_t GetAdapterVendorId(void) const override { return 0; }
+  uint16_t GetAdapterProductId(void) const override { return 0; }
+  void SetActiveSource(bool, bool) override {}
+  bool GetStats(cec_adapter_stats *) override { return false; }
+
+private:
+  bool RefreshAddress(void);
+  bool Flush(void);
+  bool ReadExact(uint8_t *buffer, size_t length);
+  void Receive(void);
+  void Process(void);
+
+  const std::string m_path;
+  const bool m_dream;
+  std::atomic<int> m_fd{-1};
+  std::atomic<bool> m_stop{false};
+  std::atomic<bool> m_failed{false};
+  std::atomic<cec_logical_address> m_logical{CECDEVICE_UNKNOWN};
+  std::atomic<uint16_t> m_physical{CEC_INVALID_PHYSICAL_ADDRESS};
+  cec_logical_address m_reportedLogical{CECDEVICE_UNKNOWN};
+  uint16_t m_reportedPhysical{CEC_INVALID_PHYSICAL_ADDRESS};
+  std::mutex m_writeMutex;
+  std::thread m_reader;
+};
+}
