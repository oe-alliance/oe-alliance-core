--- a/kernel/reboot.c
+++ b/kernel/reboot.c
@@ -203,6 +203,14 @@
 	set_cpus_allowed_ptr(current, cpumask_of(cpu));
 }
 
+static void (*suspend_for_reboot)(void);
+
+void kernel_set_callback_for_reboot(void (*callback)(void))
+{
+	suspend_for_reboot = callback;
+}
+EXPORT_SYMBOL_GPL(kernel_set_callback_for_reboot);
+
 /**
  *	kernel_restart - reboot the system
  *	@cmd: pointer to buffer containing command to execute for restart
@@ -213,6 +221,16 @@
  */
 void kernel_restart(char *cmd)
 {
+	if (suspend_for_reboot) {
+		int ret;
+
+		/* Suspend must sync and suspend devices before device_shutdown(). */
+		pr_emerg("Restarting system through standby\n");
+		suspend_for_reboot();
+		ret = pm_suspend(PM_SUSPEND_STANDBY);
+		pr_emerg("Standby restart returned (%d), using normal restart\n", ret);
+	}
+
 	kernel_restart_prepare(cmd);
 	migrate_to_reboot_cpu();
 	syscore_shutdown();
