From fb0a23e576752a84d2249d3578177f757f9ee14d Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sun, 30 Aug 2026 13:25:21 +0200
Subject: [PATCH] media: complete legacy m88rs6060 regmap shim

---
 drivers/media/dvb-frontends/m88rs6060.c | 36 ++++++++++++++++++++++---
 1 file changed, 32 insertions(+), 4 deletions(-)

diff --git a/drivers/media/dvb-frontends/m88rs6060.c b/drivers/media/dvb-frontends/m88rs6060.c
index ce08023..44b9c26 100644
--- a/drivers/media/dvb-frontends/m88rs6060.c
+++ b/drivers/media/dvb-frontends/m88rs6060.c
@@ -119,18 +119,45 @@ static int tbs_regmap_write(struct tbs_regmap *map, unsigned int reg,
 	return tbs_regmap_bulk_write(map, reg, &value, 1);
 }
 
+static int tbs_regmap_bulk_read(struct tbs_regmap *map, unsigned int reg,
+		void *val, size_t val_count)
+{
+	u8 reg_buf = reg;
+	struct i2c_msg msg[] = {
+		{
+			.addr = map->client->addr,
+			.flags = 0,
+			.len = 1,
+			.buf = &reg_buf,
+		}, {
+			.addr = map->client->addr,
+			.flags = I2C_M_RD,
+			.len = val_count,
+			.buf = val,
+		}
+	};
+	int ret;
+
+	mutex_lock(&map->lock);
+	ret = i2c_transfer(map->client->adapter, msg, ARRAY_SIZE(msg));
+	mutex_unlock(&map->lock);
+
+	return ret == ARRAY_SIZE(msg) ? 0 :
+		(ret < 0 ? ret : -EREMOTEIO);
+}
+
 static int tbs_regmap_update_bits(struct tbs_regmap *map, unsigned int reg,
 		unsigned int mask, unsigned int val)
 {
-	unsigned int current;
+	unsigned int current_val;
 	int ret;
 
-	ret = tbs_regmap_read(map, reg, &current);
+	ret = tbs_regmap_read(map, reg, &current_val);
 	if (ret)
 		return ret;
 
-	current = (current & ~mask) | (val & mask);
-	return tbs_regmap_write(map, reg, current);
+	current_val = (current_val & ~mask) | (val & mask);
+	return tbs_regmap_write(map, reg, current_val);
 }
 
 static int tbs_regmap_multi_reg_write(struct tbs_regmap *map,
@@ -157,6 +184,7 @@ static int tbs_regmap_multi_reg_write(struct tbs_regmap *map,
 #define regmap_exit tbs_regmap_exit
 #define regmap_read tbs_regmap_read
 #define regmap_write tbs_regmap_write
+#define regmap_bulk_read tbs_regmap_bulk_read
 #define regmap_bulk_write tbs_regmap_bulk_write
 #define regmap_update_bits tbs_regmap_update_bits
 #define regmap_multi_reg_write tbs_regmap_multi_reg_write
-- 
