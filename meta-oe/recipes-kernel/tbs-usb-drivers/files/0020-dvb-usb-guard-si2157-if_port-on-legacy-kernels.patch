From 572b58e2f595bfcc196658b881cd1bb03bbe1d88 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sun, 30 Aug 2026 20:54:13 +0200
Subject: [PATCH] dvb-usb: guard si2157 if_port on legacy kernels

---
 drivers/media/usb/dvb-usb/tbs5520se.c | 2 ++
 drivers/media/usb/dvb-usb/tbs5580.c   | 2 ++
 drivers/media/usb/dvb-usb/tbs5590.c   | 2 ++
 3 files changed, 6 insertions(+)

diff --git a/drivers/media/usb/dvb-usb/tbs5520se.c b/drivers/media/usb/dvb-usb/tbs5520se.c
index 0961304..c110904 100644
--- a/drivers/media/usb/dvb-usb/tbs5520se.c
+++ b/drivers/media/usb/dvb-usb/tbs5520se.c
@@ -268,7 +268,9 @@ static int tbs5520se_frontend_attach(struct dvb_usb_adapter *adap)
 	/* attach ter tuner */
 	memset(&si2157_config, 0, sizeof(si2157_config));
 	si2157_config.fe = adap->fe_adap[0].fe;
+#ifndef TBS_NO_SI2157_IF_PORT
 	si2157_config.if_port = 1;
+#endif
 	memset(&info, 0, sizeof(struct i2c_board_info));
 	strscpy(info.type, "si2157", I2C_NAME_SIZE);
 	info.addr = 0x61;
diff --git a/drivers/media/usb/dvb-usb/tbs5580.c b/drivers/media/usb/dvb-usb/tbs5580.c
index 5dd4ca9..907ca02 100644
--- a/drivers/media/usb/dvb-usb/tbs5580.c
+++ b/drivers/media/usb/dvb-usb/tbs5580.c
@@ -566,7 +566,9 @@ static int tbs5580_frontend_attach(struct dvb_usb_adapter *adap)
 	/* attach ter tuner */
 	memset(&si2157_config, 0, sizeof(si2157_config));
 	si2157_config.fe = adap->fe_adap[0].fe;
+#ifndef TBS_NO_SI2157_IF_PORT
 	si2157_config.if_port = 1;
+#endif
 	memset(&info, 0, sizeof(struct i2c_board_info));
 	strscpy(info.type, "si2157", I2C_NAME_SIZE);
 	info.addr = 0x61;
diff --git a/drivers/media/usb/dvb-usb/tbs5590.c b/drivers/media/usb/dvb-usb/tbs5590.c
index b568c70..417836b 100644
--- a/drivers/media/usb/dvb-usb/tbs5590.c
+++ b/drivers/media/usb/dvb-usb/tbs5590.c
@@ -461,7 +461,9 @@ static int tbs5590_frontend_attach(struct dvb_usb_adapter *adap)
 	/* attach ter tuner */
 	memset(&si2157_config, 0, sizeof(si2157_config));
 	si2157_config.fe = adap->fe_adap[0].fe;
+#ifndef TBS_NO_SI2157_IF_PORT
 	si2157_config.if_port = 1;
+#endif
 	memset(&info, 0, sizeof(struct i2c_board_info));
 	strscpy(info.type, "si2157", I2C_NAME_SIZE);
 	info.addr = 0x61;
-- 
2.45.2.windows.1

