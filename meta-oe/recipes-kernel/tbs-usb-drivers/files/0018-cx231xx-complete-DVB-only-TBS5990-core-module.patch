From 81e639c32cafb34f187bca9d357fbad6f52fced7 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sun, 30 Aug 2026 13:46:45 +0200
Subject: [PATCH] cx231xx: complete DVB-only TBS5990 core module

---
 drivers/media/usb/cx231xx/cx231xx-core.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/media/usb/cx231xx/cx231xx-core.c b/drivers/media/usb/cx231xx/cx231xx-core.c
index 7b83f18..4442e35 100644
--- a/drivers/media/usb/cx231xx/cx231xx-core.c
+++ b/drivers/media/usb/cx231xx/cx231xx-core.c
@@ -38,6 +38,13 @@ static int alt = CX231XX_PINOUT;
 module_param(alt, int, 0644);
 MODULE_PARM_DESC(alt, "alternate setting to use for video endpoint");
 
+#ifdef TBS_CX231XX_5990_ONLY
+/* The regular cx231xx module gets its metadata from cx231xx-video.c.  The
+ * DVB-only TBS5990 build deliberately omits that analog object. */
+MODULE_DESCRIPTION("Conexant cx231xx core for the TBS5990 DVB receiver");
+MODULE_LICENSE("GPL");
+#endif
+
 #define cx231xx_isocdbg(fmt, arg...) do {\
 	if (core_debug) \
 		printk(KERN_INFO "%s %s :"fmt, \
@@ -1446,7 +1453,9 @@ int cx231xx_init_bulk(struct cx231xx *dev, int max_packets,
 
 	cx231xx_coredbg("Setting Video mux to %d\n", dev->video_input);
 
+#ifndef TBS_CX231XX_5990_ONLY
 	video_mux(dev, dev->video_input);
+#endif
 
 	/* De-allocates all pending stuff */
 	cx231xx_uninit_bulk(dev);
@@ -1575,7 +1584,9 @@ int cx231xx_init_bulk_ts2(struct cx231xx *dev, int max_packets,
 
 	cx231xx_coredbg("Setting Video mux to %d\n", dev->video_input);
 
+#ifndef TBS_CX231XX_5990_ONLY
 	video_mux(dev, dev->video_input);
+#endif
 
 	/* De-allocates all pending stuff */
 	cx231xx_uninit_bulk_ts2(dev);
-- 
