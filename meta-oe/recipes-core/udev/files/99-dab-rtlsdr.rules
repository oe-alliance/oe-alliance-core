ATTR{idVendor}=="1f4d", ATTR{idProduct}=="d803", ENV{ID_SOFTWARE_RADIO}="1", ENV{ID_MODEL}="PROlectrix DV107669"

ENV{ID_SOFTWARE_RADIO}=="1", RUN+="/usr/bin/hotplug_e2_helper dab-sdr-add %p"

LABEL="dab_rtlsdr_end"
