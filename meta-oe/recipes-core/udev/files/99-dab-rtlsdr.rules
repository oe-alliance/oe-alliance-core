# RTL2832U devices supported by Osmocom rtl-sdr.
#
# Keep this list in sync with:
# https://github.com/osmocom/rtl-sdr/blob/master/rtl-sdr.rules
#
# Package installation is intentionally handled asynchronously by Enigma2;
# never run the network package manager from inside udev.

ACTION!="add", GOTO="dab_rtlsdr_end"
SUBSYSTEM!="usb", GOTO="dab_rtlsdr_end"
ENV{DEVTYPE}!="usb_device", GOTO="dab_rtlsdr_end"

ATTR{idVendor}=="0bda", ATTR{idProduct}=="2832", ENV{ID_SOFTWARE_RADIO}="1", ENV{ID_MODEL}="Generic RTL2832U"
ATTR{idVendor}=="0bda", ATTR{idProduct}=="2838", ENV{ID_SOFTWARE_RADIO}="1", ENV{ID_MODEL}="Generic RTL2832U OEM"
ATTR{idVendor}=="0413", ATTR{idProduct}=="6680", ENV{ID_SOFTWARE_RADIO}="1", ENV{ID_MODEL}="DigitalNow Quad DVB-T PCI-E card"
ATTR{idVendor}=="0413", ATTR{idProduct}=="6f0f", ENV{ID_SOFTWARE_RADIO}="1", ENV{ID_MODEL}="Leadtek WinFast DTV Dongle mini D"
ATTR{idVendor}=="0458", ATTR{idProduct}=="707f", ENV{ID_SOFTWARE_RADIO}="1", ENV{ID_MODEL}="Genius TVGo DVB-T03 USB dongle (Ver. B)"
ATTR{idVendor}=="0ccd", ATTR{idProduct}=="00a9", ENV{ID_SOFTWARE_RADIO}="1", ENV{ID_MODEL}="Terratec Cinergy T Stick Black rev 1"
