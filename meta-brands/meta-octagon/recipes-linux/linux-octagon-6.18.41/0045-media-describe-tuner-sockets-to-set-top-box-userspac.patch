index 62e558633ca4..31c9caadb3e2 100644
--- a/drivers/media/platform/hisilicon/Kconfig
+++ b/drivers/media/platform/hisilicon/Kconfig
@@ -16,3 +16,21 @@ config VIDEO_HISTB_DEMUX
 
 	  To compile this driver as a module, choose M here: the module will
 	  be called histb-demux.
+
+config DVB_NIM_SOCKETS
+	tristate "Tuner sockets described to set-top box userspace"
+	depends on OF && I2C && PROC_FS
+	depends on DVB_CORE
+	help
+	  Set-top box userspace such as Enigma2 learns which tuners a
+	  receiver has from /proc/bus/nim_sockets rather than from the
+	  DVB devices themselves.  The file was invented by a vendor
+	  kernel and nothing in the DVB subsystem knows about it.  Say
+	  Y here to describe the frontends the board points at in that
+	  form, so that the stock userspace of such a box can drive a
+	  mainline tuner.
+
+	  If you are not running set-top box software, say N.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called nim-sockets.
