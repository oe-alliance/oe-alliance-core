From d7cc87fd5693736dde9ae2c06e0eb2fc53498bb8 Mon Sep 17 00:00:00 2001
From: Tillmann Severin <tillmann.severin@mailbox.org>
Date: Sun, 8 Nov 2026 22:00:31 +0100
Subject: [PATCH 45/49] media: describe tuner sockets to set-top box userspace

Enigma2 and its relatives learn which tuners a receiver has from
/proc/bus/nim_sockets rather than from the DVB devices themselves.
The file was invented by a vendor kernel and has been copied from one
set-top box to the next ever since; nothing in the DVB subsystem knows
about it, and nothing should.

Reproduce it, so that the stock userspace of such a box can drive a
mainline tuner, and keep it well away from the drivers that do the
actual work.  Everything in the file is derived from the frontends the
board points at, so the shim carries no knowledge of any particular
tuner, and a board that does not want it simply leaves the node out.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 .../hisilicon/hi3798mv200-octagon-sf8008.dts  |  10 +
 drivers/media/platform/hisilicon/Kconfig      |  18 ++
 drivers/media/platform/hisilicon/Makefile     |   1 +
 .../media/platform/hisilicon/nim-sockets.c    | 260 ++++++++++++++++++
 4 files changed, 289 insertions(+)
 create mode 100644 drivers/media/platform/hisilicon/nim-sockets.c

diff --git a/arch/arm/boot/dts/hisilicon/hi3798mv200-octagon-sf8008.dts b/arch/arm/boot/dts/hisilicon/hi3798mv200-octagon-sf8008.dts
index 2ec0c8f3123c..eecd113eada8 100644
--- a/arch/arm/boot/dts/hisilicon/hi3798mv200-octagon-sf8008.dts
+++ b/arch/arm/boot/dts/hisilicon/hi3798mv200-octagon-sf8008.dts
@@ -79,6 +79,16 @@ framebuffer0: framebuffer {
 		};
 	};
 
+	/*
+	 * Set-top box userspace reads the list of tuners out of procfs
+	 * instead of asking the DVB devices, so tell it where the one
+	 * tuner on this board is.
+	 */
+	nim-sockets {
+		compatible = "linux,dvb-nim-sockets";
+		dvb-frontends = <&demod_c>;
+	};
+
 	reserved-memory {
 		#address-cells = <1>;
 		#size-cells = <1>;
