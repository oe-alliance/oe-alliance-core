From 1f7c42bcd182d9519bd4e4063efb515143c6499d Mon Sep 17 00:00:00 2001
From: Tillmann Severin <tillmann.severin@mailbox.org>
Date: Sat, 1 Aug 2026 20:25:38 +0200
Subject: [PATCH 15/24] ARM: hisi_defconfig: enable Hi3798MV200

Add the Hi3798MV200 machine to the HiSilicon family defconfig, along
with the peripheral drivers the Octagon SF8008 board needs that were
not already selected by the other HiSilicon platforms:

  - MMC_DW_HI3798MV200 for the eMMC and SD controllers
  - I2C_HIX5HD2 for the on-SoC I2C blocks
  - REALTEK_PHY for the RGMII PHY behind the gigabit MAC
  - GPIO_PL061 for the PrimeCell GPIO blocks
  - PHY_HISI_INNO_USB2 for the USB 2.0 PHY

The entries are inserted in Kconfig order by hand rather than via
savedefconfig, which would otherwise fold in seventeen unrelated
lines of drift that have accumulated in this defconfig.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 arch/arm/configs/hisi_defconfig | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm/configs/hisi_defconfig b/arch/arm/configs/hisi_defconfig
index e19c1039fb93..d7bf421c6755 100644
--- a/arch/arm/configs/hisi_defconfig
+++ b/arch/arm/configs/hisi_defconfig
@@ -5,6 +5,7 @@ CONFIG_BLK_DEV_INITRD=y
 CONFIG_RD_LZMA=y
 CONFIG_ARCH_HISI=y
 CONFIG_ARCH_HI3xxx=y
+CONFIG_ARCH_HI3798MV200=y
 CONFIG_ARCH_HIP01=y
 CONFIG_ARCH_HIP04=y
 CONFIG_ARCH_HIX5HD2=y
@@ -34,6 +35,7 @@ CONFIG_SATA_AHCI_PLATFORM=y
 CONFIG_NETDEVICES=y
 CONFIG_HIX5HD2_GMAC=y
 CONFIG_HIP04_ETH=y
+CONFIG_REALTEK_PHY=y
 CONFIG_SERIAL_8250=y
 CONFIG_SERIAL_8250_DEPRECATED_OPTIONS=y
 CONFIG_SERIAL_8250_CONSOLE=y
@@ -43,6 +45,7 @@ CONFIG_SERIAL_8250_DW=y
 CONFIG_SERIAL_OF_PLATFORM=y
 CONFIG_SERIAL_AMBA_PL011=y
 CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
+CONFIG_I2C_HIX5HD2=y
 CONFIG_I2C_DESIGNWARE_CORE=y
 CONFIG_I2C_DESIGNWARE_PLATFORM=y
 CONFIG_SPI=y
@@ -55,6 +58,7 @@ CONFIG_DEBUG_GPIO=y
 CONFIG_GPIO_DWAPB=y
 CONFIG_MFD_SYSCON=y
 CONFIG_GPIO_GENERIC_PLATFORM=y
+CONFIG_GPIO_PL061=y
 CONFIG_POWER_RESET_SYSCON=y
 CONFIG_DRM=y
 CONFIG_FB_SIMPLE=y
@@ -70,12 +74,14 @@ CONFIG_NOP_USB_XCEIV=y
 CONFIG_MMC=y
 CONFIG_MMC_DW=y
 CONFIG_MMC_DW_PLTFM=y
+CONFIG_MMC_DW_HI3798MV200=y
 CONFIG_RTC_CLASS=y
 CONFIG_RTC_DRV_PL031=y
 CONFIG_DMADEVICES=y
 CONFIG_PL330_DMA=y
 CONFIG_DW_DMAC=y
 CONFIG_PWM=y
+CONFIG_PHY_HISI_INNO_USB2=y
 CONFIG_PHY_HIX5HD2_SATA=y
 CONFIG_EXT4_FS=y
 CONFIG_TMPFS=y
