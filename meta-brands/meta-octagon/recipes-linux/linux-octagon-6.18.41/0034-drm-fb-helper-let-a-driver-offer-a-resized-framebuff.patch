From 4530416fbb7a5f14e0c9819121379582c855dd23 Mon Sep 17 00:00:00 2001
From: Tillmann Severin <tillmann.severin@mailbox.org>
Date: Fri, 6 Nov 2026 11:30:06 +0100
Subject: [PATCH 34/35] drm/fb-helper: let a driver offer a resized framebuffer

fbdev emulation cannot change the display mode, so a request for a
different visible resolution is rejected. Hardware that can scale the
framebuffer to the display does not need a mode change to honour such a
request though, it only has to be told about it.

Add an optional fb_resize hook to the mode configuration. A driver that
implements it has requests for a different visible resolution passed on
instead of rejected, and is also called with the resolution of the
display mode whenever fbdev emulation restores its own configuration.
---
 drivers/gpu/drm/drm_fb_helper.c | 17 ++++++++++++++---
 include/drm/drm_mode_config.h   | 22 ++++++++++++++++++++++
 2 files changed, 36 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/drm_fb_helper.c b/drivers/gpu/drm/drm_fb_helper.c
index 0e9ff0d7857a..ea369e937a1d 100644
--- a/drivers/gpu/drm/drm_fb_helper.c
+++ b/drivers/gpu/drm/drm_fb_helper.c
@@ -1274,10 +1274,13 @@ int drm_fb_helper_check_var(struct fb_var_screeninfo *var,
 	/*
 	 * fb_set_par() cannot change the display mode, so a request for a
 	 * different visible resolution would be acknowledged without ever
-	 * reaching the screen. Reject it rather than leave user space with a
-	 * framebuffer whose geometry does not match what is scanned out.
+	 * reaching the screen. Hardware that can scale the framebuffer to
+	 * the display says so with fb_resize; everybody else has the request
+	 * rejected rather than leaving user space with a framebuffer whose
+	 * geometry does not match what is scanned out.
 	 */
-	if (var->xres != info->var.xres || var->yres != info->var.yres) {
+	if ((var->xres != info->var.xres || var->yres != info->var.yres) &&
+	    !dev->mode_config.funcs->fb_resize) {
 		drm_dbg_kms(dev, "fbdev emulation doesn't support changing the resolution, "
 			    "request %dx%d != %dx%d\n",
 			    var->xres, var->yres, info->var.xres, info->var.yres);
@@ -1340,11 +1343,19 @@ int drm_fb_helper_set_par(struct fb_info *info)
 {
 	struct drm_fb_helper *fb_helper = info->par;
 	struct fb_var_screeninfo *var = &info->var;
+	struct drm_device *dev = fb_helper->dev;
 	bool force;
 
 	if (oops_in_progress)
 		return -EBUSY;
 
+	if (dev->mode_config.funcs->fb_resize) {
+		int ret = dev->mode_config.funcs->fb_resize(dev, var->xres,
+							    var->yres);
+		if (ret)
+			return ret;
+	}
+
 	/*
 	 * Normally we want to make sure that a kms master takes precedence over
 	 * fbdev, to avoid fbdev flickering and occasionally stealing the
diff --git a/include/drm/drm_mode_config.h b/include/drm/drm_mode_config.h
index 2e848b816218..16218262b4cd 100644
--- a/include/drm/drm_mode_config.h
+++ b/include/drm/drm_mode_config.h
@@ -321,6 +321,28 @@ struct drm_mode_config_funcs {
 	 * &drm_private_state and &drm_private_obj.
 	 */
 	void (*atomic_state_free)(struct drm_atomic_state *state);
+
+	/**
+	 * @fb_resize:
+	 *
+	 * This optional hook lets fbdev emulation offer a visible resolution
+	 * that differs from the one of the display mode. Hardware that can
+	 * scale the framebuffer to the display implements it, and everybody
+	 * else has such a request rejected, because fbdev emulation cannot
+	 * change the display mode on its own.
+	 *
+	 * The hook is called with the resolution user space asked for, and
+	 * with the resolution of the display mode whenever fbdev emulation
+	 * restores its own configuration, so an implementation has to be
+	 * prepared to be called with the size it already uses.
+	 *
+	 * RETURNS:
+	 *
+	 * Zero on success, or a negative errno on failure, in which case the
+	 * previous screen info is restored.
+	 */
+	int (*fb_resize)(struct drm_device *dev, unsigned int width,
+			 unsigned int height);
 };
 
