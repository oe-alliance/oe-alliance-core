+/*
+ * Blocks the hardware has filled are reported between the output
+ * queue's read and write pointers.  Each one holds a whole number of
+ * packets, so it can go straight to the software filters, after which
+ * the block is put back on the free queue for reuse.  Forgetting that
+ * last step is how a capture quietly stops after one ring's worth.
+ */
+static void histb_demux_deliver(struct work_struct *work)
+{
+	struct histb_demux *dmx = container_of(to_delayed_work(work),
+					       struct histb_demux, poll);
+	u32 depth = HISTB_DMX_QUEUE_DEPTH;
+	u32 oq_write, fq_write;
 
-		dmx->capturing = true;
+	guard(mutex)(&dmx->lock);
+
+	if (!dmx->capturing)
 		return;
+
+	oq_write = histb_demux_read(dmx, HISTB_DMX_OQ_WORD(0, 5)) &
+		   HISTB_DMX_QUEUE_PTR;
+	fq_write = histb_demux_read(dmx, HISTB_DMX_FQ_WORD(0, 2)) &
+		   HISTB_DMX_QUEUE_PTR;
+
+	if (oq_write >= depth)
+		goto again;
+
+	while (dmx->oq_read != oq_write) {
+		struct histb_demux_oq_desc *desc = &dmx->oq[dmx->oq_read];
+		u32 addr = le32_to_cpu(desc->start_addr);
+		u32 buflen = le32_to_cpu(desc->cactrl_buflen) &
+			     HISTB_DMX_DESC_BUFLEN;
+		u32 len = FIELD_GET(HISTB_DMX_DESC_DATALEN,
+				    le32_to_cpu(desc->pvrctrl_datalen));
+		u32 off = addr - dmx->blocks_phys;
+
+		if (off < depth * HISTB_DMX_BLOCK_SIZE &&
+		    len <= HISTB_DMX_BLOCK_SIZE && len % 188 == 0)
+			dvb_dmx_swfilter_packets(&dmx->demux,
+						 dmx->blocks + off, len / 188);
+		else
+			dev_warn_ratelimited(dmx->dev,
+					     "ignoring block at %08x of %u bytes\n",
+					     addr, len);
+
+		dmx->fq[fq_write].start_addr = desc->start_addr;
+		dmx->fq[fq_write].buflen = cpu_to_le32(buflen);
+		desc->pvrctrl_datalen = 0;
+
+		dmx->oq_read = (dmx->oq_read + 1) % depth;
+		fq_write = (fq_write + 1) % depth;
 	}
 
-	histb_demux_write(dmx, HISTB_DMX_PID_VALUE(0),
-			  FIELD_PREP(HISTB_DMX_PID_VALUE_PID, dmx->pid));
-	histb_demux_write(dmx, HISTB_DMX_PID_PLAY_BUF(0),
-			  FIELD_PREP(HISTB_DMX_PID_PLAY_OQ, 0));
-	histb_demux_write(dmx, HISTB_DMX_PID_CTRL(0), dmx->pid_ctrl);
-	/*
-	 * Zero in this field means the channel is off, so the instance
-	 * is recorded one higher than it is numbered everywhere else.
-	 */
-	histb_demux_write(dmx, HISTB_DMX_PID_EN(0),
-			  FIELD_PREP(HISTB_DMX_PID_PLAY_DMX_ID,
-				     dmx->input_port + 1));
