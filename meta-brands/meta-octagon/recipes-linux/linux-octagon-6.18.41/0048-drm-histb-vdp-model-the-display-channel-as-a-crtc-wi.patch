From 0f500484e486e790229e3e2b48abd81ff7fd5e68 Mon Sep 17 00:00:00 2001
From: Tillmann Severin <tillmann.severin@mailbox.org>
Date: Mon, 9 Nov 2026 21:17:07 +0100
Subject: [PATCH 48/49] drm/histb-vdp: model the display channel as a crtc with
 planes

The simple display pipe is one plane and one crtc welded together, which
suits a driver that will only ever scan out a framebuffer.  This display
channel has more layers than that: the decoded picture arrives on a video
layer of the same block, composed underneath the graphics layer the user
interface is drawn on.

Split the pipe into a crtc, a primary plane for graphics layer G0 and an
encoder tying the crtc to the existing connector.  The register writes are
unchanged, and the layer is still only reprogrammed in full when the
framebuffer changes shape, so a page flip remains a single write of the
scanout address.
---
 .../gpu/drm/hisilicon/histb/histb_vdp_drv.c   | 203 +++++++++++++-----
 1 file changed, 151 insertions(+), 52 deletions(-)

diff --git a/drivers/gpu/drm/hisilicon/histb/histb_vdp_drv.c b/drivers/gpu/drm/hisilicon/histb/histb_vdp_drv.c
index 6f5333ae05b6..cf497f2378b7 100644
--- a/drivers/gpu/drm/hisilicon/histb/histb_vdp_drv.c
+++ b/drivers/gpu/drm/hisilicon/histb/histb_vdp_drv.c
@@ -3,9 +3,13 @@
  * DRM driver for the HiSilicon STB video display processor.
  *
  * The VDP composes several video and graphics layers into one or more display
- * channels.  This driver only drives the first graphics layer, G0, on the
- * first display channel, DHD0, which is enough to take over the framebuffer
- * the bootloader leaves scanning out.
+ * channels.  This driver drives the first display channel, DHD0, and presents
+ * its first graphics layer, G0, as the primary plane.  That is enough to take
+ * over the framebuffer the bootloader leaves scanning out.
+ *
+ * The channel is modelled as a CRTC with planes rather than as a simple
+ * display pipe, because the layers the decoded picture will arrive on are
+ * further planes of this same channel.
  *
  * The display timing itself is not programmed.  The bootloader has already
  * brought up DHD0 and the HDMI transmitter, so the mode is read back out of
@@ -25,6 +29,7 @@
 #include <drm/clients/drm_client_setup.h>
 #include <drm/drm_atomic.h>
 #include <drm/drm_atomic_helper.h>
+#include <drm/drm_crtc_helper.h>
 #include <drm/drm_drv.h>
 #include <drm/drm_fb_dma_helper.h>
 #include <drm/drm_fbdev_dma.h>
@@ -42,7 +47,9 @@
