 }
@@ -507,10 +585,31 @@ static int histb_vdp_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
-	ret = drm_simple_display_pipe_init(drm, &vdp->pipe, &histb_vdp_pipe_funcs,
-					   histb_vdp_formats,
-					   ARRAY_SIZE(histb_vdp_formats),
