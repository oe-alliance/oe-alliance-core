+# SPDX-License-Identifier: GPL-2.0-only
+
+comment "HiSilicon media platform drivers"
+
+config VIDEO_HISTB_DEMUX
+	tristate "HiSilicon set-top box transport stream demultiplexer"
+	depends on ARCH_HISI || COMPILE_TEST
