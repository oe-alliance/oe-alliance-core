+				 <&crg HISTB_DEMUX_TS0_CLK>,
+				 <&crg HISTB_DEMUX_TSOUT0_CLK>;
+			clock-names = "bus", "dmx", "27m", "tsi0", "tsi1",
+				      "tsi2", "tsi3", "ts0", "tsout0";
+			resets = <&crg 0xfc 24>;
+			hisilicon,crg = <&crg>;
+			status = "disabled";
+		};
 	};
 };
