diff --git a/arch/arm/boot/dts/hisilicon/hi3798mv200-octagon-sf8008.dts b/arch/arm/boot/dts/hisilicon/hi3798mv200-octagon-sf8008.dts
index e758b34434dc..042cee04bf10 100644
--- a/arch/arm/boot/dts/hisilicon/hi3798mv200-octagon-sf8008.dts
+++ b/arch/arm/boot/dts/hisilicon/hi3798mv200-octagon-sf8008.dts
@@ -284,4 +284,22 @@ i2c1_pins: i2c1-pins {
 			0x090 MUX_M6
 		>;
 	};
+
+	/* serial transport stream from the demodulator: clock, sync, valid, data */
+	ts_pins: ts-pins {
+		pinctrl-single,pins = <
+			0x078 MUX_M3
+			0x07c MUX_M3
+			0x080 MUX_M3
+			0x084 MUX_M3
+		>;
+	};
+};
+
+/* The demodulator feeds input port 1; the other three ports are unused. */
+&demux {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&ts_pins>;
+	hisilicon,input-port = <1>;
 };
