+#define HISTB_DEMUX_27M_CLK		54
+#define HISTB_DEMUX_TSI0_CLK		55
+#define HISTB_DEMUX_TSI1_CLK		56
+#define HISTB_DEMUX_TSI2_CLK		57
+#define HISTB_DEMUX_TSI3_CLK		58
