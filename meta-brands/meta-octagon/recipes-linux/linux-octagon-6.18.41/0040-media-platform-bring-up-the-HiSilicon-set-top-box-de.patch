diff --git a/drivers/media/platform/hisilicon/histb-demux.c b/drivers/media/platform/hisilicon/histb-demux.c
new file mode 100644
index 000000000000..296276fda0c4
--- /dev/null
+++ b/drivers/media/platform/hisilicon/histb-demux.c
@@ -0,0 +1,228 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Transport stream demultiplexer found on HiSilicon set-top box SoCs.
+ *
+ * This stage brings the input side up: the block is taken out of reset,
+ * its clocks are started, and one of the four input ports is told what
+ * shape of transport stream to expect.  The hardware then counts the
+ * packets it receives on each port, which is reported through debugfs
+ * and is enough to tell whether a tuned front end is actually feeding
+ * the demultiplexer.
+ *
+ * Filtering and delivery to the DVB stack are not here yet.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/debugfs.h>
+#include <linux/io.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+#include <linux/seq_file.h>
+
+#define HISTB_DMX_PORTS			4
+
+#define HISTB_DMX_TS_INTERFACE(p)	(0x1100 + ((p) << 8))
+#define HISTB_DMX_TS_COUNT(p)		(0x1104 + ((p) << 8))
+#define HISTB_DMX_TS_COUNT_CTRL(p)	(0x1108 + ((p) << 8))
+#define HISTB_DMX_ETS_COUNT(p)		(0x110c + ((p) << 8))
+
+#define HISTB_DMX_TS_SYNCON_TH		GENMASK(2, 0)
+#define HISTB_DMX_TS_SYNCOFF_TH		GENMASK(5, 4)
+#define HISTB_DMX_TS_SYNC_MODE		GENMASK(21, 20)
+#define HISTB_DMX_TS_SYNC_POL		BIT(23)
+#define HISTB_DMX_TS_VLD_POL		BIT(24)
+#define HISTB_DMX_TS_ERR_POL		BIT(25)
+#define HISTB_DMX_TS_SERIAL		BIT(29)
+#define HISTB_DMX_TS_BIT_SEL		BIT(30)
+#define HISTB_DMX_TS_PORT_SEL		BIT(31)
+
+#define HISTB_DMX_COUNT_RESET		0
+#define HISTB_DMX_COUNT_START		1
+#define HISTB_DMX_COUNT_STOP		2
+
+/*
+ * The transport clock for input group 0 is selected in the clock and
+ * reset controller rather than in the demultiplexer itself, and the
+ * clock framework has no way to express a mux that feeds a block
+ * through a path it does not otherwise manage.
+ */
+#define HISTB_CRG_DEMUX_CLK_SEL		0x100
+#define HISTB_CRG_TS0_CLK_SEL		GENMASK(13, 12)
+
+struct histb_demux {
+	struct device *dev;
+	void __iomem *base;
+	struct clk_bulk_data *clks;
+	int num_clks;
+	struct reset_control *rst;
+	struct dentry *debugfs;
+	u32 input_port;
+};
+
+static void histb_demux_write(struct histb_demux *dmx, u32 reg, u32 val)
+{
+	writel(val, dmx->base + reg);
+}
+
+static u32 histb_demux_read(struct histb_demux *dmx, u32 reg)
+{
+	return readl(dmx->base + reg);
+}
+
+/*
+ * A serial transport stream arrives on four pins: clock, sync, valid and
+ * one data line.  The thresholds say how many consecutive packets must
+ * carry a sync byte before the port declares itself synchronised, and
+ * how many must lack one before it gives up.
+ */
+static void histb_demux_setup_port(struct histb_demux *dmx, u32 port)
+{
+	u32 val;
+
+	val = HISTB_DMX_TS_SERIAL | HISTB_DMX_TS_BIT_SEL |
+	      HISTB_DMX_TS_PORT_SEL;
+	val |= FIELD_PREP(HISTB_DMX_TS_SYNC_MODE, 0);
+	val |= FIELD_PREP(HISTB_DMX_TS_SYNCOFF_TH, 1);
+	val |= FIELD_PREP(HISTB_DMX_TS_SYNCON_TH, 5);
+
+	histb_demux_write(dmx, HISTB_DMX_TS_INTERFACE(port), val);
+
+	histb_demux_write(dmx, HISTB_DMX_TS_COUNT_CTRL(port),
+			  HISTB_DMX_COUNT_RESET);
+	histb_demux_write(dmx, HISTB_DMX_TS_COUNT_CTRL(port),
+			  HISTB_DMX_COUNT_START);
+}
+
+static int histb_demux_ports_show(struct seq_file *s, void *unused)
+{
+	struct histb_demux *dmx = s->private;
+	u32 port;
+
+	for (port = 0; port < HISTB_DMX_PORTS; port++)
+		seq_printf(s, "port %u  cfg %08x  packets %-10u errors %u\n",
+			   port,
+			   histb_demux_read(dmx, HISTB_DMX_TS_INTERFACE(port)),
+			   histb_demux_read(dmx, HISTB_DMX_TS_COUNT(port)),
+			   histb_demux_read(dmx, HISTB_DMX_ETS_COUNT(port)));
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(histb_demux_ports);
+
+static int histb_demux_select_ts_clock(struct histb_demux *dmx)
+{
+	struct regmap *crg;
+
+	crg = syscon_regmap_lookup_by_phandle(dmx->dev->of_node,
+					      "hisilicon,crg");
+	if (IS_ERR(crg))
+		return dev_err_probe(dmx->dev, PTR_ERR(crg),
+				     "no clock and reset controller\n");
+
+	return regmap_update_bits(crg, HISTB_CRG_DEMUX_CLK_SEL,
+				  HISTB_CRG_TS0_CLK_SEL,
+				  FIELD_PREP(HISTB_CRG_TS0_CLK_SEL, 1));
+}
+
+static int histb_demux_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct histb_demux *dmx;
+	int ret;
+
+	dmx = devm_kzalloc(dev, sizeof(*dmx), GFP_KERNEL);
+	if (!dmx)
+		return -ENOMEM;
+
+	dmx->dev = dev;
+	platform_set_drvdata(pdev, dmx);
+
+	dmx->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(dmx->base))
+		return PTR_ERR(dmx->base);
+
+	if (of_property_read_u32(dev->of_node, "hisilicon,input-port",
+				 &dmx->input_port))
+		return dev_err_probe(dev, -EINVAL,
+				     "board must say which input port is wired\n");
+
+	if (dmx->input_port >= HISTB_DMX_PORTS)
+		return dev_err_probe(dev, -EINVAL, "input port %u does not exist\n",
+				     dmx->input_port);
+
+	dmx->num_clks = devm_clk_bulk_get_all(dev, &dmx->clks);
+	if (dmx->num_clks < 0)
+		return dev_err_probe(dev, dmx->num_clks, "no clocks\n");
+
+	dmx->rst = devm_reset_control_get_exclusive(dev, NULL);
+	if (IS_ERR(dmx->rst))
+		return dev_err_probe(dev, PTR_ERR(dmx->rst), "no reset\n");
+
+	ret = clk_bulk_prepare_enable(dmx->num_clks, dmx->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot start clocks\n");
+
+	ret = histb_demux_select_ts_clock(dmx);
+	if (ret)
+		goto err_clks;
+
+	/*
+	 * The boot loader leaves the block in reset, in which state every
+	 * one of its registers reads back as zero - which is indis-
+	 * tinguishable from a block that is simply idle.
+	 */
+	ret = reset_control_deassert(dmx->rst);
+	if (ret) {
+		dev_err_probe(dev, ret, "cannot release reset\n");
+		goto err_clks;
+	}
+
+	histb_demux_setup_port(dmx, dmx->input_port);
+
+	dmx->debugfs = debugfs_create_dir(dev_name(dev), NULL);
+	debugfs_create_file("ports", 0444, dmx->debugfs, dmx,
+			    &histb_demux_ports_fops);
+
+	dev_info(dev, "transport stream input on port %u\n", dmx->input_port);
+
+	return 0;
+
+err_clks:
+	clk_bulk_disable_unprepare(dmx->num_clks, dmx->clks);
+	return ret;
+}
+
+static void histb_demux_remove(struct platform_device *pdev)
+{
+	struct histb_demux *dmx = platform_get_drvdata(pdev);
+
+	debugfs_remove_recursive(dmx->debugfs);
+	histb_demux_write(dmx, HISTB_DMX_TS_COUNT_CTRL(dmx->input_port),
+			  HISTB_DMX_COUNT_STOP);
+	reset_control_assert(dmx->rst);
+	clk_bulk_disable_unprepare(dmx->num_clks, dmx->clks);
+}
+
+static const struct of_device_id histb_demux_of_match[] = {
+	{ .compatible = "hisilicon,hi3798mv200-demux" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, histb_demux_of_match);
+
+static struct platform_driver histb_demux_driver = {
+	.probe = histb_demux_probe,
+	.remove = histb_demux_remove,
+	.driver = {
+		.name = "histb-demux",
+		.of_match_table = histb_demux_of_match,
+	},
+};
+module_platform_driver(histb_demux_driver);
+
+MODULE_DESCRIPTION("HiSilicon set-top box transport stream demultiplexer");
+MODULE_LICENSE("GPL");
