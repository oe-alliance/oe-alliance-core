diff --git a/drivers/media/dvb-frontends/atbm7821.c b/drivers/media/dvb-frontends/atbm7821.c
new file mode 100644
index 000000000000..9b02b1fcebdd
--- /dev/null
+++ b/drivers/media/dvb-frontends/atbm7821.c
@@ -0,0 +1,505 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * AltoBeam ATBM7821 DVB-T2/T/C demodulator with a MaxLinear MxL608 tuner,
+ * as fitted to the Octagon SF8008 and other Hi3798MV200 receivers.
+ *
+ * Neither part is publicly documented and no source for either exists
+ * outside a vendor binary.  Everything here was established by watching the
+ * vendor's driver talk to the hardware over I2C and by experiment on the
+ * bench; the captures are published alongside this driver.
+ *
+ * Two things are worth knowing before reading on.
+ *
+ * The tuner sits behind a gate inside the demodulator, and the demodulator
+ * takes its clock from the tuner's crystal.  Turning the tuner's digital
+ * core off therefore stops the demodulator, which closes the gate, which
+ * removes the only route back to the tuner.  Nothing short of a power cycle
+ * recovers from that, so the bit that does it is never cleared here.
+ *
+ * The demodulator is never told the symbol rate or the constellation.  It
+ * searches for both, and it is never told the frequency either - only the
+ * tuner is.  A retune is consequently a tuner operation followed by a
+ * restart of a search that configures itself.
+ */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+
+#include <media/dvb_frontend.h>
+#include <media/dvbdev.h>
+
+#include "atbm7821_tables.h"
+
+#define ATBM7821_CHIP_ID	0xa8
+
+/* Demodulator registers that this driver reasons about by name. */
+#define ATBM7821_REG_CHIP_ID	0x0000
+#define ATBM7821_REG_I2C_GATE	0x0103	/* 1 opens the path to the tuner */
+#define ATBM7821_REG_LATCH	0x010d	/* freezes a multi-byte read */
+#define ATBM7821_REG_WIN_ADDR_L	0x1501
+#define ATBM7821_REG_WIN_ADDR_M	0x1502
+#define ATBM7821_REG_WIN_ADDR_H	0x1503
+#define ATBM7821_REG_WIN_DATA	0x1508	/* four bytes, little endian */
+
+/* Addresses within the DVB-C core, reached through the window above. */
+#define ATBM7821_DVBC_STATUS	0x008
+#define ATBM7821_DVBC_SNR	0x3c4
+#define ATBM7821_DVBC_SNR_EXP	0x3d0
+
+/*
+ * The status word counts up as the search succeeds.  0x1f means the chip has
+ * found a carrier and is working on the rest; 0x3f means it is done.
+ */
+#define ATBM7821_DVBC_PARTIAL	0x1f
+#define ATBM7821_DVBC_LOCKED	0x3f
+
+/* The tuner answers at a fixed address on the far side of the gate. */
+#define MXL608_I2C_ADDR		0x60
+
+#define MXL608_REG_FREQ_L	0x10
+#define MXL608_REG_FREQ_H	0x11
+#define MXL608_REG_RF_BAND	0x31
+#define MXL608_REG_RF_GAIN	0xa9
+
+/*
+ * Where the tuner changes its mind about the front end it uses.  Both
+ * thresholds were read off the bus across ninety tunes spanning 106 to
+ * 802 MHz, so they are known to within the 8 MHz raster of that sweep.
+ */
+#define MXL608_RF_GAIN_SPLIT_HZ	354000000
+#define MXL608_RF_BAND_SPLIT_HZ	698000000
+
+struct atbm7821_dev {
+	struct i2c_client *client;
+	struct i2c_adapter *tuner_adap;
+	struct dvb_adapter adapter;
+	struct dvb_frontend fe;
+	bool warm;
+};
+
+DVB_DEFINE_MOD_OPT_ADAPTER_NR(adapter_nr);
+
+/* ---------------------------------------------------------------- bus */
+
+/*
+ * A demodulator register is addressed by sixteen bits, high byte first.
+ * The vendor's own naming splits that into a page and an offset, and the
+ * tables keep to it, but nothing in the protocol cares.
+ */
+static int atbm7821_wr(struct atbm7821_dev *dev, u16 reg, u8 val)
+{
+	u8 buf[3] = { reg >> 8, reg & 0xff, val };
+	struct i2c_msg msg = {
+		.addr = dev->client->addr,
+		.flags = 0,
+		.len = sizeof(buf),
+		.buf = buf,
+	};
+	int ret;
+
+	ret = i2c_transfer(dev->client->adapter, &msg, 1);
+	if (ret != 1) {
+		dev_dbg(&dev->client->dev, "write %04x failed (%d)\n", reg, ret);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	return 0;
+}
+
+static int atbm7821_rd(struct atbm7821_dev *dev, u16 reg, u8 *val)
+{
+	u8 addr[2] = { reg >> 8, reg & 0xff };
+	struct i2c_msg msg[2] = {
+		{
+			.addr = dev->client->addr,
+			.flags = 0,
+			.len = sizeof(addr),
+			.buf = addr,
+		}, {
+			.addr = dev->client->addr,
+			.flags = I2C_M_RD,
+			.len = 1,
+			.buf = val,
+		},
+	};
+	int ret;
+
+	ret = i2c_transfer(dev->client->adapter, msg, 2);
+	if (ret != 2) {
+		dev_dbg(&dev->client->dev, "read %04x failed (%d)\n", reg, ret);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	return 0;
+}
+
+static int atbm7821_wr_tab(struct atbm7821_dev *dev,
+			   const struct atbm7821_regval *tab, unsigned int len)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < len; i++) {
+		ret = atbm7821_wr(dev, tab[i].reg, tab[i].val);
+		if (ret)
+			return ret;
+		if (tab[i].delay_ms)
+			msleep(tab[i].delay_ms);
+	}
+
+	return 0;
+}
+
+static int atbm7821_gate(struct atbm7821_dev *dev, bool open)
+{
+	return atbm7821_wr(dev, ATBM7821_REG_I2C_GATE, open ? 0x01 : 0x00);
+}
+
+/*
+ * The DVB-C core is not on the register map.  Its address goes into a window
+ * on page 0x15 and the result appears as four bytes which have to be frozen
+ * first, or they are sampled as they change and do not belong together.
+ */
+static int atbm7821_dvbc_rd(struct atbm7821_dev *dev, u16 addr, u32 *val)
+{
+	u8 b[4];
+	int ret, i;
+
+	ret = atbm7821_wr(dev, ATBM7821_REG_WIN_ADDR_H, (addr >> 16) & 0xff);
+	if (!ret)
+		ret = atbm7821_wr(dev, ATBM7821_REG_WIN_ADDR_L, addr & 0xff);
+	if (!ret)
+		ret = atbm7821_wr(dev, ATBM7821_REG_WIN_ADDR_M, (addr >> 8) & 0xff);
+	if (!ret)
+		ret = atbm7821_wr(dev, ATBM7821_REG_LATCH, 0x01);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < 4; i++) {
+		ret = atbm7821_rd(dev, ATBM7821_REG_WIN_DATA + i, &b[i]);
+		if (ret)
+			break;
+	}
+
+	atbm7821_wr(dev, ATBM7821_REG_LATCH, 0x00);
+	if (ret)
+		return ret;
+
+	*val = b[0] | b[1] << 8 | b[2] << 16 | b[3] << 24;
+
+	return 0;
+}
+
+/* -------------------------------------------------------------- tuner */
+
+static int mxl608_wr(struct atbm7821_dev *dev, u8 reg, u8 val)
+{
+	u8 buf[2] = { reg, val };
+	struct i2c_msg msg = {
+		.addr = MXL608_I2C_ADDR,
+		.flags = 0,
+		.len = sizeof(buf),
+		.buf = buf,
+	};
+	int ret;
+
+	ret = i2c_transfer(dev->tuner_adap, &msg, 1);
+	if (ret != 1) {
+		dev_dbg(&dev->client->dev, "tuner write %02x failed (%d)\n",
+			reg, ret);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	return 0;
+}
+
+/*
+ * Writes a tuner table, substituting the channel into the four registers
+ * that carry it.  Everything else in a tune is the same at every frequency,
+ * which is why the table can be a constant at all.
+ */
+static int mxl608_wr_tab(struct atbm7821_dev *dev,
+			 const struct mxl608_regval *tab, unsigned int len,
+			 u32 frequency)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < len; i++) {
+		u8 val = tab[i].val;
+
+		switch (tab[i].reg) {
+		case MXL608_REG_FREQ_L:
+			/* The tuner counts in sixty-fourths of a megahertz. */
+			val = DIV_ROUND_CLOSEST(frequency, 15625) & 0xff;
+			break;
+		case MXL608_REG_FREQ_H:
+			val = (DIV_ROUND_CLOSEST(frequency, 15625) >> 8) & 0xff;
+			break;
+		case MXL608_REG_RF_GAIN:
+			val = frequency < MXL608_RF_GAIN_SPLIT_HZ ? 0x59 : 0x37;
+			break;
+		case MXL608_REG_RF_BAND:
+			val = frequency < MXL608_RF_BAND_SPLIT_HZ ? 0xc1 : 0xd1;
+			break;
+		}
+
+		ret = mxl608_wr(dev, tab[i].reg, val);
+		if (ret)
+			return ret;
+		if (tab[i].delay_ms)
+			msleep(tab[i].delay_ms);
+	}
+
+	return 0;
+}
+
+/* ----------------------------------------------------------- frontend */
+
+static int atbm7821_init(struct dvb_frontend *fe)
+{
+	struct atbm7821_dev *dev = fe->demodulator_priv;
+	int ret;
+
+	ret = atbm7821_wr_tab(dev, atbm7821_init_tab,
+			      ARRAY_SIZE(atbm7821_init_tab));
+	if (ret) {
+		dev_err(&dev->client->dev, "initialisation failed (%d)\n", ret);
+		return ret;
+	}
+
+	dev->warm = true;
+
+	return 0;
+}
+
+static int atbm7821_sleep(struct dvb_frontend *fe)
+{
+	struct atbm7821_dev *dev = fe->demodulator_priv;
+
+	/*
+	 * There is deliberately no power-down here.  The only sequence known
+	 * to stop this part also stops the clock it feeds back to itself, and
+	 * recovering from that needs the power removed.  Idling is cheap
+	 * enough that the risk is not worth taking.
+	 */
+	dev->warm = false;
+
+	return 0;
+}
+
+static int atbm7821_set_frontend(struct dvb_frontend *fe)
+{
+	struct dtv_frontend_properties *c = &fe->dtv_property_cache;
+	struct atbm7821_dev *dev = fe->demodulator_priv;
+	int ret;
+
+	if (c->delivery_system != SYS_DVBC_ANNEX_A)
+		return -EINVAL;
+
+	dev_dbg(&dev->client->dev, "tuning to %u Hz\n", c->frequency);
+
+	/* Wake the tuner and let its crystal settle. */
+	ret = atbm7821_gate(dev, true);
+	if (!ret)
+		ret = mxl608_wr_tab(dev, mxl608_setup_tab,
+				    ARRAY_SIZE(mxl608_setup_tab), c->frequency);
+	if (!ret)
+		ret = atbm7821_gate(dev, false);
+	if (ret)
+		goto err;
+
+	/*
+	 * The demodulator half of a tune, which carries no channel
+	 * information; it is the same every time.
+	 */
+	ret = atbm7821_wr_tab(dev, atbm7821_tune_tab,
+			      ARRAY_SIZE(atbm7821_tune_tab));
+	if (ret)
+		goto err;
+
+	/* The only step that knows which channel was asked for. */
+	ret = atbm7821_gate(dev, true);
+	if (!ret)
+		ret = mxl608_wr_tab(dev, mxl608_tune_tab,
+				    ARRAY_SIZE(mxl608_tune_tab), c->frequency);
+	if (!ret)
+		ret = atbm7821_gate(dev, false);
+	if (ret)
+		goto err;
+
+	/* Start the search.  The chip works out the rest for itself. */
+	ret = atbm7821_wr_tab(dev, atbm7821_start_tab,
+			      ARRAY_SIZE(atbm7821_start_tab));
+	if (ret)
+		goto err;
+
+	return 0;
+
+err:
+	dev_dbg(&dev->client->dev, "tune failed (%d)\n", ret);
+	return ret;
+}
+
+static int atbm7821_read_status(struct dvb_frontend *fe,
+				enum fe_status *status)
+{
+	struct atbm7821_dev *dev = fe->demodulator_priv;
+	u32 val;
+	int ret;
+
+	*status = 0;
+
+	ret = atbm7821_dvbc_rd(dev, ATBM7821_DVBC_STATUS, &val);
+	if (ret)
+		return ret;
+
+	if ((val & ATBM7821_DVBC_LOCKED) == ATBM7821_DVBC_LOCKED)
+		*status = FE_HAS_SIGNAL | FE_HAS_CARRIER | FE_HAS_VITERBI |
+			  FE_HAS_SYNC | FE_HAS_LOCK;
+	else if ((val & ATBM7821_DVBC_PARTIAL) == ATBM7821_DVBC_PARTIAL)
+		*status = FE_HAS_SIGNAL | FE_HAS_CARRIER;
+
+	return 0;
+}
+
+static int atbm7821_read_snr(struct dvb_frontend *fe, u16 *snr)
+{
+	struct atbm7821_dev *dev = fe->demodulator_priv;
+	u32 mant, exp;
+	int ret;
+
+	ret = atbm7821_dvbc_rd(dev, ATBM7821_DVBC_SNR, &mant);
+	if (!ret)
+		ret = atbm7821_dvbc_rd(dev, ATBM7821_DVBC_SNR_EXP, &exp);
+	if (ret)
+		return ret;
+
+	/*
+	 * The scaling the vendor applies to these two is not known.  What is
+	 * known is the pair it reports against a good channel, so they are
+	 * passed through in a way that at least orders signals correctly.
+	 */
+	*snr = min_t(u32, mant, 0xffff);
+
+	return 0;
+}
+
+static const struct dvb_frontend_ops atbm7821_ops = {
+	.delsys = { SYS_DVBC_ANNEX_A },
+	.info = {
+		.name			= "AltoBeam ATBM7821",
+		.frequency_min_hz	=  51 * MHz,
+		.frequency_max_hz	= 860 * MHz,
+		.symbol_rate_min	= 1000000,
+		.symbol_rate_max	= 7200000,
+		.caps = FE_CAN_QAM_16 | FE_CAN_QAM_32 | FE_CAN_QAM_64 |
+			FE_CAN_QAM_128 | FE_CAN_QAM_256 | FE_CAN_QAM_AUTO |
+			FE_CAN_FEC_AUTO | FE_CAN_INVERSION_AUTO |
+			FE_CAN_RECOVER,
+	},
+
+	.init			= atbm7821_init,
+	.sleep			= atbm7821_sleep,
+	.set_frontend		= atbm7821_set_frontend,
+	.read_status		= atbm7821_read_status,
+	.read_snr		= atbm7821_read_snr,
+};
+
+static int atbm7821_probe(struct i2c_client *client)
+{
+	struct atbm7821_dev *dev;
+	u8 chip_id;
+	int ret;
+
+	dev = kzalloc(sizeof(*dev), GFP_KERNEL);
+	if (!dev)
+		return -ENOMEM;
+
+	dev->client = client;
+	dev->tuner_adap = client->adapter;
+
+	ret = atbm7821_rd(dev, ATBM7821_REG_CHIP_ID, &chip_id);
+	if (ret) {
+		dev_err(&client->dev, "no answer from the demodulator\n");
+		goto err;
+	}
+
+	if (chip_id != ATBM7821_CHIP_ID) {
+		dev_err(&client->dev, "unexpected chip id 0x%02x\n", chip_id);
+		ret = -ENODEV;
+		goto err;
+	}
+
+	memcpy(&dev->fe.ops, &atbm7821_ops, sizeof(dev->fe.ops));
+	dev->fe.demodulator_priv = dev;
+	i2c_set_clientdata(client, dev);
+
+	/*
+	 * A frontend driver would not normally own an adapter; the bridge or
+	 * the demultiplexer it belongs to does.  This receiver has no driver
+	 * for its demultiplexer yet, so there is nothing to attach to, and an
+	 * adapter registered here at least makes the frontend reachable and
+	 * testable.  It should move once that driver exists.
+	 */
+	ret = dvb_register_adapter(&dev->adapter, "atbm7821", THIS_MODULE,
+				   &client->dev, adapter_nr);
+	if (ret < 0) {
+		dev_err(&client->dev, "cannot register adapter (%d)\n", ret);
+		goto err;
+	}
+
+	ret = dvb_register_frontend(&dev->adapter, &dev->fe);
+	if (ret < 0) {
+		dev_err(&client->dev, "cannot register frontend (%d)\n", ret);
+		dvb_unregister_adapter(&dev->adapter);
+		goto err;
+	}
+
+	dev_info(&client->dev, "AltoBeam ATBM7821 with a MaxLinear MxL608\n");
+
+	return 0;
+
+err:
+	kfree(dev);
+	return ret;
+}
+
+static void atbm7821_remove(struct i2c_client *client)
+{
+	struct atbm7821_dev *dev = i2c_get_clientdata(client);
+
+	dvb_unregister_frontend(&dev->fe);
+	dvb_unregister_adapter(&dev->adapter);
+	kfree(dev);
+}
+
+static const struct i2c_device_id atbm7821_id_table[] = {
+	{ "atbm7821" },
+	{}
+};
+MODULE_DEVICE_TABLE(i2c, atbm7821_id_table);
+
+static const struct of_device_id atbm7821_of_match[] = {
+	{ .compatible = "altobeam,atbm7821" },
+	{}
+};
