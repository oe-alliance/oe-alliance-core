+            return -ENOMEM;
+        }
+
+        if (copy_from_user(kbuf, buf, count)) {
+            kfree(kbuf);
+            unuse_pde(pde);
+            return -EFAULT;
+        }
+
+        /* Cast Kernel buffer to __user to keep driver happy */
+        ubuf = (void __user *)kbuf;
+    }
+
+    rv = writefn(file, ubuf, count, ppos);
+
+    kfree(kbuf);
+    unuse_pde(pde);
+
+    return rv;
