+    ssize_t (*writefn)(struct file *, const char __user *, size_t, loff_t *);
+    void __user *ubuf = buf;
+    char *kbuf = NULL;
+
+    if (!use_pde(pde))
+        return -EIO;
+
+    writefn = pde->proc_fops->write;
+    if (!writefn) {
+        unuse_pde(pde);
+        return -EIO;
+    }
+
+    /* Check alignment */
+    if (((unsigned long)buf & (sizeof(long)-1)) != 0) {
+        kbuf = kmalloc(count, GFP_KERNEL);
