# GTMedia Bluetooth remote, keyboard interface only. The mouse has its own event node.
ACTION=="remove", GOTO="gtx_bt_rc_end"
SUBSYSTEM!="input", GOTO="gtx_bt_rc_end"
KERNEL!="event*", GOTO="gtx_bt_rc_end"
ATTRS{name}!="GTMEDIA Keyboard", GOTO="gtx_bt_rc_end"
ATTRS{id/bustype}!="0005", GOTO="gtx_bt_rc_end"
ATTRS{id/vendor}!="0508", GOTO="gtx_bt_rc_end"
ATTRS{id/product}!="0110", GOTO="gtx_bt_rc_end"

ENV{KEYBOARD_KEY_70028}="ok"
ENV{KEYBOARD_KEY_70029}="exit"
ENV{KEYBOARD_KEY_7003f}="back"
ENV{KEYBOARD_KEY_70040}="epg"
ENV{KEYBOARD_KEY_70041}="info"
ENV{KEYBOARD_KEY_70042}="tv"
ENV{KEYBOARD_KEY_7004a}="pvr"
ENV{KEYBOARD_KEY_7004b}="channelup"
ENV{KEYBOARD_KEY_7004c}="text"
ENV{KEYBOARD_KEY_7004e}="channeldown"
ENV{KEYBOARD_KEY_70065}="menu"
ENV{KEYBOARD_KEY_70069}="red"
ENV{KEYBOARD_KEY_7006a}="green"
ENV{KEYBOARD_KEY_7006b}="blue"
ENV{KEYBOARD_KEY_7006c}="yellow"
ENV{KEYBOARD_KEY_c00b5}="next"
ENV{KEYBOARD_KEY_c00b6}="previous"
ENV{KEYBOARD_KEY_c00b7}="stop"
ENV{KEYBOARD_KEY_c01a2}="favorites"
ENV{KEYBOARD_KEY_c0221}="record"
IMPORT{builtin}="keyboard"

LABEL="gtx_bt_rc_end"
