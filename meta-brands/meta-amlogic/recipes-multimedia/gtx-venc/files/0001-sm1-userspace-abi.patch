@@ -224,6 +224,18 @@
     return 0;
 }
 
+static void *mapEncoderBuffer(int fd, const vpu_buffer_t &buffer)
+{
+    vpu_buffer_t pool = {};
+    if (ioctl(fd, VDI_IOCTL_GET_RESERVED_VIDEO_MEMORY_INFO, &pool) < 0 ||
+        buffer.phys_addr < pool.phys_addr || buffer.size > pool.size)
+        return MAP_FAILED;
+    unsigned long offset = buffer.phys_addr - pool.phys_addr;
+    if (offset > pool.size - buffer.size)
+        return MAP_FAILED;
+    return mmap(NULL, buffer.size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, offset);
+}
+
