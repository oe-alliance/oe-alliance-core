+/* hw trim efuse is empty, enable tsensor with uncalibrated defaults */
+&p_tsensor {
+	amlogic,fallback-trim-info = <0x84000000>;
+};
+
+&d_tsensor {
+	amlogic,fallback-trim-info = <0x84000000>;
+};
+
+/* cpufreq cooling has fewer states than the g12b reference, use THERMAL_NO_LIMIT */
+&soc_thermal {
+	cooling-maps {
+		cpufreq_cooling_map0 {
