From: OpenATV <openatv@gmail.com>
Subject: [PATCH] add Duo 4K Lite Chromium IR input

The Duo 4K Lite reports custom code 8052. Select its matching keymap
instead of falling back to the 51ae remote layout. Start the IR adapter
for the physical remote so Chromium exclusively receives its keys.

Upstream-Status: Inappropriate [device-specific]

---
 chromium/run.sh | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/chromium/run.sh b/chromium/run.sh
index 1111111..2222222 100755
--- a/chromium/run.sh
+++ b/chromium/run.sh
@@ -82,11 +82,20 @@ read CUSTOMCODE < /proc/stb/ir/rc/customcode
 
 if [ "$CUSTOMCODE" ==  "50af" ]; then
         export WEBKITGL_KEYMAP_FILE=$TOP/bin/irkeymap_50af.xml
+elif [ "$CUSTOMCODE" == "8052" ]; then
+        export WEBKITGL_KEYMAP_FILE=$TOP/bin/irkeymap_8052.xml
 else
         export WEBKITGL_KEYMAP_FILE=$TOP/bin/irkeymap_51ae.xml
 fi
+
+IR_ADAPTER_PID=
+if [ "$CUSTOMCODE" == "8052" ] && ! grep -q "VUPLUS-BLE-RCU" /sys/class/input/event*/device/name 2>/dev/null; then
+        $TOP/bin/vu-ir-ok-adapter.py /dev/input/event0 &
+        IR_ADAPTER_PID=$!
+        sleep 1
+fi
 
 
 if [ "$DELAY_TIME" != "" ]; then
 	sleep "$DELAY_TIME"
 fi
@@ -131,6 +140,8 @@ cd $TOP && $WEBKITGL_SHELL \
 	--test-type \
 	$WEBKITGL_URL > /dev/null 2>&1
 
+[ -n "$IR_ADAPTER_PID" ] && kill "$IR_ADAPTER_PID" 2>/dev/null
+[ -n "$IR_ADAPTER_PID" ] && wait "$IR_ADAPTER_PID" 2>/dev/null
 sleep 1
 
 cd $TOP && nxconfig -focus -c dvb_init
-- 
